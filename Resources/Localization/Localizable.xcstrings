    "选择会议窗口或麦克风，实时转写参与者的发言。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select a meeting window or microphone to transcribe participants in real time."
          }
        }
      }
    },
    "检索资料与识别问题": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search materials and recognize questions"
          }
        }
      }
    },
    "结合系列资料理解上下文，识别提问和讨论重点。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use series materials for context and identify questions and discussion points."
          }
        }
      }
