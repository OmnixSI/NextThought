      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Product materials, pricing"
          }
        }
      }
    },
    "今天 %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today %@"
          }
        }
      }
    },
    "从下一个回答开始生效": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies from the next answer"
          }
        }
      }
    },
    "从以前的会议带入…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring in from a past meeting…"
          }
        }
      }
    },
