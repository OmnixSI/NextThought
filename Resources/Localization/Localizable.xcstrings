            "value": "After the meeting"
          }
        }
      }
    },
    "需要先开启“记录每次会议”。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on “Record every meeting” first."
          }
        }
      }
    },
    "去打开": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn it on"
          }
        }
      }
    },
    "记录每次会议": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record every meeting"
          }
        }
      }
    },
    "一个模板就是若干部分，每部分有名字和一句给 AI 的要求。可以从现有模板复制一份再改；每个场景用哪个模板，在“场景”页选。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A template is a set of sections, each with a name and a one-line instruction for the AI. Copy an existing template and edit it. Which template each scene uses is chosen on the Scenes page."
          }
        }
      }
    },
    "会后整理不赶时间，所以用单独的模型。默认是能用到的最强模型，推理强度“高”。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Writing notes isn't time-critical, so it uses its own model. The default is the strongest model available, at high reasoning effort."
          }
        }
      }
    },
    "自动收集经验与答法候选": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collect lesson and answer candidates automatically"
          }
        }
      }
    },
    "需要先开启“记录每次会议”和“会议结束后自动整理”。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on “Record every meeting” and “Write notes when a meeting ends” first."
          }
        }
      }
    },
    "整理时顺带挑出值得记住的经验和答法，逐项确认后才加入系列。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Picks out lessons and answers worth keeping while writing notes. Each one is added to the series only after you confirm it."
          }
        }
      }
    },
    "关闭引导，首页会留一个入口": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close the guide. The home page keeps a way back in."
          }
        }
      }
    },
