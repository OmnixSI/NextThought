            "state": "translated",
            "value": "Layout"
          }
        }
      }
    },
    "要点 = 结论加每一点的开头，一眼看完；逐句 = 按要说的话一句一句显示。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Key points shows the conclusion and the lead of each point for a quick glance. Line by line shows what to say one sentence at a time."
          }
        }
      }
    },
    "摄像头所在的屏幕": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen with the camera"
          }
        }
      }
    },
    "自动（内建显示器）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic (built-in display)"
          }
        }
      }
