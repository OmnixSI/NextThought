    "收起面试示例": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide the sample interview"
          }
        }
      }
    },
    "示例不录音、不申请权限、不调用模型，与上面选的场合无关。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sample records nothing, asks for no permissions and calls no model. It doesn't depend on the scene you picked."
          }
