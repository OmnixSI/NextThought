  "strings": {
    "English": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "English"
          }
        }
      }
    },
    "会议进行中不能切换语言。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can't change the language during a meeting."
          }
        }
      }
    },
    "切换语言后，App 会保存当前内容并自动重新打开。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After you switch languages, the app saves your work and reopens."
          }
        }
      }
    },
    "取消": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        }
      }
    },
