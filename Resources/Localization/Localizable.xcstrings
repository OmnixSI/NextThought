          }
        }
      }
    },
    "%@ · 在这台 Mac 上离线识别，已就绪。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · recognizes offline on this Mac. Ready."
          }
        }
      }
    },
