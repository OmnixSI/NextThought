      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Already downloaded on this Mac?"
          }
        }
      }
    },
    "扫描本机已有组件": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan existing components"
          }
