{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "NSAudioCaptureUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NextThought captures system audio from the selected meeting or lesson window for on-device transcription."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "NextThought 采集会议或课程的系统声音，在本机转写，不保存录音。"
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NextThought uses Bluetooth only when you enable the paired native phone backup connection."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在你开启手机 App 的蓝牙备用连接时，NextThought 才会使用蓝牙。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NextThought serves the optional phone companion page on your local network when you turn it on."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启手机伴侣后，NextThought 会在局域网内提供手机页面。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NextThought uses your microphone for local transcription, labelled as your voice separately from system audio."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "NextThought 在本机识别麦克风里你的声音，并和系统声音分开标注。"
          }
        }
      }
    },
    "NSScreenCaptureUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NextThought captures the selected screen area or window when you request screenshot assistance."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "NextThought 采集电脑播放的声音，并在你请求截图提问时截取所选区域或窗口。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NextThought uses on-device speech recognition for the system audio you select."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "NextThought 在本机识别你选择的系统声音。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
