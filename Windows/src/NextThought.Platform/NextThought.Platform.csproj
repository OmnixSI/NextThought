<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net10.0-windows10.0.19041.0</TargetFramework><PlatformTarget>x64</PlatformTarget></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../NextThought.Core/NextThought.Core.csproj" />
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <!-- Managed API shares the verified Sherpa ORT 1.28.2 native DLL; do not introduce a second native runtime. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.28.0" />
    <!-- PackageDownload keeps the official managed API without restoring nine unrelated OS runtimes. -->
    <PackageDownload Include="org.k2fsa.sherpa.onnx" Version="[1.13.8]" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.win-x64" Version="1.13.8" />
    <Reference Include="sherpa-onnx"><HintPath>$(NuGetPackageRoot)/org.k2fsa.sherpa.onnx/1.13.8/lib/net10.0/sherpa-onnx.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup>
  <ItemGroup><EmbeddedResource Include="Resources/models.json" /><EmbeddedResource Include="Resources/embedding-model.json" /><EmbeddedResource Include="Resources/xasr-bpe.vocab" /></ItemGroup>
</Project>
