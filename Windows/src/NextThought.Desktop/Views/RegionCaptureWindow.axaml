<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:NextThought.Desktop"
        x:Class="NextThought.Desktop.Views.RegionCaptureWindow"
        Title="区域截图"
        Width="1080" Height="760" MinWidth="720" MinHeight="540"
        Background="{DynamicResource Paper}"
        WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="Auto,*,Auto" Margin="20,16,20,16">
    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
      <TextBlock Text="拖动选择截图区域" Classes="display" FontSize="22" />
      <TextBlock x:Name="HintText" Text="截图会裁切到选中范围，然后存入资料库并由系统 OCR 读取文字。请把题目、代码或公式完整框入。"
                 Classes="caption" />
    </StackPanel>

    <Border Grid.Row="1" Classes="card" Padding="8" Background="{DynamicResource Sunken}">
      <Grid x:Name="CanvasHost" ClipToBounds="True">
        <Image x:Name="ScreenImage" Stretch="Uniform" />
        <Canvas x:Name="Overlay" Background="Transparent">
          <Border x:Name="Selection" BorderBrush="{DynamicResource Seal}" BorderThickness="2"
                  Background="#22C4452C" IsVisible="False" />
        </Canvas>
      </Grid>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
      <TextBlock x:Name="SizeText" Classes="caption" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Content="取消" Click="Cancel_Click" />
        <Button Classes="primary" Click="Accept_Click" IsEnabled="False" Name="AcceptButton">
          <TextBlock Text="使用此区域" Foreground="{DynamicResource OnInk}" />
        </Button>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
