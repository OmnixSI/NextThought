<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:NextThought.Desktop.Localization"
        xmlns:local="using:NextThought.Desktop"
        xmlns:views="using:NextThought.Desktop.Views"
        x:Class="NextThought.Desktop.Views.WindowPickerWindow"
        x:DataType="local:AppState"
        Title="{loc:Tr 选择要截图的窗口}" Width="460" Height="540" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Paper}">
  <Grid RowDefinitions="Auto,*,Auto" Margin="{DynamicResource D4Margin_18}">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
      <StackPanel Grid.Column="0" Spacing="{DynamicResource D4Spacing_2}">
        <TextBlock Text="{loc:Tr 选择要截图的窗口}" Classes="section" />

      </StackPanel>
      <Button Grid.Column="1" Classes="quiet" Content="{loc:Tr 刷新}" Click="Refresh_Click" VerticalAlignment="Top" />
    </Grid>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="{DynamicResource D4Margin_0_10_0_0}">
      <ItemsControl Name="WindowList">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="views:CaptureWindowRow">
            <Button Classes="quiet" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Tag="{Binding}" Click="Pick_Click" Margin="{DynamicResource D4Margin_0_2}">
              <StackPanel Spacing="{DynamicResource D4Spacing_1}">
                <TextBlock Text="{Binding Title}" Classes="label" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding OwnerLine}" Classes="caption" FontSize="11" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="{DynamicResource D4Margin_0_10_0_0}">
      <TextBlock Grid.Column="0" Name="StatusText" Classes="caption" VerticalAlignment="Center" TextWrapping="Wrap" />
      <Button Grid.Column="1" Content="{loc:Tr 取消}" Click="Cancel_Click" />
    </Grid>
  </Grid>
</Window>
