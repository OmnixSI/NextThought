<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:NextThought.Desktop.Localization"
        xmlns:local="using:NextThought.Desktop"
        x:Class="NextThought.Desktop.Views.MyVoiceWindow"
        x:DataType="local:AppState"
        Title="{loc:Tr 我的声音}" Width="600" Height="520" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Paper}">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="{DynamicResource D4Margin_18}">
    <StackPanel Spacing="{DynamicResource D4Spacing_10}">
      <TextBlock Text="{loc:Tr 我的声音}" Classes="display" FontSize="24" />

      <!-- E12/Mac MyVoiceSetupPanel：第 N/4 句 + 提示语 + 进度 + 取消/开始 -->
      <StackPanel Spacing="{DynamicResource D4Spacing_6}" IsVisible="{Binding MyVoiceSetupVisible}">
        <TextBlock Text="{Binding MyVoiceTakeHint}" Classes="caption" TextWrapping="Wrap" />
        <Border Classes="card" Padding="{DynamicResource D4Padding_14_10}">
          <TextBlock Text="{Binding MyVoicePrompt}" Classes="body" TextWrapping="Wrap" />
        </Border>
        <ProgressBar Value="{Binding MyVoiceProgress}" Maximum="1" Height="6" IsVisible="{Binding MyVoiceRecording}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="{DynamicResource D4Spacing_8}">
          <Button Content="{loc:Tr 取消}" Command="{Binding CancelMyVoiceSetupCommand}" />
          <Button Classes="primary" Content="{Binding MyVoiceRecordLabel}" Command="{Binding RecordMyVoiceTakeCommand}"
                  IsEnabled="{Binding MyVoiceCanStart}" />
        </StackPanel>
      </StackPanel>

      <!-- E12/Mac MyVoiceSettings 摘要：已录入 · 日期 / 重新录入 / 删除；还没有录入则显示录入入口 -->
      <StackPanel Spacing="{DynamicResource D4Spacing_8}" IsVisible="{Binding !MyVoiceSetupVisible}">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource D4Spacing_8}">
          <TextBlock Grid.Column="0" Text="{Binding MyVoiceSummaryLine}" Classes="body" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="{loc:Tr 重新录入}" Command="{Binding BeginMyVoiceSetupCommand}"
                  IsVisible="{Binding MyVoiceHasProfile}" IsEnabled="{Binding MyVoiceCanEnroll}" />
          <Button Grid.Column="2" Content="{loc:Tr 删除}" Click="Delete_Click"
                  IsVisible="{Binding MyVoiceHasProfile}" />
        </Grid>
        <Button Classes="primary" Content="{loc:Tr 录入我的声音}" HorizontalAlignment="Left"
                Command="{Binding BeginMyVoiceSetupCommand}" IsVisible="{Binding !MyVoiceHasProfile}"
                IsEnabled="{Binding MyVoiceCanEnroll}" />
        <TextBlock Text="{loc:Tr 这份声音来自旧版本的模型，需要重新录入。}" Classes="caption"
                   Foreground="{DynamicResource Caution}" TextWrapping="Wrap" IsVisible="{Binding MyVoiceOldModel}" />
        <TextBlock Text="{loc:Tr 这个版本没有附带声纹模型。}" Classes="caption"
                   Foreground="{DynamicResource Caution}" TextWrapping="Wrap" IsVisible="{Binding MyVoiceModelMissing}" />
        <TextBlock Text="{loc:Tr 会议进行中不能录入。}" Classes="caption" TextWrapping="Wrap"
                   IsVisible="{Binding MyVoiceMeetingRunning}" />
      </StackPanel>

      <TextBlock Text="{Binding MyVoiceMessage}" Classes="caption" Foreground="{DynamicResource Caution}"
                 TextWrapping="Wrap" IsVisible="{Binding HasMyVoiceMessage}" />
      <TextBlock Text="{loc:Tr 读 4 句话，约 40 秒。只保存一串数字，不保存录音；只存在这台电脑上，不上传、不进备份，可随时删除。录入后，线下会议里你的发言会标为“我”。}"
                 Classes="caption" TextWrapping="Wrap" />

      <Button Content="{loc:Tr 关闭}" Click="Close_Click" HorizontalAlignment="Right" />
    </StackPanel>
  </ScrollViewer>
</Window>
