<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:NextThought.Desktop.Localization"
             xmlns:local="using:NextThought.Desktop"
             xmlns:core="using:NextThought.Core"
             x:Class="NextThought.Desktop.Views.SeriesView"
             x:DataType="local:AppState">
  <UserControl.Styles>
    <!-- Fluent's tab headers are far larger than the rest of this page's type scale. -->
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="12,4" />
    </Style>
    <Style Selector="TabItem /template/ ContentPresenter">
      <Setter Property="FontSize" Value="13" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*" Margin="{DynamicResource D4Margin_32_18_32_0}">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
      <StackPanel Spacing="{DynamicResource D4Spacing_6}">
        <TextBlock Text="{loc:Tr 系列}" Classes="display" />
        <TextBlock Text="{loc:Tr 同一门课、同一个项目、同一类面试放在一个系列里；每场会议的结论与经验会攒在一起。}" Classes="caption" />
        <TextBlock Text="{Binding SeriesSummary}" Classes="caption" FontSize="11" Foreground="{DynamicResource Secondary}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource D4Spacing_8}" VerticalAlignment="Center">
        <TextBox Text="{Binding NewSeriesName}" PlaceholderText="{loc:Tr 新系列的名字}" Width="180" MinHeight="{DynamicResource Control}" />
        <Button Content="{loc:Tr 新建系列}" Command="{Binding CreateSeriesCommand}" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="330,*" ColumnSpacing="16" Margin="{DynamicResource D4Margin_0_18_0_16}">
      <!-- 系列列表 -->
      <Border Classes="card" Padding="{DynamicResource D4Padding_8}">
        <Grid RowDefinitions="*,Auto">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ListBox Name="SeriesList" ItemsSource="{Binding SeriesRows}" Background="Transparent"
                     SelectionChanged="Series_SelectionChanged">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="local:SeriesRow">
                  <StackPanel Spacing="{DynamicResource D4Spacing_3}" Margin="{DynamicResource D4Margin_0_6}">
                    <TextBlock Text="{Binding Name}" Classes="title" FontSize="14" />
                    <TextBlock Text="{Binding Meta}" Classes="caption" FontSize="11" />
                    <TextBlock Text="{Binding Preview}" Classes="caption" FontSize="11" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </ScrollViewer>
          <TextBlock Grid.Row="1" Text="{loc:Tr 还没有系列。上面的输入框新建一个，再把会议放进来。}"
                     Classes="caption" Margin="{DynamicResource D4Margin_8_8_8_4}" IsVisible="{Binding SeriesIsEmpty}" TextWrapping="Wrap" />
        </Grid>
      </Border>

      <!-- 选中的系列 -->
      <Border Grid.Column="1" Classes="card" Padding="{DynamicResource D4Padding_22_16}">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="{DynamicResource D4Spacing_4}">
              <TextBlock Text="{Binding SelectedSeriesTitle}" FontFamily="{StaticResource SerifFamily}"
                         FontSize="22" FontWeight="Medium" Foreground="{DynamicResource InkBrush}" />
              <TextBlock Text="{Binding SelectedSeriesMeta}" Classes="caption" />
              <TextBlock Text="{Binding SelectedSeriesStatsLine}" Classes="caption" FontSize="11"
                         Foreground="{DynamicResource Secondary}" IsVisible="{Binding HasSelectedSeriesStats}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource D4Spacing_8}" VerticalAlignment="Center">
              <Button Content="{loc:Tr 开下一场}" Command="{Binding OpenNextMeetingInSeriesCommand}" />
              <Button Content="{loc:Tr 编辑系列}" Click="EditSeries_Click" />
              <Button Content="{loc:Tr 把这场景加入}" Command="{Binding AssignCurrentToSeriesCommand}" />
              <Button Content="{loc:Tr 移出}" Command="{Binding RemoveCurrentFromSeriesCommand}" />
            </StackPanel>
          </Grid>

          <StackPanel Grid.Row="1" Spacing="{DynamicResource D4Spacing_4}" Margin="{DynamicResource D4Margin_0_14_0_0}">
            <TextBlock Text="{loc:Tr 会议}" Classes="overline" />
            <ScrollViewer MaxHeight="88" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding SeriesMeetings}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:RecentMeetingRow">
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource D4Spacing_6}" Margin="{DynamicResource D4Margin_0_3}">
                      <TextBlock Text="{Binding Meta.Title}" Classes="label" />
                      <Border Classes="chip" IsVisible="{Binding HasSummary}">
                        <TextBlock Text="{loc:Tr 有纪要}" Classes="overline" FontSize="10" />
                      </Border>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <TextBlock Text="{loc:Tr 附着技能}" Classes="overline" />
            <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding SeriesSkills}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:SeriesSkillRow">
                    <CheckBox IsChecked="{Binding IsAttached}" Content="{Binding Name}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <TextBlock Text="{loc:Tr 勾选的技能只加入这个系列的回答；全局技能仍然生效。}" Classes="caption" FontSize="11" />
          </StackPanel>

          <!-- 决定 / 待办：KnowledgeReviewSection.swift SeriesChangeCandidateCard -->
          <Border Grid.Row="2" Classes="card" Padding="{DynamicResource D4Padding_12}" Margin="{DynamicResource D4Margin_0_8_0_0}"
                  IsVisible="{Binding HasSeriesChanges}">
            <StackPanel Spacing="{DynamicResource D4Spacing_6}">
              <TextBlock Text="{Binding SeriesChangesHeader}" Classes="overline" />
              <TextBlock Text="{Binding SeriesChangesHint}" Classes="caption" FontSize="11" TextWrapping="Wrap" />
              <Button Classes="quiet" Content="{Binding CollectSeriesChangesLabel}" Click="CollectSeriesChanges_Click"
                      IsVisible="{Binding CanCollectSeriesChanges}" HorizontalAlignment="Left" />
              <ItemsControl ItemsSource="{Binding SeriesChangeRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:SeriesChangeRow">
                    <Border Classes="card" Padding="{DynamicResource D4Padding_12_10}" Margin="{DynamicResource D4Margin_0_0_0_8}">
                      <StackPanel Spacing="{DynamicResource D4Spacing_4}">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Grid.Column="0" Text="{Binding KindLabel}" Classes="caption" VerticalAlignment="Center" />
                          <Button Grid.Column="1" Classes="quiet" Content="{loc:Tr 忽略}" Tag="{Binding}"
                                  Click="RejectSeriesChange_Click" />
                        </Grid>
                        <TextBlock Text="{Binding Text}" Classes="label" TextWrapping="Wrap" />
                        <StackPanel Spacing="{DynamicResource D4Spacing_2}" IsVisible="{Binding IsAction}">
                          <TextBlock Text="{Binding ActionHint}" Classes="caption" FontSize="11" TextWrapping="Wrap" />
                          <TextBox Text="{Binding Owner, Mode=TwoWay}" PlaceholderText="{Binding OwnerPlaceholder}" />
                          <TextBox Text="{Binding Due, Mode=TwoWay}" PlaceholderText="{Binding DuePlaceholder}" />
                        </StackPanel>
                        <TextBlock Text="{Binding SourceLine}" Classes="caption" TextWrapping="Wrap"
                                   IsVisible="{Binding HasSourceQuote}" />
                        <StackPanel Spacing="{DynamicResource D4Spacing_4}" IsVisible="{Binding IsStale}">
                          <TextBlock Text="{loc:Tr 原话或负责人/期限已变化；此建议不能接受。}" Classes="caption"
                                     Foreground="{DynamicResource Caution}" TextWrapping="Wrap" />
                          <Button Classes="quiet" Content="{loc:Tr 忽略过期建议}" Tag="{Binding}"
                                  Click="RejectSeriesChange_Click" HorizontalAlignment="Left" />
                        </StackPanel>
                        <StackPanel Spacing="{DynamicResource D4Spacing_4}" IsVisible="{Binding IsCurrent}">
                          <TextBlock Text="{Binding UpdateHeading}" Classes="caption" FontSize="11"
                                     IsVisible="{Binding HasMatchingItems}" />
                          <ItemsControl ItemsSource="{Binding MatchingItems}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="local:SeriesTargetRow">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource D4Spacing_6}"
                                      Margin="{DynamicResource D4Margin_0_2}">
                                  <TextBlock Grid.Column="0" Text="{Binding Text}" Classes="caption" TextWrapping="Wrap"
                                             MaxLines="2" TextTrimming="CharacterEllipsis" />
                                  <Button Grid.Column="1" Classes="quiet" Content="{Binding UpdateLabel}"
                                          Tag="{Binding $parent[ItemsControl].DataContext}" Click="ReplaceSeriesChange_Click"
                                          DataContext="{Binding}" />
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <Button Classes="primary" Content="{Binding AddLabel}" Tag="{Binding}"
                                  Click="AcceptSeriesChange_Click" HorizontalAlignment="Left"
                                  Padding="{DynamicResource D4Padding_14_0}" MinHeight="{DynamicResource Control}" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <TabControl Name="Tabs" Grid.Row="3" Margin="{DynamicResource D4Margin_0_10_0_0}" Background="Transparent" Padding="{DynamicResource D4Padding_0}">
            <TabItem Header="{Binding SeriesLessonsHeader}">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="{DynamicResource D4Spacing_2}" Margin="{DynamicResource D4Margin_0_8_0_0}">
                  <ItemsControl ItemsSource="{Binding SeriesLessons}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="core:WorkspaceLesson">
                        <Grid ColumnDefinitions="*,Auto" Margin="{DynamicResource D4Margin_0_3}">
                          <TextBlock Text="{Binding Text}" Classes="label" TextWrapping="Wrap" />
                          <Button Grid.Column="1" Content="{loc:Tr 删除}" Classes="ghost" Tag="{Binding}"
                                  Click="RemoveLesson_Click" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="{loc:Tr 还没有经验。整理纪要时会从「下次改进」这类章节提炼候选，确认后才会记下来；也可以手写一条。}" Classes="caption"
                             IsVisible="{Binding !HasSeriesLessons}" TextWrapping="Wrap" />
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="{Binding SeriesCandidatesHeader}">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="{DynamicResource D4Spacing_2}" Margin="{DynamicResource D4Margin_0_8_0_0}">
                  <TextBlock Text="{loc:Tr 知识候选}" Classes="section" />
                  <TextBlock Text="{loc:Tr 候选先保留在待审阅区；确认后才会影响后续回答。}" Classes="caption" TextWrapping="Wrap" />
                  <ItemsControl ItemsSource="{Binding SeriesCandidates}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="local:KnowledgeCandidateRow">
                        <Border Classes="card" Padding="{DynamicResource D4Padding_12_10}" Margin="{DynamicResource D4Margin_0_6_0_8}">
                          <StackPanel Spacing="{DynamicResource D4Spacing_4}">
                            <Grid ColumnDefinitions="*,Auto">
                              <TextBlock Grid.Column="0" Text="{Binding KindLabel}" Classes="caption" VerticalAlignment="Center" />
                              <Button Grid.Column="1" Classes="quiet" Content="{Binding RejectLabel}" Tag="{Binding}"
                                      Click="RejectCandidate_Click" />
                            </Grid>
                            <TextBlock Text="{Binding Text}" Classes="label" TextWrapping="Wrap" />
                            <!-- 题库已有相似问题：显示当前问题/答法与本次建议 -->
                            <StackPanel Spacing="{DynamicResource D4Spacing_2}" IsVisible="{Binding ShowQuestionMatching}">
                              <TextBlock Text="{Binding CurrentQuestionLabel}" Classes="caption" FontSize="11" />
                              <TextBlock Text="{Binding MatchingQuestionText}" Classes="body" TextWrapping="Wrap" />
                              <TextBlock Text="{Binding CurrentAnswerLabel}" Classes="caption" FontSize="11" />
                              <TextBlock Text="{Binding MatchingAnswerText}" Classes="body" TextWrapping="Wrap" />
                              <TextBlock Text="{Binding ProposedAnswerLabel}" Classes="caption" FontSize="11" />
                              <TextBlock Text="{Binding Answer}" Classes="body" TextWrapping="Wrap" />
                              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource D4Spacing_6}">
                                <Button Classes="quiet" Content="{Binding KeepExistingLabel}" Tag="{Binding}"
                                        Click="KeepCandidate_Click" />
                                <Button Classes="primary" Content="{Binding ReplaceAnswerLabel}" Tag="{Binding}"
                                        Click="ReplaceCandidate_Click" Padding="{DynamicResource D4Padding_14_0}"
                                        MinHeight="{DynamicResource Control}" />
                              </StackPanel>
                            </StackPanel>
                            <!-- 新问题 -->
                            <StackPanel Spacing="{DynamicResource D4Spacing_2}" IsVisible="{Binding ShowAddNewQuestion}">
                              <TextBlock Text="{Binding NewAnswerLabel}" Classes="caption" FontSize="11" />
                              <TextBlock Text="{Binding Answer}" Classes="body" TextWrapping="Wrap" />
                              <Button Classes="primary" Content="{Binding AddLabel}" Tag="{Binding}"
                                      Click="AcceptCandidate_Click" HorizontalAlignment="Left"
                                      Padding="{DynamicResource D4Padding_14_0}" MinHeight="{DynamicResource Control}" />
                            </StackPanel>
                            <!-- 经验 -->
                            <StackPanel Spacing="{DynamicResource D4Spacing_2}" IsVisible="{Binding ShowLesson}">
                              <TextBlock Text="{Binding MatchingLessonLine}" Classes="caption" TextWrapping="Wrap"
                                         IsVisible="{Binding HasMatchingLesson}" />
                              <Button Classes="quiet" Content="{Binding KeepExistingLabel}" Tag="{Binding}"
                                      Click="KeepCandidate_Click" IsVisible="{Binding HasMatchingLesson}"
                                      HorizontalAlignment="Left" />
                              <Button Classes="primary" Content="{Binding AddLabel}" Tag="{Binding}"
                                      Click="AcceptCandidate_Click" IsVisible="{Binding ShowAddNewLesson}"
                                      HorizontalAlignment="Left" Padding="{DynamicResource D4Padding_14_0}"
                                      MinHeight="{DynamicResource Control}" />
                            </StackPanel>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="{loc:Tr 没有待确认的知识。按模板整理一份纪要后，模板里标了「带出经验」的章节会排到这里。}"
                             Classes="caption" IsVisible="{Binding !HasSeriesCandidates}" TextWrapping="Wrap" />
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="{Binding SeriesBankHeader}">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="{DynamicResource D4Spacing_2}" Margin="{DynamicResource D4Margin_0_8_0_0}">
                  <ItemsControl ItemsSource="{Binding SeriesBank}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="local:QuestionBankRow">
                        <Border Classes="card" Padding="{DynamicResource D4Padding_12_10}" Margin="{DynamicResource D4Margin_0_0_0_8}">
                          <StackPanel Spacing="{DynamicResource D4Spacing_4}">
                            <TextBlock Text="{Binding Question}" Classes="label" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Answer}" Classes="caption" TextWrapping="Wrap"
                                       IsVisible="{Binding HasAnswer}" />
                            <TextBlock Text="{Binding Meta}" Classes="faint" FontSize="11" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="{loc:Tr 题库还空着。面试、汇报这类模板的「逐题回放」章节会在确认后进入题库。}"
                             Classes="caption" IsVisible="{Binding !HasSeriesBank}" TextWrapping="Wrap" />
                </StackPanel>
              </ScrollViewer>
            </TabItem>
          </TabControl>

          <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="{DynamicResource D4Margin_0_12_0_0}">
            <TextBox Text="{Binding NewLessonText}" PlaceholderText="{loc:Tr 一句话经验，例如：先说结论，再说依据}" MinHeight="{DynamicResource Control}" />
            <Button Grid.Column="1" Classes="primary" Margin="{DynamicResource D4Margin_8_0_0_0}" Padding="{DynamicResource D4Padding_16_0}" MinHeight="{DynamicResource Control}"
                    Command="{Binding AddLessonCommand}">
              <TextBlock Text="{loc:Tr 记下}" Foreground="{DynamicResource OnInk}" FontSize="13" />
            </Button>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
