<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:NextThought.Desktop.Localization"
        xmlns:local="using:NextThought.Desktop"
        x:Class="NextThought.Desktop.Views.MaterialReviewWindow"
        x:DataType="local:AppState"
        Title="{loc:Tr 资料复核}" Width="900" Height="680" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Paper}">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="{DynamicResource D4Margin_18}">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
      <StackPanel Grid.Column="0" Spacing="{DynamicResource D4Spacing_2}">
        <TextBlock Text="{Binding Library.SelectedMaterial.Name}" Classes="section" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding Library.SelectedMaterial.Extension}" Classes="caption" />
      </StackPanel>
      <Button Grid.Column="1" Classes="quiet" Content="{loc:Tr 完成}" Click="Close_Click" VerticalAlignment="Top" />
    </Grid>

    <StackPanel Grid.Row="1" Spacing="{DynamicResource D4Spacing_4}" Margin="{DynamicResource D4Margin_0_10_0_0}">
      <Border Classes="card" Padding="{DynamicResource D4Padding_12_10}" IsVisible="{Binding HasMaterialReviewWarnings}">
        <StackPanel Spacing="{DynamicResource D4Spacing_2}">
          <TextBlock Text="{Binding MaterialReviewWarningsTitle}" Classes="label" Foreground="{DynamicResource Caution}" />
          <ItemsControl ItemsSource="{Binding MaterialReviewWarnings}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <SelectableTextBlock Text="{Binding}" Classes="caption" TextWrapping="Wrap" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      <TextBlock Text="{Binding MaterialReviewNoteLine}" Classes="caption" TextWrapping="Wrap"
                 IsVisible="{Binding HasMaterialReviewNoteLine}" />
    </StackPanel>

    <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource D4Spacing_10}" Margin="{DynamicResource D4Margin_0_10_0_0}">
      <Border Grid.Column="0" Classes="card" Padding="{DynamicResource D4Padding_12_10}">
        <Grid RowDefinitions="Auto,Auto,*">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="{loc:Tr 原件}" Classes="overline" />
            <Button Grid.Column="1" Classes="quiet" Content="{loc:Tr 用系统应用打开}" Command="{Binding OpenMaterialOriginalCommand}"
                    IsVisible="{Binding MaterialReviewHasOriginal}" />
          </Grid>
          <TextBlock Grid.Row="1" Text="{Binding MaterialReviewSourcePath}" Classes="caption" FontSize="11"
                     TextWrapping="Wrap" Margin="{DynamicResource D4Margin_0_6_0_0}" IsVisible="{Binding MaterialReviewHasOriginal}" />
          <StackPanel Grid.Row="2" Spacing="{DynamicResource D4Spacing_2}" IsVisible="{Binding !MaterialReviewHasOriginal}">
            <TextBlock Text="{Binding MaterialReviewUnavailableText}" Classes="label" />
            <TextBlock Text="{Binding MaterialReviewUnavailableHint}" Classes="caption" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Border>
      <Border Grid.Column="1" Classes="card" Padding="{DynamicResource D4Padding_12_10}">
        <Grid RowDefinitions="Auto,*,Auto">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="{loc:Tr 提取内容}" Classes="overline" />
            <Button Grid.Column="1" Classes="quiet" Content="{loc:Tr 打开完整文本}" Command="{Binding OpenMaterialExtractedCommand}" />
          </Grid>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="{DynamicResource D4Margin_0_6_0_0}">
            <SelectableTextBlock Text="{Binding MaterialReviewPreview}" FontSize="13" LineHeight="22" TextWrapping="Wrap" />
          </ScrollViewer>
          <TextBlock Grid.Row="2" Text="{Binding MaterialReviewPreviewTruncatedText}" Classes="caption" FontSize="11"
                     TextWrapping="Wrap" IsVisible="{Binding MaterialReviewPreviewTruncated}" Margin="{DynamicResource D4Margin_0_6_0_0}" />
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.Row="3" RowDefinitions="Auto,Auto" Margin="{DynamicResource D4Margin_0_10_0_0}">
      <TextBlock Grid.Row="0" Text="{Binding MaterialReviewNoteHeading}" Classes="caption" />
      <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource D4Spacing_10}">
        <TextBox Grid.Column="0" Text="{Binding MaterialReviewNote}" AcceptsReturn="True" TextWrapping="Wrap" Height="76"
                 PlaceholderText="{loc:Tr 记下复核结论：哪些页需要人工核对、是否补齐原件。}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource D4Spacing_8}" VerticalAlignment="Bottom">
          <Button Content="{loc:Tr 关闭}" Click="Close_Click" />
          <Button Classes="primary" Content="{loc:Tr 保存备注}" Command="{Binding SaveMaterialReviewCommand}" Click="Close_Click" />
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</Window>
