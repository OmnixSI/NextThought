<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:NextThought.Desktop.Localization"
        xmlns:local="using:NextThought.Desktop"
        xmlns:views="using:NextThought.Desktop.Views"
        x:Class="NextThought.Desktop.Views.SessionInfoWindow"
        x:DataType="local:AppState"
        Title="{loc:Tr 详细信息}" Width="500" Height="560" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Paper}">
  <Grid RowDefinitions="Auto,*,Auto" Margin="{DynamicResource D4Margin_22_18}">
    <StackPanel Grid.Row="0" Spacing="{DynamicResource D4Spacing_2}">
      <TextBlock Text="{loc:Tr 详细信息}" Classes="section" />
      <TextBlock Text="{Binding MeetingTitle}" Classes="caption" TextTrimming="CharacterEllipsis" />
    </StackPanel>
    <StackPanel Grid.Row="1" x:Name="EmptyPanel" Spacing="{DynamicResource D4Spacing_6}"
                VerticalAlignment="Center" HorizontalAlignment="Center" IsVisible="False">
      <TextBlock Text="{loc:Tr 还没有可显示的会议信息。}" Classes="caption" TextWrapping="Wrap"
                 TextAlignment="Center" Foreground="{DynamicResource Secondary}" />
      <Button Classes="quiet" Content="{loc:Tr 重试}" Click="Retry_Click" HorizontalAlignment="Center" />
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="{DynamicResource D4Margin_0_10_0_0}">
      <ItemsControl Name="InfoItems">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="views:SessionInfoRow">
            <StackPanel Spacing="{DynamicResource D4Spacing_0}" Margin="{DynamicResource D4Margin_0_6_0_0}">
              <TextBlock Text="{Binding Group}" Classes="overline"
                         IsVisible="{Binding StartsGroup}" Margin="{DynamicResource D4Margin_0_6_0_2}" />
              <Grid ColumnDefinitions="88,*" ColumnSpacing="{DynamicResource D4Spacing_8}">
                <TextBlock Grid.Column="0" Text="{Binding Label}" Classes="caption" Foreground="{DynamicResource Secondary}" />
                <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" Classes="caption" TextWrapping="Wrap" />
              </Grid>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <Button Grid.Row="2" Content="{loc:Tr 完成}" Classes="primary" HorizontalAlignment="Right" Click="Close_Click" />
  </Grid>
</Window>
