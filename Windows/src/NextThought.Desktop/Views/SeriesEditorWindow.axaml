<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:NextThought.Desktop"
        x:Class="NextThought.Desktop.Views.SeriesEditorWindow"
        x:DataType="local:AppState"
        Title="编辑系列" Width="620" Height="520" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Paper}">
  <StackPanel Margin="{DynamicResource D4Margin_22}" Spacing="{DynamicResource D4Spacing_10}">
    <TextBlock Text="基本信息" Classes="section" />
    <TextBlock Text="名称" Classes="caption" />
    <TextBox Text="{Binding SeriesEditorName}" />
    <TextBlock Text="类型" Classes="caption" />
    <TextBox Text="{Binding SeriesEditorMode}" PlaceholderText="interview / meeting / academic…" />
    <TextBlock Text="回答风格" Classes="caption" />
    <TextBox Text="{Binding SeriesEditorStyle}" PlaceholderText="concise / detailed" />
    <TextBlock Text="要求 / Preferences" Classes="caption" />
    <TextBox Text="{Binding SeriesEditorPreferences}" AcceptsReturn="True" TextWrapping="Wrap" Height="100" />
    <CheckBox Content="使用系列知识（经验与题库）" IsChecked="{Binding SeriesEditorUseKnowledge}" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="{DynamicResource D4Spacing_8}">
      <Button Content="取消" Click="Close_Click" />
      <Button Classes="primary" Content="保存" Command="{Binding SaveSeriesEditorCommand}" Click="Close_Click" />
    </StackPanel>
  </StackPanel>
</Window>