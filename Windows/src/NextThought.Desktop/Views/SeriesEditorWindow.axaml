<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:NextThought.Desktop.Localization"
        xmlns:local="using:NextThought.Desktop"
        xmlns:controls="using:NextThought.Desktop.Views.Controls"
        xmlns:core="using:NextThought.Core"
        x:Class="NextThought.Desktop.Views.SeriesEditorWindow"
        x:DataType="local:AppState"
        Title="{loc:Tr 编辑系列}" Width="760" Height="720" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Paper}">
  <Window.Styles>
    <!-- WorkspaceEditor section strip: a 2px Ink underline on the selected section, hairline track. -->
    <Style Selector="Button.sectionTab">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Padding" Value="8,12" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource Secondary}" />
    </Style>
    <Style Selector="Button.sectionTab:pointerover /template/ Border#Root">
      <Setter Property="Background" Value="{DynamicResource Hover}" />
    </Style>
    <Style Selector="Button.sectionTab.active">
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}" />
    </Style>
    <Style Selector="Button.sectionTab.active:pointerover /template/ Border#Root">
      <Setter Property="Background" Value="{DynamicResource Sunken}" />
    </Style>
    <Style Selector="ToggleSwitch.wide">
      <Setter Property="MinHeight" Value="36" />
    </Style>
    <Style Selector="StackPanel.editorBar">
      <Setter Property="Background" Value="{DynamicResource Sunken}" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="{DynamicResource D4Margin_24}">
    <!-- WorkspaceEditor header: SceneGlyph(36) + name(display) + SceneTag + SeriesStatsLine; actions right. -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource D4Spacing_12}">
      <controls:SceneGlyph Grid.Column="0" Mode="{Binding SelectedSeriesMode}" Size="36" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Spacing="{DynamicResource D4Spacing_2}" VerticalAlignment="Center">
        <TextBlock Text="{Binding SelectedSeriesName}" Classes="display" TextTrimming="CharacterEllipsis"
                   TextWrapping="NoWrap" MaxLines="1" />
        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource D4Spacing_10}" VerticalAlignment="Center">
          <controls:SceneTag Mode="{Binding SelectedSeriesMode}" Name="{Binding SelectedSeriesTypeName}" />
          <TextBlock Text="{Binding SelectedSeriesStatsLine}" Classes="caption" VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{DynamicResource D4Spacing_8}" VerticalAlignment="Center">
        <Button Classes="primary" Content="{loc:Tr 开下一场}" Command="{Binding OpenNextMeetingInSeriesCommand}" />
        <Button Classes="quiet" Content="{loc:Tr 配置}">
          <Button.Flyout>
            <MenuFlyout>
              <MenuItem Header="{loc:Tr 基本信息}" Click="SectionBasic_Click" />
              <MenuItem Header="{loc:Tr 回答要求}" Click="SectionRequirements_Click" />
              <MenuItem Header="{loc:Tr 系列技能}" Click="SectionSkills_Click" />
              <Separator />
              <MenuItem Header="{loc:Tr 归档系列}" Command="{Binding ArchiveSeriesCommand}" Click="Close_Click" />
              <MenuItem Header="{loc:Tr 删除系列}" Click="DeleteSeries_Click" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </StackPanel>
    </Grid>

    <!-- Primary sections: 记录 / 资料 / 经验积累 (WorkspaceEditorSection.primary). -->
    <Border Grid.Row="1" BorderBrush="{DynamicResource Hairline}" BorderThickness="0,0,0,0.5"
            Margin="{DynamicResource D4Margin_0_10_0_0}">
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource D4Spacing_2}">
        <Button x:Name="RecordsTab" Classes="sectionTab active" Click="SectionRecords_Click">
          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource D4Spacing_5}">
            <TextBlock Text="{loc:Tr 记录}" />
            <TextBlock Text="{Binding SeriesRecords.Count}" Classes="caption" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button x:Name="DocumentsTab" Classes="sectionTab" Click="SectionDocuments_Click">
          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource D4Spacing_5}">
            <TextBlock Text="{loc:Tr 资料}" />
            <TextBlock Text="{Binding SeriesEditorDocuments.Count}" Classes="caption" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button x:Name="KnowledgeTabButton" Classes="sectionTab" Click="SectionKnowledge_Click">
          <TextBlock Text="{loc:Tr 经验积累}" />
        </Button>
      </StackPanel>
    </Border>

    <!-- Draft action bar for basic/requirements (WorkspaceEditor.editActionsBar). -->
    <Border x:Name="EditActionsBar" Grid.Row="2" IsVisible="False" CornerRadius="8"
            Margin="{DynamicResource D4Margin_0_6_0_0}" Padding="{DynamicResource D4Padding_12_4}">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource D4Spacing_8}">
        <TextBlock x:Name="EditActionsLabel" Grid.Column="0" Classes="caption" FontWeight="Medium"
                   VerticalAlignment="Center" />
        <Button Grid.Column="1" Classes="primary" Content="{loc:Tr 保存}"
                Command="{Binding SaveSeriesEditorCommand}" Click="SaveDraft_Click" />
        <Button Grid.Column="2" Classes="quiet" Content="{loc:Tr 取消}" Click="CancelDraft_Click" />
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
      <Grid>
        <!-- 记录：WorkspaceRecordsTab -->
        <StackPanel x:Name="RecordsSection" Spacing="{DynamicResource D4Spacing_6}">
          <TextBlock Text="{Binding SeriesRecordsEmptyText}" Classes="caption" TextWrapping="Wrap"
                     IsVisible="{Binding !HasSeriesRecords}" />
          <ItemsControl ItemsSource="{Binding SeriesRecords}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:RecentMeetingRow">
                <Border Classes="card" Padding="{DynamicResource D4Padding_12_10}" Margin="{DynamicResource D4Margin_0_0_0_6}">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource D4Spacing_8}">
                    <Border Grid.Column="0" Width="7" Height="7" CornerRadius="4"
                            Background="{Binding ModeTintBrush}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="{DynamicResource D4Spacing_2}">
                      <TextBlock Text="{Binding Title}" Classes="label" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Details}" Classes="caption" FontSize="11" TextWrapping="Wrap" MaxLines="2"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="2" Classes="quiet" Content="{loc:Tr 查看}" Tag="{Binding}"
                            Click="OpenRecord_Click" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- 资料：WorkspaceDocumentsTab + PreparationQueueSummary -->
        <StackPanel x:Name="DocumentsSection" Spacing="{DynamicResource D4Spacing_8}" IsVisible="False">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="{Binding SeriesEditorPreparationSummary}" Classes="label"
                       TextWrapping="Wrap" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource D4Spacing_6}">
              <ProgressBar IsIndeterminate="True" Width="80" IsVisible="{Binding SeriesEditorImporting}" />
              <Button Content="{loc:Tr 导入资料}" Click="ImportDocuments_Click" />
            </StackPanel>
          </Grid>
          <TextBlock Text="{Binding SeriesEditorImportStatus}" Classes="caption" />
          <TextBlock Text="{Binding SeriesEditorAttentionText}" Classes="caption" Foreground="{DynamicResource Caution}"
                     IsVisible="{Binding SeriesEditorNeedsAttention}" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding SeriesEditorPreparationRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:SeriesPreparationRow">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource D4Spacing_8}"
                      Margin="{DynamicResource D4Margin_0_0_0_6}">
                  <StackPanel Grid.Column="0" Spacing="{DynamicResource D4Spacing_2}">
                    <TextBlock Text="{Binding FileName}" Classes="caption" TextTrimming="CharacterEllipsis" />
                    <ProgressBar Value="{Binding Completed}" Maximum="{Binding Total}" IsVisible="{Binding HasTotal}" />
                    <TextBlock Text="{Binding ProgressText}" Classes="caption" FontSize="11" />
                    <TextBlock Text="{Binding Message}" Classes="caption" FontSize="11" TextWrapping="Wrap"
                               IsVisible="{Binding HasMessage}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource D4Spacing_4}"
                              VerticalAlignment="Center">
                    <Button Classes="quiet" Content="{loc:Tr 重试}" Tag="{Binding}" Click="RetryPreparation_Click"
                            IsVisible="{Binding CanRetry}" />
                    <Button Classes="quiet" Content="{loc:Tr 取消}" Tag="{Binding}" Click="CancelPreparation_Click"
                            IsVisible="{Binding CanCancel}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{loc:Tr 还没有资料。点「导入资料」把 PDF、Word、PPT、Excel、Markdown 或图片加进这个系列。}" Classes="caption"
                     TextWrapping="Wrap" IsVisible="{Binding SeriesEditorDocumentsEmpty}" />
          <ItemsControl ItemsSource="{Binding SeriesEditorDocuments}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:SeriesDocumentRow">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource D4Spacing_8}"
                      Margin="{DynamicResource D4Margin_0_0_0_6}">
                  <CheckBox Grid.Column="0" IsChecked="{Binding Enabled, Mode=TwoWay}" Tag="{Binding}"
                            Click="DocumentEnabled_Click" ToolTip.Tip="{loc:Tr 开启后，回答时会参考这份资料。}" />
                  <StackPanel Grid.Column="1" Spacing="{DynamicResource D4Spacing_1}">
                    <TextBlock Text="{Binding Name}" Classes="caption" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource D4Spacing_6}">
                      <TextBlock Text="{Binding MetaText}" Classes="faint" FontSize="11" />
                      <TextBlock Text="{Binding FormatLabel}" Classes="faint" FontSize="11" />
                      <TextBlock Text="{Binding Category}" Classes="faint" FontSize="11" />
                    </StackPanel>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{DynamicResource D4Spacing_4}">
                    <Button Classes="quiet" Content="{loc:Tr 移动}" Tag="{Binding}" Click="MoveCategory_Click"
                            ToolTip.Tip="{loc:Tr 选择这份资料所属的分类}" />
                    <Button Classes="quiet" Content="{loc:Tr 移除}" Tag="{Binding}" Click="RemoveDocument_Click"
                            ToolTip.Tip="{loc:Tr 从当前系列移除这份资料}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Classes="quiet" Content="{loc:Tr 撤销移除}" Command="{Binding UndoRemoveSeriesDocumentCommand}"
                  HorizontalAlignment="Left" />
          <TextBlock Text="{loc:Tr 支持 PDF（含扫描件 OCR）、Word、PowerPoint、Excel、Markdown、TXT 与图片；回答时只把与问题相关的片段交给模型，并标注来源。}"
                     Classes="caption" TextWrapping="Wrap" />
        </StackPanel>

        <!-- 经验积累：KnowledgeTab + ReviewTab -->
        <StackPanel x:Name="KnowledgeSection" Spacing="{DynamicResource D4Spacing_10}" IsVisible="False">
          <TextBlock Text="{loc:Tr 经验库与题库}" Classes="section" />
          <TextBlock Text="{Binding SeriesEditorStatistics}" Classes="caption" />
          <TextBlock Text="{loc:Tr 阶段复盘}" Classes="section" />
          <TextBox Text="{Binding SeriesEditorStageReview}" AcceptsReturn="True" TextWrapping="Wrap"
                   Height="100" IsReadOnly="{Binding IsSeriesEditorReadOnly}" />
          <TextBlock Text="{loc:Tr 经验}" Classes="section" Margin="{DynamicResource D4Margin_0_6_0_0}" />
          <TextBlock Text="{loc:Tr 还没有经验。}" Classes="caption" IsVisible="{Binding !HasSeriesLessons}" />
          <ItemsControl ItemsSource="{Binding SeriesLessons}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="core:WorkspaceLesson">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource D4Spacing_6}"
                      Margin="{DynamicResource D4Margin_0_0_0_4}">
                  <TextBlock Grid.Column="0" Text="{Binding Text}" Classes="caption" TextWrapping="Wrap"
                             VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource D4Spacing_2}">
                    <Button Classes="quiet" Content="{loc:Tr 编辑}" Tag="{Binding}" Click="EditLesson_Click" />
                    <Button Classes="quiet" Content="{loc:Tr 删除}" Tag="{Binding}" Click="DeleteLesson_Click" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{loc:Tr 题库}" Classes="section" Margin="{DynamicResource D4Margin_0_6_0_0}" />
          <TextBlock Text="{loc:Tr 题库还空着。}" Classes="caption" IsVisible="{Binding !HasSeriesBank}" />
          <ItemsControl ItemsSource="{Binding SeriesBank}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:QuestionBankRow">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource D4Spacing_6}"
                      Margin="{DynamicResource D4Margin_0_0_0_4}">
                  <StackPanel Grid.Column="0" Spacing="{DynamicResource D4Spacing_1}">
                    <TextBlock Text="{Binding Question}" Classes="caption" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Answer}" Classes="faint" FontSize="11" TextWrapping="Wrap"
                               IsVisible="{Binding HasAnswer}" MaxLines="2" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource D4Spacing_2}">
                    <Button Classes="quiet" Content="{loc:Tr 编辑}" Tag="{Binding}" Click="EditBankItem_Click" />
                    <Button Classes="quiet" Content="{loc:Tr 删除}" Tag="{Binding}" Click="DeleteBankItem_Click" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- 基本信息：WorkspaceBasicTab -->
        <StackPanel x:Name="BasicSection" Spacing="{DynamicResource D4Spacing_10}" IsVisible="False">
          <TextBlock Text="{Binding SeriesEditorModeTitle}" Classes="section" />
          <TextBlock Text="{loc:Tr 系列名称}" Classes="caption" />
          <TextBox Text="{Binding SeriesEditorName}" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource D4Spacing_10}">
            <StackPanel Grid.Column="0" Spacing="{DynamicResource D4Spacing_4}">
              <TextBlock Text="{loc:Tr 类型}" Classes="caption" />
              <ComboBox ItemsSource="{Binding SeriesEditorModeChoices}" SelectedItem="{Binding SeriesEditorMode}"
                        HorizontalAlignment="Stretch" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="{DynamicResource D4Spacing_4}">
              <TextBlock Text="{loc:Tr 回答风格}" Classes="caption" />
              <TextBox Text="{Binding SeriesEditorStyle}" PlaceholderText="concise / detailed" />
            </StackPanel>
          </Grid>
          <CheckBox Content="{loc:Tr 使用系列知识（经验与题库）}" IsChecked="{Binding SeriesEditorUseKnowledge}" />
          <TextBlock Text="{loc:Tr 领域字段}" Classes="section" />
          <TextBlock Text="{Binding SeriesEditorRole}" Classes="caption" />
          <ItemsControl ItemsSource="{Binding SeriesEditorFieldRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:SeriesEditorFieldRow">
                <StackPanel Spacing="{DynamicResource D4Spacing_4}" Margin="{DynamicResource D4Margin_0_0_0_8}">
                  <TextBlock Text="{Binding Title}" Classes="caption" />
                  <TextBox Text="{Binding Value, Mode=TwoWay}" PlaceholderText="{Binding Placeholder}"
                           AcceptsReturn="{Binding Long}" TextWrapping="Wrap" MinHeight="{Binding EditorHeight}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{loc:Tr 这些字段会进入这个系列的准备页和回答提示；留空表示不用。}" Classes="caption" />
        </StackPanel>

        <!-- 回答要求：WorkspaceRequirementsTab -->
        <StackPanel x:Name="RequirementsSection" Spacing="{DynamicResource D4Spacing_10}" IsVisible="False">
          <TextBlock Text="{loc:Tr 回答要求}" Classes="section" />
          <TextBlock Text="{Binding SeriesEditorRole}" Classes="caption" />
          <TextBlock Text="{Binding SeriesEditorReviewFocus}" Classes="caption" TextWrapping="Wrap" />
          <TextBlock Text="{loc:Tr 要求 / 偏好}" Classes="caption" />
          <TextBox Text="{Binding SeriesEditorPreferences}" AcceptsReturn="True" TextWrapping="Wrap" Height="140"
                   PlaceholderText="{loc:Tr 例如：先说结论再说依据；数据都标注来源。}" />
          <TextBlock Text="{loc:Tr 复盘 / 当前阶段}" Classes="caption" />
          <TextBox Text="{Binding SeriesEditorStageReview}" AcceptsReturn="True" TextWrapping="Wrap" Height="120" />
        </StackPanel>

        <!-- 系列技能：WorkspaceSkillsSection -->
        <StackPanel x:Name="SkillsSection" Spacing="{DynamicResource D4Spacing_8}" IsVisible="False">
          <TextBlock Text="{loc:Tr 技能}" Classes="section" />
          <TextBlock Text="{loc:Tr 还没有技能。技能是一份 Markdown 说明（如 SKILL.md）：说话方式、答题套路、领域知识，回答时会遵循。}"
                     Classes="caption" TextWrapping="Wrap" IsVisible="{Binding !HasSeriesSkills}" />
          <ItemsControl ItemsSource="{Binding SeriesSkills}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:SeriesSkillRow">
                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsAttached, Mode=TwoWay}"
                          MinHeight="36" Margin="{DynamicResource D4Margin_0_0_0_4}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Grid>
    </ScrollViewer>

    <!-- Footer intentionally empty: Mac WorkspaceEditor has no persistent footer. -->
  </Grid>
</Window>
