<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:NextThought.Desktop.Localization"
        xmlns:local="using:NextThought.Desktop"
        xmlns:core="using:NextThought.Core"
        x:Class="NextThought.Desktop.Views.SeriesEditorWindow"
        x:DataType="local:AppState"
        Title="{loc:Tr 编辑系列}" Width="620" Height="520" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Paper}">
  <StackPanel Margin="{DynamicResource D4Margin_22}" Spacing="{DynamicResource D4Spacing_10}">
    <TextBlock Text="{loc:Tr 基本信息}" Classes="section" />
    <TextBlock Text="{loc:Tr 名称}" Classes="caption" />
    <TextBox Text="{Binding SeriesEditorName}" />
    <TextBlock Text="{loc:Tr 类型}" Classes="caption" />
    <TextBox Text="{Binding SeriesEditorMode}" PlaceholderText="interview / meeting / academic…" />
    <TextBlock Text="{loc:Tr 回答风格}" Classes="caption" />
    <TextBox Text="{Binding SeriesEditorStyle}" PlaceholderText="concise / detailed" />
    <TextBlock Text="{loc:Tr 要求 / Preferences}" Classes="caption" />
    <TextBox Text="{Binding SeriesEditorPreferences}" AcceptsReturn="True" TextWrapping="Wrap" Height="100" />
    <CheckBox Content="{loc:Tr 使用系列知识（经验与题库）}" IsChecked="{Binding SeriesEditorUseKnowledge}" />
    <TextBlock Text="{loc:Tr '领域字段（每行 key=value）'}" Classes="section" />
    <TextBox Text="{Binding SeriesEditorFieldsText}" AcceptsReturn="True" TextWrapping="Wrap" Height="90" />
    <TextBlock Text="{loc:Tr 复盘 / 当前阶段}" Classes="section" />
    <TextBox Text="{Binding SeriesEditorStageReview}" AcceptsReturn="True" TextWrapping="Wrap" Height="70" />
    <TextBlock Text="{loc:Tr 系列文档}" Classes="section" />
    <ItemsControl ItemsSource="{Binding SeriesEditorDocuments}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="core:ContextDocument">
          <Grid ColumnDefinitions="*,Auto" Margin="{DynamicResource D4Margin_0_0_0_6}">
            <TextBlock Text="{Binding Name}" Classes="caption" />
            <Button Grid.Column="1" Classes="quiet" Content="{loc:Tr 删除}" Tag="{Binding}" Click="RemoveDocument_Click" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Text="{loc:Tr 把资料加入系列请在资料库中选择；这里可移除。}" Classes="caption" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="{DynamicResource D4Spacing_8}">
      <Button Content="{loc:Tr 归档系列}" Command="{Binding ArchiveSeriesCommand}" Click="Close_Click" />
      <Button Content="{loc:Tr 删除系列}" Click="DeleteSeries_Click" Classes="destructive" />
      <Button Content="{loc:Tr 取消}" Click="Close_Click" />
      <Button Classes="primary" Content="{loc:Tr 保存}" Command="{Binding SaveSeriesEditorCommand}" Click="Close_Click" />
    </StackPanel>
  </StackPanel>
</Window>