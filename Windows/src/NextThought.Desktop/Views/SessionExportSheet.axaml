<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:NextThought.Desktop.Localization"
        xmlns:local="using:NextThought.Desktop"
        xmlns:controls="using:NextThought.Desktop.Controls"
        x:Class="NextThought.Desktop.Views.SessionExportSheet"
        x:DataType="local:AppState"
        Title="{loc:Tr 导出会议}" Width="860" Height="620" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Paper}">
  <!-- E21 / §6.7: the export sheet (SessionExportUI.swift SessionExportSheet). VStack spacing 16,
       padding 24; 格式/转写/语言 pickers 180/180/160 wide; the same projection feeds the preview and
       the file; the export button is the default action and is off while the archive has errors. -->
  <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto" RowSpacing="0">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
      <StackPanel Grid.Column="0" Spacing="4">
        <TextBlock Text="{loc:Tr 导出会议}" Classes="section" />
        <TextBlock Text="{Binding SessionExportTitle}" Classes="caption" Foreground="{DynamicResource Secondary}"
                   TextTrimming="CharacterEllipsis" MaxLines="1" />
      </StackPanel>
      <Button x:Name="CloseButton" Grid.Column="1" Classes="quiet" Content="{loc:Tr 关闭}"
              Click="Close_Click" VerticalAlignment="Top" />
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="180,180,160" ColumnSpacing="12" Margin="0,16,0,0">
      <StackPanel Grid.Column="0" Spacing="6">
        <TextBlock Text="{loc:Tr 格式}" Classes="label" />
        <controls:MenuPicker x:Name="FormatBox" HorizontalAlignment="Stretch" SelectedIndex="0"
                             SelectionChanged="Option_Changed" />
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="6">
        <TextBlock Text="{loc:Tr 转写}" Classes="label" />
        <controls:MenuPicker x:Name="VariantBox" HorizontalAlignment="Stretch" SelectedIndex="0"
                             SelectionChanged="Option_Changed" />
      </StackPanel>
      <StackPanel Grid.Column="2" Spacing="6">
        <TextBlock Text="{loc:Tr 语言}" Classes="label" />
        <controls:MenuPicker x:Name="LanguageBox" HorizontalAlignment="Stretch" SelectedIndex="0"
                             SelectionChanged="Option_Changed" />
      </StackPanel>
    </Grid>

    <!-- One caption under the pickers: what the preview shows for this format. -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,16,0,0">
      <TextBlock Text="{StaticResource IconInfoCircle}" FontFamily="{StaticResource IconFont}" FontSize="12"
                 Foreground="{DynamicResource Secondary}" VerticalAlignment="Top" Margin="0,2,0,0" />
      <TextBlock x:Name="HintText" Classes="caption" Foreground="{DynamicResource Secondary}"
                 TextWrapping="Wrap" MaxLines="3" />
    </StackPanel>

    <!-- The archive has missing/read errors: the export is paused. -->
    <Border x:Name="ReadIssuePanel" Grid.Row="3" IsVisible="False" Margin="0,12,0,0" Padding="12"
            CornerRadius="8" Background="#148A5707">
      <StackPanel Spacing="4">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="{StaticResource IconExclamationmarkTriangleFill}" FontFamily="{StaticResource IconFont}"
                     FontSize="12" Foreground="{DynamicResource Caution}" VerticalAlignment="Center" />
          <TextBlock Text="{loc:Tr 归档有缺失或读取错误，导出已暂停。}" Classes="label"
                     Foreground="{DynamicResource Caution}" />
        </StackPanel>
        <TextBlock x:Name="ReadIssueText" Classes="caption" Foreground="{DynamicResource Secondary}"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <!-- Derived notes/hand notes may be stale, or came from an old archive without a source revision. -->
    <StackPanel x:Name="StaleNotice" Grid.Row="4" Orientation="Horizontal" Spacing="6" Margin="0,10,0,0"
                IsVisible="False">
      <TextBlock x:Name="StaleIcon" FontFamily="{StaticResource IconFont}" FontSize="12"
                 VerticalAlignment="Center" />
      <TextBlock x:Name="StaleText" Classes="caption" TextWrapping="Wrap" />
    </StackPanel>

    <!-- Subtitle timing/translation warnings (only for SRT/VTT). -->
    <StackPanel x:Name="SubtitleWarnings" Grid.Row="5" Orientation="Horizontal" Spacing="12" Margin="0,8,0,0"
                IsVisible="False">
      <StackPanel x:Name="EstimatedWarning" Orientation="Horizontal" Spacing="6" IsVisible="False">
        <TextBlock Text="{StaticResource IconClock}" FontFamily="{StaticResource IconFont}" FontSize="12"
                   Foreground="{DynamicResource Caution}" VerticalAlignment="Center" />
        <TextBlock x:Name="EstimatedText" Classes="caption" Foreground="{DynamicResource Caution}" />
      </StackPanel>
      <StackPanel x:Name="StaleTranslationWarning" Orientation="Horizontal" Spacing="6" IsVisible="False">
        <TextBlock Text="{StaticResource IconArrowClockwise}" FontFamily="{StaticResource IconFont}" FontSize="12"
                   Foreground="{DynamicResource Caution}" VerticalAlignment="Center" />
        <TextBlock x:Name="StaleTranslationText" Classes="caption" Foreground="{DynamicResource Caution}" />
      </StackPanel>
    </StackPanel>

    <!-- The same projection text the file gets: a sunken, hairline-bordered surface. -->
    <Border Grid.Row="6" Margin="0,16,0,0" MinHeight="260" MaxHeight="430" Background="{DynamicResource Sunken}"
            BorderBrush="{DynamicResource Hairline}" BorderThickness="1" CornerRadius="8">
      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <TextBox x:Name="PreviewBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                 FontFamily="{StaticResource MonoFamily}" FontSize="11" Background="Transparent"
                 BorderThickness="0" IsTabStop="False" />
      </ScrollViewer>
    </Border>

    <Grid Grid.Row="7" ColumnDefinitions="*,Auto" Margin="0,16,0,0">
      <TextBlock x:Name="StatusText" Grid.Column="0" Classes="caption" Foreground="{DynamicResource Secondary}"
                 TextWrapping="Wrap" MaxLines="2" VerticalAlignment="Center" />
      <Button x:Name="ExportButton" Grid.Column="1" Classes="primary" Content="{loc:Tr 导出…}"
              Click="Export_Click" IsEnabled="False" />
    </Grid>
  </Grid>
</Window>
