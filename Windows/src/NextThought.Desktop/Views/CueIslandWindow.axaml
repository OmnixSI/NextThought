<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:NextThought.Desktop.Localization"
        xmlns:local="using:NextThought.Desktop"
        x:Class="NextThought.Desktop.Views.CueIslandWindow"
        x:DataType="local:AppState"
        Title="{loc:Tr NextThought 提词岛}"
        Width="560" SizeToContent="Height"
        CanResize="False" ShowInTaskbar="False" ShowActivated="False"
        WindowDecorations="None" Topmost="True"
        Background="Transparent" TransparencyLevelHint="Transparent"
        WindowStartupLocation="Manual">
  <!-- The island: a black pill on top of the screen, holding the question being answered
       and the first lines of the answer. Ported from CueIsland.swift (Windows has no notch). -->
  <Border Background="#F0121110" CornerRadius="{DynamicResource D4CornerRadius_20}" Padding="{DynamicResource D4Padding_16_11}" Margin="{DynamicResource D4Margin_0_8_0_0}"
          BoxShadow="0 10 22 0 #40000000">
    <Border x:Name="InnerBorder" Background="#F2121110" BorderBrush="#33ECEBE8" BorderThickness="0.5" CornerRadius="{DynamicResource D4CornerRadius_16}" Padding="{DynamicResource D4Padding_16_10}">
      <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
        <Border Grid.Row="0" Grid.Column="0" Width="8" Height="8" CornerRadius="{DynamicResource D4CornerRadius_4}" VerticalAlignment="Center"
                Background="{DynamicResource Seal}" Margin="{DynamicResource D4Margin_0_0_10_0}" IsVisible="{Binding Recording}" />
        <Border Grid.Row="0" Grid.Column="0" Width="8" Height="8" CornerRadius="{DynamicResource D4CornerRadius_4}" VerticalAlignment="Center"
                Background="#B8B6AF" Margin="{DynamicResource D4Margin_0_0_10_0}" IsVisible="{Binding !Recording}" />
        <TextBlock x:Name="QuestionText" Grid.Row="0" Grid.Column="1" Text="{Binding DetectedQuestion}" Foreground="#ECEBE8"
                   FontSize="14" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" />
        <TextBlock x:Name="SceneText" Grid.Row="0" Grid.Column="2" Text="{Binding SceneTitle}" Foreground="#7A7871" FontSize="10"
                   VerticalAlignment="Center" Margin="{DynamicResource D4Margin_12_0_0_0}" />
        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="{DynamicResource D4Margin_18_6_0_0}">
          <TextBlock x:Name="HeadlineText" Text="{Binding IslandHeadline}" Foreground="#ECEBE8"
                     FontSize="13.5" LineHeight="20" MaxLines="2"
                     TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
          <!-- E6/Mac CueRow.withGloss: the meaning of the sentence in small print. -->
          <TextBlock x:Name="HeadlineGlossText" Text="{Binding IslandHeadlineGloss}" Foreground="#9FB4C7"
                     FontSize="11" LineHeight="15" MaxLines="2" TextTrimming="CharacterEllipsis" TextWrapping="Wrap"
                     IsVisible="{Binding HasIslandHeadlineGloss}" />
        </StackPanel>
        <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="{DynamicResource D4Margin_18_3_0_0}">
          <TextBlock x:Name="DetailText" Text="{Binding IslandDetail}" Foreground="#B8B6AF"
                     FontSize="11.5" LineHeight="17" MaxLines="2"
                     TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
          <TextBlock x:Name="DetailGlossText" Text="{Binding IslandDetailGloss}" Foreground="#8FA6B8"
                     FontSize="10.5" LineHeight="15" MaxLines="2" TextTrimming="CharacterEllipsis" TextWrapping="Wrap"
                     IsVisible="{Binding HasIslandDetailGloss}" />
        </StackPanel>
        <!-- 同传上岛：对方那句话的译文（逐字更新，过期结果不会覆盖新句子）。 -->
        <StackPanel x:Name="TranslationPanel" Grid.Row="3" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="{DynamicResource D4Spacing_6}" Margin="{DynamicResource D4Margin_18_5_0_0}"
                    IsVisible="{Binding HasIslandTranslation}">
          <TextBlock Text="{loc:Tr 译}" Foreground="#7A7871" FontSize="10" VerticalAlignment="Center" />
          <TextBlock Text="{Binding IslandTranslation}" Foreground="#DCE3EA" FontSize="12" LineHeight="17"
                     MaxLines="2" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxWidth="470" />
        </StackPanel>
        <TextBlock x:Name="SlidePointsText" Grid.Row="4" Grid.ColumnSpan="3" Text="{Binding CurrentSlidePointsText}"
                   Foreground="#AFC7D9" FontSize="11" LineHeight="16" TextWrapping="Wrap" MaxLines="4"
                   Margin="{DynamicResource D4Margin_18_5_0_0}" IsVisible="{Binding HasCurrentSlidePoints}" />
        <Border Grid.Row="5" Grid.ColumnSpan="3" Background="#1A7AB8D9" CornerRadius="{DynamicResource D4CornerRadius_8}"
                Padding="{DynamicResource D4Padding_10_5}" Margin="{DynamicResource D4Margin_18_5_0_0}"
                IsVisible="{Binding HasCoachHint}">
          <TextBlock Text="{Binding CoachHint}" Foreground="#DCE3EA" FontSize="11.5" TextWrapping="Wrap" MaxLines="2" />
        </Border>
        <StackPanel Grid.Row="6" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="{DynamicResource D4Spacing_8}"
                    Margin="{DynamicResource D4Margin_18_5_0_0}" IsVisible="{Binding HasAutoEndNotice}">
          <TextBlock Text="{Binding AutoEndNotice}" Foreground="#E9C46A" FontSize="11.5" TextWrapping="Wrap" MaxWidth="430" VerticalAlignment="Center" />
          <Button Classes="quiet" Content="{loc:Tr 继续记录}" Command="{Binding KeepRecordingCommand}" />
        </StackPanel>
        <TextBlock Grid.Row="7" Grid.ColumnSpan="3" Text="{Binding BilingualQuestionText}" Foreground="#9FB4C7"
                   FontSize="12" LineHeight="17" TextWrapping="Wrap" MaxLines="2"
                   Margin="{DynamicResource D4Margin_18_5_0_0}" IsVisible="{Binding HasBilingualQuestion}" />
        <StackPanel x:Name="ActionPanel" Grid.Row="8" Grid.ColumnSpan="3" Orientation="Horizontal"
                    Spacing="{DynamicResource D4Spacing_4}" Margin="{DynamicResource D4Margin_18_7_0_0}" IsVisible="False">
          <Button Classes="quiet" Content="{StaticResource IconChevronLeft}" FontFamily="{StaticResource IconFont}" Command="{Binding PreviousAnswerCommand}" />
          <Button Classes="quiet" Content="{StaticResource IconChevronRight}" FontFamily="{StaticResource IconFont}" Command="{Binding NextAnswerCommand}" />
          <Button Classes="quiet" Content="{loc:Tr 重新生成}" Command="{Binding RegenerateAnswerCommand}" />
          <Button Classes="quiet" Content="{loc:Tr 改短}" Command="{Binding ShorterAnswerCommand}" />
          <Button Classes="quiet" Content="{loc:Tr 复制}" Command="{Binding CopyAnswerCommand}" />
          <Button Classes="quiet" Content="{loc:Tr 取消}" Command="{Binding CancelCommand}" />
        </StackPanel>
        <TextBlock x:Name="PhaseText" Grid.Row="9" Grid.ColumnSpan="3" Text="" Foreground="#9FB4C7"
                   FontSize="12" LineHeight="17" TextWrapping="Wrap" MaxLines="2"
                   Margin="{DynamicResource D4Margin_18_5_0_0}" IsVisible="False" />
      </Grid>
    </Border>
  </Border>
</Window>
