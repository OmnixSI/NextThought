<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:NextThought.Desktop.Localization"
        x:Class="NextThought.Desktop.Views.TeleprompterHandleWindow"
        Width="210" Height="40"
        CanResize="False" ShowInTaskbar="False" ShowActivated="False"
        WindowDecorations="None" Topmost="True"
        Background="Transparent" TransparencyLevelHint="Transparent"
        WindowStartupLocation="Manual">
  <Border Background="#F0121110" CornerRadius="{DynamicResource D4CornerRadius_10}" Padding="{DynamicResource D4Padding_8_4}"
          BorderBrush="#33ECEBE8" BorderThickness="0.5">
    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource D4Spacing_8}" VerticalAlignment="Center">
      <TextBlock Text="{loc:Tr 提词器已穿透}" Foreground="#CFCBC3" FontSize="11" VerticalAlignment="Center" />
      <Button Content="{loc:Tr 恢复点击}" Click="Restore_Click" Padding="{DynamicResource D4Padding_8_2}" MinHeight="24" FontSize="11" />
    </StackPanel>
  </Border>
</Window>
