<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NextThought.Desktop.Views.TeleprompterHandleWindow"
        Width="210" Height="40"
        CanResize="False" ShowInTaskbar="False" ShowActivated="False"
        WindowDecorations="None" Topmost="True"
        Background="Transparent" TransparencyLevelHint="Transparent"
        WindowStartupLocation="Manual">
  <Border Background="#F0121110" CornerRadius="10" Padding="8,4"
          BorderBrush="#33ECEBE8" BorderThickness="0.5">
    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
      <TextBlock Text="提词器已穿透" Foreground="#CFCBC3" FontSize="11" VerticalAlignment="Center" />
      <Button Content="恢复点击" Click="Restore_Click" Padding="8,2" MinHeight="24" FontSize="11" />
    </StackPanel>
  </Border>
</Window>
