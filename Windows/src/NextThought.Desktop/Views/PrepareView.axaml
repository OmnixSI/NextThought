<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:NextThought.Desktop"
             xmlns:core="using:NextThought.Core"
             x:Class="NextThought.Desktop.Views.PrepareView"
             x:DataType="local:AppState">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="{DynamicResource D4Margin_40_26_40_36}" MaxWidth="720" HorizontalAlignment="Center" Spacing="{DynamicResource D4Spacing_18}">
      <StackPanel Spacing="{DynamicResource D4Spacing_6}">
        <TextBlock Text="准备" Classes="display" />
        <TextBlock Text="先选场合、补资料、做检查，再开始这场会。" Classes="caption" />
      </StackPanel>

      <Border Classes="card" Padding="{DynamicResource D4Padding_22}">
        <StackPanel Spacing="{DynamicResource D4Spacing_12}">
          <TextBlock Text="类型与标题" Classes="section" />
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border Width="44" Height="44" CornerRadius="{DynamicResource D4CornerRadius_10}"
                    Background="{DynamicResource Sunken}" VerticalAlignment="Center">
              <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                         Foreground="{DynamicResource Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBox Grid.Column="1" Text="{Binding MeetingTitle}" Background="Transparent" BorderThickness="0"
                     FontFamily="{StaticResource SerifFamily}" FontSize="22" MinHeight="36"
                     PlaceholderText="给这场会起个名字" />
          </Grid>
          <ItemsControl ItemsSource="{Binding Scenes}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:SceneChoice">
                <Button Classes="scene" Tag="{Binding}" Click="PrepareScene_Click"
                        Margin="{DynamicResource D4Margin_0_0_4_4}">
                  <TextBlock Text="{Binding Title}" FontSize="13" />
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding SelectedScene.Promise}" Classes="caption" Foreground="{DynamicResource Secondary}" />
        </StackPanel>
      </Border>

      <Border Classes="card" Padding="{DynamicResource D4Padding_22}">
        <StackPanel Spacing="{DynamicResource D4Spacing_10}">
          <TextBlock Text="系列与资料" Classes="section" />
          <TextBlock Text="{Binding SeriesSummary}" Classes="body" />
          <ListBox ItemsSource="{Binding SeriesRows}" SelectedItem="{Binding SelectedSeries}"
                   Background="Transparent" BorderThickness="0" MaxHeight="160">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="local:SeriesRow">
                <StackPanel Spacing="{DynamicResource D4Spacing_2}">
                  <TextBlock Text="{Binding Name}" Classes="label" />
                  <TextBlock Text="{Binding Meta}" Classes="caption" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Text="{Binding SelectedSeriesTitle}" Classes="label" />
          <TextBlock Text="{Binding SelectedSeriesMeta}" Classes="caption" />
          <WrapPanel>
            <CheckBox Content="带入资料" IsChecked="{Binding CarryMaterials}" />
            <CheckBox Content="带入题库" IsChecked="{Binding CarryReview}" />
            <CheckBox Content="带入经验" IsChecked="{Binding CarryLessons}" />
            <CheckBox Content="带入上一场转写" IsChecked="{Binding CarryTranscript}" />
          </WrapPanel>
          <TextBlock Text="{Binding Library.MaterialCountText}" Classes="caption" />
          <ItemsControl ItemsSource="{Binding Library.Materials}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="core:MaterialDocument">
                <TextBlock Text="{Binding Name}" Classes="caption" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource D4Spacing_8}">
            <Button Content="打开资料库" Command="{Binding NavigateCommand}" CommandParameter="Library" />
            <Button Content="打开系列" Command="{Binding NavigateCommand}" CommandParameter="Series" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card" Padding="{DynamicResource D4Padding_22}">
        <StackPanel Spacing="{DynamicResource D4Spacing_10}">
          <TextBlock Text="检查" Classes="section" />
          <StackPanel Spacing="{DynamicResource D4Spacing_8}">
            <Grid ColumnDefinitions="90,*" ColumnSpacing="10">
              <TextBlock Text="采音" Classes="caption" />
              <TextBlock Grid.Column="1" Text="{Binding AudioSourceText}" Classes="caption" TextWrapping="Wrap" />
            </Grid>
            <Grid ColumnDefinitions="90,*" ColumnSpacing="10">
              <TextBlock Text="场地" Classes="caption" />
              <TextBlock Grid.Column="1" Text="本机 · 不依赖网络" Classes="caption" />
            </Grid>
            <Grid ColumnDefinitions="90,*" ColumnSpacing="10">
              <TextBlock Text="回答服务" Classes="caption" />
              <TextBlock Grid.Column="1" Text="{Binding Settings.KeyStatus}" Classes="caption" TextWrapping="Wrap" />
            </Grid>
            <Grid ColumnDefinitions="90,*" ColumnSpacing="10">
              <TextBlock Text="手机伴侣" Classes="caption" />
              <TextBlock Grid.Column="1" Text="{Binding Settings.CompanionRelayUrl}" Classes="caption" TextWrapping="Wrap" />
            </Grid>
            <Grid ColumnDefinitions="90,*" ColumnSpacing="10">
              <TextBlock Text="资料" Classes="caption" />
              <TextBlock Grid.Column="1" Text="{Binding Library.MaterialCountText}" Classes="caption" />
            </Grid>
            <TextBlock Text="{Binding ModelStatusText}" Classes="caption" />
            <TextBlock Text="{Binding Status}" Classes="caption" TextWrapping="Wrap" />
          </StackPanel>
          <Button Classes="quiet" Content="打开设置" Command="{Binding NavigateCommand}" CommandParameter="Settings" />
        </StackPanel>
      </Border>

      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBlock Text="检查完即可开始；会中仍可随时切换场合。" Classes="caption" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource D4Spacing_8}">
          <Button Content="导入 WAV" Command="{Binding ImportWaveCommand}" />
          <Button Classes="primary" Content="开始记录" Command="{Binding StartRecordingCommand}" />
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>