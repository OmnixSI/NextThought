<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:NextThought.Desktop.Localization"
        x:Class="NextThought.Desktop.Views.ConfirmDialog"
        Title="{loc:Tr 确认}" Width="420" Height="170" WindowStartupLocation="CenterOwner"
        CanResize="False" Background="{DynamicResource Paper}">
  <StackPanel Margin="{DynamicResource D4Margin_22}" Spacing="{DynamicResource D4Spacing_12}">
    <TextBlock x:Name="MessageText" Classes="body" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="{DynamicResource D4Spacing_8}">
      <Button Content="{loc:Tr 取消}" Click="Cancel_Click" />
      <Button Classes="destructive" Content="{loc:Tr 删除}" Click="Confirm_Click" />
    </StackPanel>
  </StackPanel>
</Window>
