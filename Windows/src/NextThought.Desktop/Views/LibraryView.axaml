<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:NextThought.Desktop.Localization"
             xmlns:local="using:NextThought.Desktop"
             xmlns:core="using:NextThought.Core"
             x:Class="NextThought.Desktop.Views.LibraryView"
             x:DataType="local:AppState">
  <Grid RowDefinitions="Auto,*" Margin="{DynamicResource D4Margin_32_18_32_0}">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
      <StackPanel Spacing="{DynamicResource D4Spacing_6}">
        <TextBlock Text="{loc:Tr 资料库}" Classes="display" />
        <TextBlock Text="{loc:Tr 导入 PDF、Word、PPT、Excel、Markdown 与图片；解析在本机完成，检索时只把相关摘录发给回答服务。}"
                   Classes="caption" MaxWidth="620" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource D4Spacing_8}" VerticalAlignment="Center">
        <TextBlock Text="{Binding Library.ImportProgress}" Classes="caption" VerticalAlignment="Center" />
        <Button Classes="primary" Click="Import_Click" MinHeight="36" Padding="{DynamicResource D4Padding_18_0}"
                IsEnabled="{Binding !Library.Importing}">
          <TextBlock Text="{loc:Tr 导入资料}" Foreground="{DynamicResource OnInk}" />
        </Button>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="360,*" ColumnSpacing="16" Margin="{DynamicResource D4Margin_0_18_0_16}">
      <!-- Material list -->
      <Border Classes="card" Padding="{DynamicResource D4Padding_0}">
        <Grid RowDefinitions="Auto,*">
          <StackPanel Margin="{DynamicResource D4Margin_16_14_16_8}" Spacing="{DynamicResource D4Spacing_8}">
            <TextBox Text="{Binding Library.Filter}" PlaceholderText="{loc:Tr 筛选资料名称}" />
            <TextBlock Text="{Binding Library.ImportStatus}" Classes="caption" FontSize="11" TextWrapping="Wrap" />
          </StackPanel>
          <ListBox Grid.Row="1" ItemsSource="{Binding Library.Materials}" SelectedItem="{Binding Library.SelectedMaterial}"
                   Background="Transparent" Margin="{DynamicResource D4Margin_6_0_6_10}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="core:MaterialDocument">
                <Border Padding="{DynamicResource D4Padding_10_9}" CornerRadius="{DynamicResource D4CornerRadius_8}">
                    <StackPanel Spacing="{DynamicResource D4Spacing_3}">
                    <TextBlock Text="{Binding Name}" Classes="label" FontSize="13" TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" />
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource D4Spacing_6}">
                      <TextBlock Text="{Binding Extension}" Classes="caption" FontSize="11" />
                      <TextBlock Text="{Binding Blocks.Count}" Classes="caption" FontSize="11" />
                      <TextBlock Text="{loc:Tr 段}" Classes="caption" FontSize="11" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <!-- Preview -->
      <Border Grid.Column="1" Classes="card" Padding="{DynamicResource D4Padding_0}">
        <Grid RowDefinitions="Auto,*">
          <Grid Margin="{DynamicResource D4Margin_20_16_20_10}" ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="{loc:Tr 解析结果}" Classes="title" FontSize="15" />
              <TextBlock Text="{loc:Tr 按资料原有的页、幻灯片或工作表定位}" Classes="caption" FontSize="11" Margin="{DynamicResource D4Margin_0_3_0_0}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource D4Spacing_6}">
              <Button Classes="quiet" Content="{loc:Tr 复核}" Click="Review_Click" />
              <Button Classes="quiet" Content="{loc:Tr 打开文件位置}" Click="Reveal_Click" />
            </StackPanel>
          </Grid>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="{DynamicResource D4Padding_20_0_20_20}">
            <SelectableTextBlock Text="{Binding Library.SelectedPreview}" FontSize="13" LineHeight="22"
                                 TextWrapping="Wrap" Foreground="{DynamicResource InkBrush}" />
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
