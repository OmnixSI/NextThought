<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:NextThought.Desktop.Localization"
        xmlns:local="using:NextThought.Desktop"
        x:Class="NextThought.Desktop.Views.SubtitleBarWindow"
        x:DataType="local:AppState"
        Title="{loc:Tr NextThought 字幕条}"
        Width="920" SizeToContent="Height"
        CanResize="False" ShowInTaskbar="False" ShowActivated="False"
        WindowDecorations="None" Topmost="True"
        Background="Transparent" TransparencyLevelHint="Transparent"
        WindowStartupLocation="Manual">
  <!-- E14 / §6.7: the subtitle bar (SubtitleBarView.swift). The latest sentence on a floating
       card, its translation smaller beneath it, and nothing else. Room around the card for the
       shadow (16 top / 20 sides / 28 bottom) and the "对方可见" badge above the trailing corner. -->
  <Panel>
    <Panel x:Name="Outer" Margin="{DynamicResource D4Margin_20_16_20_28}">
      <Border x:Name="Card" Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Hairline}"
              BorderThickness="0.5" CornerRadius="{DynamicResource D4CornerRadius_22}" BoxShadow="0 12 26 0 #50000000" Padding="{DynamicResource D4Padding_24_12}">
        <StackPanel x:Name="Stack" Spacing="{DynamicResource D4Spacing_4}" HorizontalAlignment="Stretch">
          <!-- Auto-end reminder: the same countdown the live page shows as a banner. -->
          <StackPanel x:Name="AutoEndRow" Orientation="Horizontal" Spacing="{DynamicResource D4Spacing_12}" HorizontalAlignment="Center"
                      IsVisible="False">
            <TextBlock x:Name="AutoEndIcon" Text="{StaticResource IconMoonZzz}" FontFamily="{StaticResource IconFont}"
                       FontSize="13" Foreground="{DynamicResource Caution}" VerticalAlignment="Center" />
            <TextBlock x:Name="AutoEndText" FontSize="14" FontWeight="Medium"
                       Foreground="{DynamicResource Caution}" VerticalAlignment="Center" />
            <Button x:Name="KeepRecordingButton" Classes="primary" Content="{loc:Tr 继续记录}"
                    Click="KeepRecording_Click" />
          </StackPanel>

          <!-- One sentence, big and centred; its translation beneath. The other side is the
               default speaker and needs no label. -->
          <StackPanel x:Name="LineStack" Spacing="{DynamicResource D4Spacing_4}">
            <StackPanel x:Name="PrimaryRow" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="{DynamicResource D4Spacing_8}">
              <TextBlock x:Name="SpeakerLabel" FontSize="11" FontWeight="Medium"
                         Foreground="{DynamicResource Secondary}" VerticalAlignment="Center" IsVisible="False" />
              <TextBlock x:Name="PrimaryText" FontWeight="Medium" TextAlignment="Center" TextWrapping="Wrap"
                         MaxLines="2" Foreground="{DynamicResource InkBrush}" />
            </StackPanel>
            <TextBlock x:Name="SecondaryText" FontSize="13" Foreground="{DynamicResource Secondary}"
                       TextAlignment="Center" TextWrapping="NoWrap" MaxLines="1" IsVisible="False" />
          </StackPanel>
        </StackPanel>
      </Border>
      <!-- Resting the pointer on the bar makes it draggable; the outline says so. -->
      <Border x:Name="EditingOutline" BorderBrush="{DynamicResource Secondary}" BorderThickness="1.5"
              CornerRadius="{DynamicResource D4CornerRadius_22}" IsVisible="False" IsHitTestVisible="False" />
    </Panel>

    <!-- Shown while the window is not hidden from screen sharing. -->
    <Border x:Name="SharedBadge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="{DynamicResource D4Margin_0_7_8_0}"
            Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Hairline}" BorderThickness="0.5"
            CornerRadius="{DynamicResource D4CornerRadius_10}" Padding="{DynamicResource D4Padding_8_0}" Height="20">
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource D4Spacing_4}" VerticalAlignment="Center">
        <Border Width="6" Height="6" CornerRadius="{DynamicResource D4CornerRadius_3}" Background="{DynamicResource Caution}" VerticalAlignment="Center" />
        <TextBlock Text="{loc:Tr 对方可见}" Classes="caption" VerticalAlignment="Center" />
      </StackPanel>
    </Border>
  </Panel>
</Window>
