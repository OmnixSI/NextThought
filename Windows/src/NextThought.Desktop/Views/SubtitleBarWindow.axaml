<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:NextThought.Desktop"
        x:Class="NextThought.Desktop.Views.SubtitleBarWindow"
        x:DataType="local:AppState"
        Title="NextThought 字幕条"
        Width="920" SizeToContent="Height"
        CanResize="False" ShowInTaskbar="False" ShowActivated="False"
        WindowDecorations="None" Topmost="True"
        Background="Transparent" TransparencyLevelHint="Transparent"
        WindowStartupLocation="Manual">
  <!-- One sentence, big and centred; its translation small; who is speaking beneath. -->
  <Border Background="#F2141312" CornerRadius="18" Padding="30,14" Margin="0,0,0,10"
          BoxShadow="0 10 26 0 #50000000">
    <StackPanel Spacing="3">
      <TextBlock x:Name="PrimaryText" Foreground="#F5F3EE" FontSize="22" LineHeight="32"
                 TextAlignment="Center" TextWrapping="Wrap" />
      <TextBlock x:Name="SecondaryText" Foreground="#A3A19B" FontSize="14" LineHeight="21"
                 TextAlignment="Center" TextWrapping="Wrap" IsVisible="False" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="7" Margin="0,4,0,0">
        <Border x:Name="LiveDot" Width="6" Height="6" CornerRadius="3" VerticalAlignment="Center"
                Background="{DynamicResource Seal}" />
        <TextBlock x:Name="SpeakerText" Foreground="#7A7871" FontSize="11" VerticalAlignment="Center" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
