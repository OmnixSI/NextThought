<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:NextThought.Desktop.Localization"
        x:Class="NextThought.Desktop.Views.EditTextDialog"
        Title="{loc:Tr 编辑条目}" Width="560" Height="260" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Paper}">
  <StackPanel Margin="{DynamicResource D4Margin_20}" Spacing="{DynamicResource D4Spacing_10}">
    <TextBox x:Name="TextEditor" AcceptsReturn="True" TextWrapping="Wrap" Height="140" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="{DynamicResource D4Spacing_8}">
      <Button Content="{loc:Tr 取消}" Click="Cancel_Click" />
      <Button Classes="primary" Content="{loc:Tr 保存}" Click="Save_Click" />
    </StackPanel>
  </StackPanel>
</Window>