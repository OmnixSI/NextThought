<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:NextThought.Desktop.Localization"
             xmlns:local="using:NextThought.Desktop"
             x:Class="NextThought.Desktop.Views.InsightsPanel"
             x:DataType="local:AppState">
  <StackPanel Spacing="{DynamicResource D4Spacing_12}">
    <Border Classes="card" Padding="{DynamicResource D4Padding_14}">
      <StackPanel Spacing="{DynamicResource D4Spacing_6}">
        <TextBlock Text="{loc:Tr 幻灯片}" Classes="overline" />
        <TextBlock Text="{Binding SlideStatus}" Classes="label" />
        <TextBlock Text="{Binding CurrentSlideText}" Classes="caption" TextWrapping="Wrap" MaxLines="4" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{loc:Tr 讲稿要点}" Classes="overline" />
        <TextBlock Text="{Binding CurrentSlidePointsText}" Classes="caption" TextWrapping="Wrap" MaxLines="6" TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </Border>
    <Border Classes="card" Padding="{DynamicResource D4Padding_14}">
      <StackPanel Spacing="{DynamicResource D4Spacing_6}">
        <TextBlock Text="{loc:Tr 屏幕与截图}" Classes="overline" />
        <TextBlock Text="{Binding CurrentScreenshotCount}" Classes="label" />
        <ItemsControl ItemsSource="{Binding CurrentScreenshots}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Image Source="{Binding}" Width="120" Height="76" Stretch="UniformToFill" Margin="{DynamicResource D4Margin_0_0_6_6}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
    <Border Classes="card" Padding="{DynamicResource D4Padding_14}">
      <StackPanel Spacing="{DynamicResource D4Spacing_6}">
        <TextBlock Text="{loc:Tr 回答进度}" Classes="overline" />
        <TextBlock Text="{Binding Status}" Classes="caption" />
        <ProgressBar Value="{Binding Progress}" IsIndeterminate="{Binding ProgressIndeterminate}" Maximum="1" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>