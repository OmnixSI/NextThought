<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:NextThought.Desktop.Localization"
        xmlns:local="using:NextThought.Desktop"
        x:Class="NextThought.Desktop.Views.AddToGlossarySheet"
        x:DataType="local:AppState"
        Title="{loc:Tr 加入术语表}" Width="460" Height="420" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Paper}">
  <StackPanel Spacing="{DynamicResource D4Spacing_10}" Margin="{DynamicResource D4Margin_20}">
    <TextBlock Text="{loc:Tr 加入术语表}" Classes="section" />
    <TextBlock Text="{Binding GlossaryDraftLine}" Classes="caption" TextWrapping="Wrap" MaxLines="4"
               TextTrimming="CharacterEllipsis" />
    <TextBlock Text="{loc:Tr 在这句里选中听错的词并复制（⌘C），再打开本窗口，会自动填入。}"
               Classes="caption" FontSize="11" TextWrapping="Wrap" />
    <StackPanel Spacing="{DynamicResource D4Spacing_2}">
      <TextBlock Text="{loc:Tr 规范写法}" Classes="overline" />
      <TextBox Text="{Binding GlossaryDraftCanonical, Mode=TwoWay}" PlaceholderText="{loc:Tr 正确的写法}" />
    </StackPanel>
    <StackPanel Spacing="{DynamicResource D4Spacing_2}">
      <TextBlock Text="{loc:Tr 听错的写法}" Classes="overline" />
      <TextBox Text="{Binding GlossaryDraftHeard, Mode=TwoWay}" PlaceholderText="{loc:Tr 多个用逗号分隔}" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource D4Spacing_8}">
      <RadioButton GroupName="draftkind" Content="{Binding GlossaryKindTermLabel}"
                   Command="{Binding UseGlossaryTermKindCommand}" />
      <RadioButton GroupName="draftkind" Content="{Binding GlossaryKindPersonLabel}"
                   Command="{Binding UseGlossaryPersonKindCommand}" />
      <CheckBox Content="{loc:Tr 只用于当前系列}" IsChecked="{Binding GlossaryDraftSeriesOnly, Mode=TwoWay}"
                IsVisible="{Binding HasSelectedSeries}" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="{DynamicResource D4Spacing_8}">
      <Button Content="{loc:Tr 取消}" Click="Cancel_Click" />
      <Button Classes="primary" Content="{loc:Tr 加入}" Click="Add_Click" />
    </StackPanel>
  </StackPanel>
</Window>
