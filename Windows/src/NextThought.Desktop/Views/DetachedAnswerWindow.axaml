<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:NextThought.Desktop.Localization"
        xmlns:local="using:NextThought.Desktop"
        xmlns:views="using:NextThought.Desktop.Views"
        x:Class="NextThought.Desktop.Views.DetachedAnswerWindow"
        x:DataType="local:AppState"
        Title="{loc:Tr 参考回答}" Width="620" Height="540" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Paper}">
  <Grid RowDefinitions="Auto,*" Margin="{DynamicResource D4Margin_18}">
    <StackPanel Spacing="{DynamicResource D4Spacing_4}">
      <TextBlock Text="{Binding DetectedQuestion}" Classes="label" TextWrapping="Wrap" />
      <TextBlock Text="{Binding RetrievalInfo}" Classes="caption" />
    </StackPanel>
    <ScrollViewer Grid.Row="1" Margin="{DynamicResource D4Margin_0_10_0_0}" VerticalScrollBarVisibility="Auto">
      <views:MarkdownText Text="{Binding AnswerText}" BaseFontSize="15" />
    </ScrollViewer>
  </Grid>
</Window>