<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:NextThought.Desktop.Localization"
        xmlns:local="using:NextThought.Desktop"
        xmlns:core="using:NextThought.Core"
        x:Class="NextThought.Desktop.Views.NotesEditorWindow"
        x:DataType="local:AppState"
        Title="{loc:Tr 编辑纪要}" Width="980" Height="680" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Paper}">
  <Grid RowDefinitions="*,Auto" Margin="{DynamicResource D4Margin_18}">
    <Grid ColumnDefinitions="*,320" ColumnSpacing="14">
      <StackPanel Spacing="{DynamicResource D4Spacing_10}">
        <TextBlock Text="{loc:Tr 纪要编辑}" Classes="section" />
        <TextBlock Text="{loc:Tr 生成结果保持不变；这里的修改写入 user-content.json。}" Classes="caption" />
        <TextBox Text="{Binding NotesEditorText}" AcceptsReturn="True" TextWrapping="Wrap" Height="360"
                 FontFamily="{StaticResource MonoFamily}" FontSize="12" />
        <TextBlock Text="{loc:Tr 个人笔记}" Classes="section" />
        <TextBox Text="{Binding PersonalNotesText}" AcceptsReturn="True" TextWrapping="Wrap" Height="120" />
      </StackPanel>
      <Border Grid.Column="1" Classes="card" Padding="{DynamicResource D4Padding_14}">
        <StackPanel Spacing="{DynamicResource D4Spacing_8}">
          <TextBlock Text="{loc:Tr 证据}" Classes="section" />
          <ItemsControl ItemsSource="{Binding Sources}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="core:SourceCitation">
                <StackPanel Spacing="{DynamicResource D4Spacing_2}" Margin="{DynamicResource D4Margin_0_0_0_8}">
                  <TextBlock Text="{Binding Label}" Classes="label" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Quote}" Classes="caption" TextWrapping="Wrap" MaxLines="3" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </Grid>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="{DynamicResource D4Spacing_8}">
      <Button Content="{loc:Tr 关闭}" Click="Close_Click" />
      <Button Classes="primary" Content="{loc:Tr 保存}" Command="{Binding SaveNotesEditorCommand}" Click="Close_Click" />
    </StackPanel>
  </Grid>
</Window>