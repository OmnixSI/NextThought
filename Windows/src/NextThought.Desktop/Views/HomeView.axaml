<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:NextThought.Desktop.Localization"
             xmlns:local="using:NextThought.Desktop"
             xmlns:controls="using:NextThought.Desktop.Views.Controls"
             xmlns:home="using:NextThought.Desktop.Views.Home"
             x:Class="NextThought.Desktop.Views.HomeView"
             x:DataType="local:AppState">
  <Grid>
    <!-- E1/Mac: the page takes on the pigment of the picked scene (InkWash height 380). -->
    <controls:InkWash Mode="{Binding SelectedMode}" Height="380" VerticalAlignment="Top" Animated="True" />
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="{DynamicResource D4Margin_32_40_32_40}" MaxWidth="760" HorizontalAlignment="Center">
        <!-- Date + two-line hero: greeting in ink, the question in tertiary (Mac HomeView). -->
        <TextBlock Text="{Binding DateLine}" Classes="overline" />
        <StackPanel Spacing="{DynamicResource D4Spacing_2}" Margin="{DynamicResource D4Margin_0_12_0_0}">
          <TextBlock Text="{Binding HomeGreeting}" Classes="hero" Foreground="{DynamicResource InkBrush}" />
          <TextBlock Text="{Binding HomeQuestion}" Classes="hero" Foreground="{DynamicResource Tertiary}" Opacity="0.75" />
        </StackPanel>
        <home:OnboardingResumeRow />
        <!-- E1: Mac interruptedNotice row: 上次会议被中断，已保存到所有记录。 -->
        <Border Background="{DynamicResource Sunken}" CornerRadius="{DynamicResource RadiusSmall}"
                Padding="{DynamicResource D4Padding_12_6}" Margin="{DynamicResource D4Margin_0_10_0_0}"
                IsVisible="{Binding HasInterruptedNotice}">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="{DynamicResource D4Spacing_8}">
            <TextBlock Text="{StaticResource IconExclamationmarkTriangle}" FontFamily="{StaticResource IconFont}"
                       FontSize="12" Foreground="{DynamicResource Caution}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding InterruptedNotice}" Classes="caption" VerticalAlignment="Center"
                       TextWrapping="Wrap" />
            <Button Grid.Column="2" Classes="quiet" Content="{loc:Tr 查看}" Command="{Binding ReviewInterruptedCommand}" />
            <Button Grid.Column="3" Classes="quiet" Content="{loc:Tr 知道了}" Command="{Binding DismissInterruptedNoticeCommand}" />
          </Grid>
        </Border>
        <home:StartComposer Margin="{DynamicResource D4Margin_0_32_0_0}" />
        <home:ContinueSeries Margin="{DynamicResource D4Margin_0_48_0_0}" />
        <home:HomeScreenshotCard Margin="{DynamicResource D4Margin_0_24_0_0}" />
        <home:RecentMeetings Margin="{DynamicResource D4Margin_0_40_0_0}" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
