<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:NextThought.Desktop"
             xmlns:controls="using:NextThought.Desktop.Views.Controls"
             x:Class="NextThought.Desktop.Views.HomeView"
             x:DataType="local:AppState">
  <Grid>
    <controls:InkWash Mode="{Binding SelectedMode}" Height="240" VerticalAlignment="Top" />
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="{DynamicResource D4Margin_40_26_40_36}" MaxWidth="720" HorizontalAlignment="Center" Spacing="{DynamicResource D4Spacing_26}">
      <!-- Greeting -->
      <StackPanel Spacing="{DynamicResource D4Spacing_10}">
        <TextBlock Text="{Binding Greeting}" Classes="overline" />
        <TextBlock Text="把讨论留下来" Classes="hero" />
        <TextBlock Text="开会、听讲、面谈。NextThought 在本机把声音变成文字，再变成可以带走的结论。"
                   Classes="body" Foreground="{DynamicResource Secondary}" MaxWidth="620" />
      </StackPanel>

      <!-- Next meeting -->
      <Border Classes="card" Padding="{DynamicResource D4Padding_24}">
        <StackPanel Spacing="{DynamicResource D4Spacing_16}">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
            <controls:SceneGlyph Mode="{Binding SelectedMode}" Size="44" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding MeetingTitle}" Background="Transparent" BorderThickness="0"
                     Padding="{DynamicResource D4Padding_0}" FontFamily="{StaticResource SerifFamily}" FontSize="24"
                     FontWeight="Medium" MinHeight="36" VerticalAlignment="Center"
                     Watermark="给这场会起个名字，比如“字节二面”" />
          </Grid>
          <ItemsControl ItemsSource="{Binding Scenes}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:SceneChoice">
                <Button Classes="scene" Tag="{Binding}" Click="Scene_Click"
                        Margin="{DynamicResource D4Margin_0_0_4_4}" ToolTip.Tip="{Binding Promise}">
                  <TextBlock Text="{Binding Title}" FontSize="13" />
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding SelectedScene.Promise}" Classes="section" />
          <ItemsControl ItemsSource="{Binding SelectedScene.Moments}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource D4Spacing_6}" Margin="{DynamicResource D4Margin_0_2_0_0}">
                  <TextBlock Text="•" Classes="caption" Foreground="{DynamicResource Secondary}" />
                  <TextBlock Text="{Binding}" Classes="caption" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBlock Text="⌘⇧N 不挑场合，立即记录" Classes="caption" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="先准备资料" Command="{Binding NavigateCommand}" CommandParameter="Live" />
            <Button Grid.Column="2" Classes="primary" Content="开始" Command="{Binding StartRecordingCommand}" />
          </Grid>
        </StackPanel>
      </Border>
      <TextBlock Text="{Binding AudioSourceText}" Classes="caption" />

      <!-- Capability cards -->
      <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14">
        <Border Grid.Column="0" Classes="card">
          <StackPanel Spacing="{DynamicResource D4Spacing_8}">
            <TextBlock Text="本机语音识别" Classes="overline" />
            <TextBlock Text="X-ASR 流式识别加整句精修，CPU 离线运行；原始音频只在内存中经过。"
                       Classes="caption" MaxWidth="240" />
            <Button Classes="quiet" Content="准备语音组件" HorizontalAlignment="Left" Margin="{DynamicResource D4Margin_m10_0_0_0}"
                    Command="{Binding PrepareModelsCommand}" />
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Classes="card">
          <StackPanel Spacing="{DynamicResource D4Spacing_8}">
            <TextBlock Text="回答服务" Classes="overline" />
            <TextBlock Text="{Binding Settings.KeyStatus}" Classes="caption" MaxWidth="240" />
            <Button Classes="quiet" Content="打开设置" HorizontalAlignment="Left" Margin="{DynamicResource D4Margin_m10_0_0_0}"
                    Command="{Binding NavigateCommand}" CommandParameter="Settings" />
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Classes="card">
          <StackPanel Spacing="{DynamicResource D4Spacing_8}">
            <TextBlock Text="资料库" Classes="overline" />
            <TextBlock Text="{Binding Library.MaterialCountText}" Classes="caption" MaxWidth="240" />
            <Button Classes="quiet" Content="导入资料" HorizontalAlignment="Left" Margin="{DynamicResource D4Margin_m10_0_0_0}"
                    Command="{Binding NavigateCommand}" CommandParameter="Library" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- Recent meetings -->
      <StackPanel Spacing="{DynamicResource D4Spacing_12}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="最近会议" Classes="section" />
          <Button Grid.Column="1" Classes="quiet" Content="全部会议" VerticalAlignment="Center"
                  Command="{Binding NavigateCommand}" CommandParameter="Live" />
        </Grid>
        <ItemsControl ItemsSource="{Binding HomeRecent}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="local:RecentMeetingRow">
              <Button Classes="recent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                      Tag="{Binding}" Click="Recent_Click" Margin="{DynamicResource D4Margin_0_0_0_6}">
                <Grid ColumnDefinitions="*,Auto" Margin="{DynamicResource D4Margin_4_2}">
                  <StackPanel Spacing="{DynamicResource D4Spacing_4}">
                    <TextBlock Text="{Binding Title}" Classes="title" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    <TextBlock Text="{Binding Subtitle}" Classes="caption" FontSize="11" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                             FontSize="12" Foreground="{DynamicResource Tertiary}" VerticalAlignment="Center" />
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="还没有会议记录。点击「开始记录」写下第一场。" Classes="caption"
                   IsVisible="{Binding IsHistoryEmpty}" />
      </StackPanel>
    </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
