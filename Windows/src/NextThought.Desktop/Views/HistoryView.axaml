<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:NextThought.Desktop"
             xmlns:platform="using:NextThought.Platform"
             xmlns:core="using:NextThought.Core"
             x:Class="NextThought.Desktop.Views.HistoryView"
             x:DataType="local:AppState">
  <UserControl.Resources>
    <DataTemplate x:Key="HistoryRowTemplate" x:DataType="local:RecentMeetingRow">
            <Button Classes="recent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    Tag="{Binding}" Click="Row_Click" Margin="{DynamicResource D4Margin_0_0_0_6}">
              <Button.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="打开纪要" Tag="{Binding}" Command="{Binding $parent[UserControl].DataContext.OpenSessionCommand}" CommandParameter="{Binding}" />
                  <MenuItem Header="导出 Markdown" Tag="{Binding}" Command="{Binding $parent[UserControl].DataContext.ExportSessionCommand}" CommandParameter="{Binding}" />
                  <MenuItem Header="重命名会议" Tag="{Binding}" Tapped="RenameSession_Tapped" />
                  <MenuItem Header="删除会议" Tag="{Binding}" Command="{Binding $parent[UserControl].DataContext.DeleteSessionCommand}" CommandParameter="{Binding}" />
                </ContextMenu>
              </Button.ContextMenu>
              <Grid ColumnDefinitions="Auto,*,Auto" Margin="{DynamicResource D4Margin_6_4}">
                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="{DynamicResource D4CornerRadius_10}" Background="{DynamicResource Sunken}"
                        VerticalAlignment="Center" Margin="{DynamicResource D4Margin_0_0_14_0}">
                  <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                             Foreground="{DynamicResource Secondary}" HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="{DynamicResource D4Spacing_4}" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Title}" Classes="title" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                  <TextBlock Text="{Binding Subtitle}" Classes="caption" FontSize="11" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="{DynamicResource D4Spacing_6}" Orientation="Horizontal" VerticalAlignment="Center">
                  <Border Classes="chip" IsVisible="{Binding HasSummary}">
                    <TextBlock Text="有纪要" Classes="overline" FontSize="10" />
                  </Border>
                  <TextBlock Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                             Foreground="{DynamicResource Tertiary}" VerticalAlignment="Center" Margin="{DynamicResource D4Margin_6_0_0_0}" />
                </StackPanel>
              </Grid>
            </Button>
              </DataTemplate>
  </UserControl.Resources>

  <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" Margin="{DynamicResource D4Margin_32_18_32_0}">
    <StackPanel Grid.Row="0" Spacing="{DynamicResource D4Spacing_6}">
      <TextBlock Text="历史" Classes="display" />
      <TextBlock Text="每一场会议都存在本机。搜索标题、日期或模式，看不清的细节可以回到原话。"
                 Classes="caption" />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="{DynamicResource D4Margin_0_18_0_12}">
      <TextBox Text="{Binding HistoryQuery}" PlaceholderText="搜索会议标题、日期或模式" MaxWidth="420"
               HorizontalAlignment="Left" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource D4Spacing_6}" VerticalAlignment="Center">
        <RadioButton Classes="chip" GroupName="history" IsChecked="{Binding HistoryFilterIsAll, Mode=OneWay}"
                     Command="{Binding SetHistoryFilterCommand}" CommandParameter="全部">
          <TextBlock Text="全部" Foreground="{Binding $parent[RadioButton].Foreground}" />
        </RadioButton>
        <RadioButton Classes="chip" GroupName="history" IsChecked="{Binding HistoryFilterHasSummary, Mode=OneWay}"
                     Command="{Binding SetHistoryFilterCommand}" CommandParameter="有纪要">
          <TextBlock Text="有纪要" Foreground="{Binding $parent[RadioButton].Foreground}" />
        </RadioButton>
        <RadioButton Classes="chip" GroupName="history" IsChecked="{Binding HistoryFilterUnfiled, Mode=OneWay}"
                     Command="{Binding SetHistoryFilterCommand}" CommandParameter="未整理">
          <TextBlock Text="未整理" Foreground="{Binding $parent[RadioButton].Foreground}" />
        </RadioButton>
        <TextBlock Text="{Binding HistorySummary}" Classes="caption" VerticalAlignment="Center" Margin="{DynamicResource D4Margin_8_0_0_0}" />
        <Button Classes="quiet" Content="全文搜索" Command="{Binding SearchHistoryContentCommand}" VerticalAlignment="Center" />
        <Button Classes="quiet" Content="删除筛选结果" Command="{Binding DeleteFilteredSessionsCommand}" VerticalAlignment="Center" />
      </StackPanel>
    </Grid>

    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="{DynamicResource D4Spacing_8}" Margin="{DynamicResource D4Margin_0_0_0_12}">
      <ComboBox ItemsSource="{Binding HistoryDateChoices}" SelectedItem="{Binding HistoryDateFilter}" Width="140" />
      <ComboBox ItemsSource="{Binding HistoryLengthChoices}" SelectedItem="{Binding HistoryLengthFilter}" Width="140" />
      <ComboBox ItemsSource="{Binding HistorySortChoices}" SelectedItem="{Binding HistorySort}" Width="140" />
    </StackPanel>

    <Border Grid.Row="3" Classes="card" Margin="{DynamicResource D4Margin_0_0_0_10}"
            IsVisible="{Binding HasSelectedHistory}">
      <StackPanel Spacing="{DynamicResource D4Spacing_6}">
        <TextBlock Text="归档概览" Classes="overline" />
        <TextBlock Text="{Binding CurrentSession.Title}" Classes="section" />
        <TextBlock Text="{Binding CurrentSession.LocalStartedAt}" Classes="caption" />
        <TextBlock Text="{Binding CurrentSession.AnswerCount}" Classes="caption" />
        <TextBlock Text="{Binding SelectedSessionScreenshotCount}" Classes="caption" />
        <TextBlock Text="回答列表" Classes="overline" />
        <ItemsControl ItemsSource="{Binding SelectedSessionAnswers}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="core:AnswerRecord">
              <StackPanel Spacing="{DynamicResource D4Spacing_2}" Margin="{DynamicResource D4Margin_0_0_0_6}">
                <TextBlock Text="{Binding Question}" Classes="label" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Answer}" Classes="caption" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <Border Grid.Row="4" Classes="card" Margin="{DynamicResource D4Margin_0_0_0_10}"
              IsVisible="{Binding HistoryContentHits.Count}">
        <StackPanel Spacing="{DynamicResource D4Spacing_4}">
          <TextBlock Text="全文命中" Classes="overline" />
          <ItemsControl ItemsSource="{Binding HistoryContentHits}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="platform:SessionContentHit">
                <Button Classes="quiet" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Tag="{Binding}" Click="SearchHit_Click">
                  <StackPanel Spacing="{DynamicResource D4Spacing_2}">
                    <TextBlock Text="{Binding Meta.Title}" Classes="label" />
                    <TextBlock Text="{Binding Text}" Classes="caption" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto" Margin="{DynamicResource D4Margin_0_0_0_16}">
      <StackPanel>
        <ItemsControl ItemsSource="{Binding HistoryGroups}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="local:HistoryGroupRow">
              <StackPanel Spacing="{DynamicResource D4Spacing_6}" Margin="{DynamicResource D4Margin_0_0_0_10}">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding Name}" Classes="overline" />
                  <Button Grid.Column="1" Classes="quiet" Content="&#xE712;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                          ToolTip.Tip="系列管理">
                    <Button.Flyout>
                      <MenuFlyout>
                        <MenuItem Header="打开系列" Command="{Binding $parent[UserControl].DataContext.OpenSeriesCommand}" CommandParameter="{Binding SeriesId}" />
                      </MenuFlyout>
                    </Button.Flyout>
                  </Button>
                </Grid>
                <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource HistoryRowTemplate}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="没有匹配的会议。换个关键词，或把筛选切回「全部」。"
                   Classes="caption" IsVisible="{Binding IsHistoryViewEmpty}" Margin="{DynamicResource D4Margin_4_12_0_0}" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
