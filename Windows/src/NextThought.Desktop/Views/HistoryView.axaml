<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:NextThought.Desktop.Localization"
             xmlns:local="using:NextThought.Desktop"
             xmlns:core="using:NextThought.Core"
             xmlns:c="using:NextThought.Desktop.Controls"
             xmlns:controls="using:NextThought.Desktop.Views.Controls"
             x:Class="NextThought.Desktop.Views.HistoryView"
             x:DataType="local:AppState">
  <UserControl.Resources>
    <!-- HistoryView.swift SessionRow: scene dot, title, summary icon + time on the right, details caption. -->
    <DataTemplate x:Key="HistoryRowTemplate" x:DataType="local:RecentMeetingRow">
      <StackPanel>
      <Button Classes="recent" Classes.selected="{Binding IsSelected}"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
              Tag="{Binding}" Click="Row_Click" Padding="{DynamicResource D4Padding_8_6}">
        <Button.ContextMenu>
          <ContextMenu Opening="RowMenu_Opening">
            <MenuItem Header="{loc:Tr 打开纪要}" Tag="{Binding}" Click="OpenSession_Tapped" />
            <MenuItem Header="{loc:Tr 重新整理}" Tag="{Binding}" Click="Regenerate_Tapped" />
            <MenuItem Header="{loc:Tr 纪要语言}">
              <MenuItem Header="{loc:Tr 简体中文}" Tag="{Binding}" Click="RegenerateChinese_Tapped" />
              <MenuItem Header="{loc:Tr English}" Tag="{Binding}" Click="RegenerateEnglish_Tapped" />
            </MenuItem>
            <Separator />
            <MenuItem Header="{loc:Tr 导出 Markdown…}" Tag="{Binding}" Click="ExportSession_Tapped" />
            <MenuItem Header="{loc:Tr 重命名…}" Tag="{Binding}" Click="RenameSession_Tapped" />
            <MenuItem Header="{loc:Tr 在资源管理器中显示}" Tag="{Binding}" Click="RevealSession_Tapped" />
            <MenuItem Header="{loc:Tr 详细信息}" Tag="{Binding}" Click="SessionInfo_Tapped" />
            <MenuItem Header="{loc:Tr 以此为上一场，准备下一场}" Tag="{Binding}" Click="PrepareNext_Tapped" />
            <Separator />
            <MenuItem Header="{loc:Tr 删除这场会议}" Tag="{Binding}" Click="DeleteSession_Tapped" />
          </ContextMenu>
        </Button.ContextMenu>
        <c:InteractiveRowBody Padding="{DynamicResource D4Padding_0}">
          <StackPanel Spacing="{DynamicResource D4Spacing_2}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource D4Spacing_8}">
              <Border Grid.Column="0" Width="7" Height="7" CornerRadius="{DynamicResource D4CornerRadius_4}"
                      Background="{Binding ModeTintBrush}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding Title}" Classes="label"
                         FontWeight="Medium" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                         VerticalAlignment="Center" />
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{DynamicResource D4Spacing_6}"
                          VerticalAlignment="Center">
                <TextBlock Text="{StaticResource IconSparkle}" FontFamily="{StaticResource IconFont}" FontSize="11"
                           Foreground="{DynamicResource Ai}" IsVisible="{Binding HasReadySummary}"
                           ToolTip.Tip="{loc:Tr 纪要已整理好}" VerticalAlignment="Center" />
                <TextBlock Text="{StaticResource IconExclamationmarkCircle}" FontFamily="{StaticResource IconFont}"
                           FontSize="11" Foreground="{DynamicResource Caution}" IsVisible="{Binding HasPendingSummary}"
                           ToolTip.Tip="{loc:Tr 纪要整理已中断 · 可以重试}" VerticalAlignment="Center" />
                <TextBlock Text="{StaticResource IconExclamationmarkCircle}" FontFamily="{StaticResource IconFont}"
                           FontSize="11" Foreground="{DynamicResource Caution}" IsVisible="{Binding HasFailedSummary}"
                           ToolTip.Tip="{Binding Meta.SummaryError}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding TimeText}" Classes="caption" FontSize="11" TextWrapping="NoWrap" />
              </StackPanel>
            </Grid>
            <!-- E1: English details are longer than the 215pt row text width; wrap instead of clipping. -->
            <TextBlock Text="{Binding Details}" Classes="caption" FontSize="11"
                       Margin="{DynamicResource D4Margin_15_0_0_0}" TextWrapping="Wrap" MaxLines="2"
                       TextTrimming="CharacterEllipsis" />
            <StackPanel Spacing="{DynamicResource D4Spacing_0}" IsVisible="{Binding HasSearchHit}"
                        Margin="{DynamicResource D4Margin_15_0_0_0}">
              <TextBlock Text="{Binding SearchHitLine}" Classes="overline" FontSize="10" />
              <TextBlock Text="{Binding SearchHitExcerpt}" Classes="caption" FontSize="11"
                         TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            </StackPanel>
          </StackPanel>
        </c:InteractiveRowBody>
      </Button>
      <!-- §6.7 E1 SessionRow: 0.5px Ink.hairline after every row (HistoryView.sessionList). -->
      <Border Height="0.5" Background="{DynamicResource Hairline}" Margin="{DynamicResource D4Margin_12_0_12_0}" />
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <!-- HistoryView.body: a 270pt session list beside the archive overview (wide window layout). -->
  <Grid ColumnDefinitions="270,0.5,*" Margin="{DynamicResource D4Margin_16_12_24_0}">
    <!-- Left pane: sessionList -->
    <StackPanel Grid.Column="0" Spacing="{DynamicResource D4Spacing_10}" Margin="{DynamicResource D4Margin_0_0_8_0}">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="{DynamicResource D4Spacing_2}">
          <TextBlock Text="{Binding HistoryScopeTitle}" Classes="section" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
          <TextBlock Text="{Binding HistoryScopeSubtitle}" Classes="caption" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
        <Button Grid.Column="1" Classes="quiet" Content="{StaticResource IconEllipsis}"
                FontFamily="{StaticResource IconFont}" ToolTip.Tip="{loc:Tr 会议记录操作}" VerticalAlignment="Top">
          <Button.Flyout>
            <MenuFlyout>
              <MenuItem Header="{loc:Tr 删除全部会议记录}" Click="DeleteAll_Tapped" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </Grid>

      <!-- filterBar: search above the three core filter controls. -->
      <StackPanel Spacing="{DynamicResource D4Spacing_6}">
        <TextBox Text="{Binding HistoryQuery}" PlaceholderText="{loc:Tr 搜索全部转写、纪要、笔记}"
                 HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="{DynamicResource D4Spacing_4}">
          <c:MenuPicker Grid.Column="0" ItemsSource="{Binding HistoryDateChoices}"
                        SelectedItem="{Binding HistoryDateFilter}" HorizontalAlignment="Stretch" FontSize="12" />
          <c:MenuPicker Grid.Column="1" ItemsSource="{Binding HistoryLengthChoices}"
                        SelectedItem="{Binding HistoryLengthFilter}" HorizontalAlignment="Stretch" FontSize="12" />
          <c:MenuPicker Grid.Column="2" ItemsSource="{Binding HistorySortChoices}"
                        SelectedItem="{Binding HistorySort}" HorizontalAlignment="Stretch" FontSize="12" />
        </Grid>
        <TextBlock Text="{Binding HistorySummary}" Classes="caption" FontSize="11"
                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding HistoryContentSearchProgress}" Classes="caption" FontSize="11"
                   Foreground="{DynamicResource Secondary}" IsVisible="{Binding IsContentSearchingHistory}" TextWrapping="Wrap" />
        <Border Classes="card" Padding="{DynamicResource D4Padding_8}" IsVisible="{Binding HasHistoryReadIssues}"
               >
          <TextBlock Text="{Binding HistoryReadIssueText}" Classes="caption" FontSize="11"
                     Foreground="{DynamicResource Caution}" TextWrapping="Wrap" />
        </Border>
        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource D4Spacing_6}">
          <ProgressBar IsIndeterminate="True" Width="70" IsVisible="{Binding IsSearchingHistory}" />
          <TextBlock Text="{Binding HistorySearchStatus}" Classes="caption" FontSize="11" VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>

      <!-- searchHitNavigator -->
      <Border Classes="card" Padding="{DynamicResource D4Padding_8}" IsVisible="{Binding HasHistoryHits}">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="{DynamicResource D4Spacing_4}">
          <TextBlock Grid.Column="0" Text="{Binding HistoryHitPosition}" Classes="caption" FontSize="11" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding HistoryHitLine}" Classes="overline" FontSize="10"
                     TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          <Button Grid.Column="2" Classes="quiet" Content="{StaticResource IconChevronUp}" FontFamily="{StaticResource IconFont}"
                  ToolTip.Tip="{loc:Tr 上一个搜索命中}" Command="{Binding PreviousHistoryHitCommand}" Padding="{DynamicResource D4Padding_4}" />
          <Button Grid.Column="3" Classes="quiet" Content="{StaticResource IconChevronDown}" FontFamily="{StaticResource IconFont}"
                  ToolTip.Tip="{loc:Tr 下一个搜索命中}" Command="{Binding NextHistoryHitCommand}" Padding="{DynamicResource D4Padding_4}" />
        </Grid>
      </Border>

      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <ItemsControl ItemsSource="{Binding HistoryGroups}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:HistoryGroupRow">
                <StackPanel Spacing="{DynamicResource D4Spacing_4}" Margin="{DynamicResource D4Margin_0_0_0_10}">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource D4Spacing_6}">
                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=OneWay}" Tag="{Binding SeriesId}"
                              IsVisible="{Binding $parent[UserControl].DataContext.SelectingHistorySeries}"
                              VerticalAlignment="Center" Click="SeriesCheckBox_Click" />
                    <Button Grid.Column="1" Classes="quiet" HorizontalContentAlignment="Left"
                            Content="{Binding Name}" Tag="{Binding SeriesId}" Click="OpenHistorySeries_Tapped"
                            FontWeight="SemiBold" FontSize="12" Padding="{DynamicResource D4Padding_2}" />
                    <!-- seriesGroupHeader: name + meeting count (the mode/counts card lives on the right overview). -->
                    <TextBlock Grid.Column="2" Text="{Binding Rows.Count}" Classes="overline" FontSize="10"
                               Foreground="{DynamicResource Tertiary}" VerticalAlignment="Center" />
                  </Grid>
                  <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource HistoryRowTemplate}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <!-- HistoryView.sessionList empty states -->
          <StackPanel Spacing="{DynamicResource D4Spacing_6}" IsVisible="{Binding HistoryIsEmptyAndNotSearching}"
                      Margin="{DynamicResource D4Margin_4_24_0_0}">
            <TextBlock Text="{loc:Tr 还没有会议}" Classes="section" HorizontalAlignment="Center" />
            <TextBlock Text="{loc:Tr 开过的会议会保存在这里；结束时自动整理纪要。}" Classes="caption"
                       TextWrapping="Wrap" HorizontalAlignment="Center" />
          </StackPanel>
          <StackPanel Spacing="{DynamicResource D4Spacing_6}" IsVisible="{Binding HistoryScopeHasNoSessions}"
                      Margin="{DynamicResource D4Margin_4_24_0_0}">
            <TextBlock Text="{loc:Tr 这个系列还没有会议}" Classes="section" HorizontalAlignment="Center" />
            <TextBlock Text="{loc:Tr 开始一场会议后，它会出现在这个系列里。}" Classes="caption"
                       TextWrapping="Wrap" HorizontalAlignment="Center" />
            <Button Classes="quiet" Content="{loc:Tr 返回所有记录}" HorizontalAlignment="Center"
                    Command="{Binding ShowAllHistoryCommand}" FontSize="12" />
          </StackPanel>
          <StackPanel Spacing="{DynamicResource D4Spacing_6}" IsVisible="{Binding HistoryShowsNoMatch}"
                      Margin="{DynamicResource D4Margin_4_24_0_0}">
            <TextBlock Text="{loc:Tr 没有符合条件的记录}" Classes="section" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding HistoryNoMatchDetail}" Classes="caption" TextWrapping="Wrap"
                       HorizontalAlignment="Center" />
            <Button Classes="quiet" Content="{loc:Tr 清除搜索与筛选}" HorizontalAlignment="Center"
                    Command="{Binding ClearHistoryFiltersCommand}" FontSize="12"
                    IsVisible="{Binding HistoryHasNarrowingFilter}" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </StackPanel>

    <Border Grid.Column="1" Background="{DynamicResource Hairline}" Width="0.5" />

    <!-- Right pane: MeetingArchiveOverview -->
    <Grid Grid.Column="2" RowDefinitions="Auto,*">
      <Border Grid.Row="0" Height="52" BorderBrush="{DynamicResource Hairline}" BorderThickness="0,0,0,0.5"
              Padding="{DynamicResource D4Padding_24_0}">
        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource D4Spacing_6}" VerticalAlignment="Center">
          <Button Classes="quiet" Content="{loc:Tr 所有记录}" Command="{Binding ShowAllHistoryCommand}"
                  IsVisible="{Binding IsHistoryScoped}" FontSize="12" Padding="{DynamicResource D4Padding_4_2}" />
          <TextBlock Text="{StaticResource IconChevronRight}" FontFamily="{StaticResource IconFont}" FontSize="9"
                     Foreground="{DynamicResource Tertiary}" VerticalAlignment="Center"
                     IsVisible="{Binding IsHistoryScoped}" />
          <TextBlock Text="{Binding HistoryScopeTitle}" Classes="caption" VerticalAlignment="Center"
                     IsVisible="{Binding IsHistoryScoped}" TextTrimming="CharacterEllipsis" MaxWidth="420" />
          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource D4Spacing_6}" IsVisible="{Binding !IsHistoryScoped}">
            <Button Classes="quiet" Content="{loc:Tr 所有记录}" Command="{Binding BackToHistoryOverviewCommand}"
                    IsVisible="{Binding HasSelectedHistory}" FontSize="12" Padding="{DynamicResource D4Padding_4_2}" />
            <TextBlock Text="{StaticResource IconChevronRight}" FontFamily="{StaticResource IconFont}" FontSize="9"
                       Foreground="{DynamicResource Tertiary}" VerticalAlignment="Center"
                       IsVisible="{Binding HasSelectedHistory}" />
            <TextBlock Text="{Binding CurrentSessionTitle}" Classes="caption" VerticalAlignment="Center"
                       IsVisible="{Binding HasSelectedHistory}" TextTrimming="CharacterEllipsis" MaxWidth="420" />
          </StackPanel>

        </StackPanel>
      </Border>

      <!-- §3.4: Mac history embeds the meeting page in the right pane; the archive overview only
           shows when nothing is selected. -->
      <Grid Grid.Row="1">
        <ContentControl x:Name="HistoryMeetingHost" />
        <ScrollViewer IsVisible="{Binding !HasSelectedHistory}" VerticalScrollBarVisibility="Auto">
        <Border MaxWidth="720" HorizontalAlignment="Left" ClipToBounds="True">
        <StackPanel Spacing="{DynamicResource D4Spacing_16}" Margin="{DynamicResource D4Margin_32_24_32_24}">
          <StackPanel Spacing="{DynamicResource D4Spacing_2}">
            <TextBlock Text="{Binding HistoryOverviewTitle}" Classes="display" TextWrapping="Wrap" MinWidth="120" HorizontalAlignment="Left" />
            <TextBlock Text="{Binding HistoryOverviewSubtitle}" Classes="caption" TextWrapping="Wrap" />
            <TextBlock Text="{Binding HistoryOverviewStats}" Classes="caption" FontSize="12"
                       Foreground="{DynamicResource Secondary}" FontWeight="Medium" />
          </StackPanel>

          <!-- Archive overview for the selected meeting (MeetingArchiveOverview compact card). -->
          <Border Classes="card" IsVisible="{Binding HasSelectedHistory}">
            <StackPanel Spacing="{DynamicResource D4Spacing_6}">
              <TextBlock Text="{loc:Tr 归档概览}" Classes="overline" />
              <TextBlock Text="{Binding CurrentSessionTitle}" Classes="section" />
              <TextBlock Text="{Binding SelectedSessionFacts}" Classes="caption" TextWrapping="Wrap" />
              <TextBlock Text="{Binding CurrentSession.SummaryError}" Classes="caption"
                         Foreground="{DynamicResource Caution}" IsVisible="{Binding HasSummaryError}" TextWrapping="Wrap" />
              <TextBlock Text="{loc:Tr 归档截图}" Classes="overline" Margin="{DynamicResource D4Margin_0_10_0_0}" />
              <TextBlock Text="{loc:Tr 还没有归档截图。}" Classes="caption" FontSize="11"
                         IsVisible="{Binding !HasSelectedSessionScreenshots}" />
              <ItemsControl ItemsSource="{Binding SelectedSessionScreenshots}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Classes="quiet" Padding="{DynamicResource D4Padding_0}" ToolTip.Tip="{loc:Tr 点击查看原图}"
                            Click="Screenshot_Click" Margin="{DynamicResource D4Margin_0_0_6_6}">
                      <Image Source="{Binding}" Width="120" Height="76" Stretch="UniformToFill" />
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{loc:Tr 回答列表}" Classes="overline" Margin="{DynamicResource D4Margin_0_10_0_0}" />
              <TextBlock Text="{loc:Tr 这场会议没有生成回答。}" Classes="caption" FontSize="11"
                         IsVisible="{Binding !HasSelectedSessionAnswers}" />
              <ItemsControl ItemsSource="{Binding HistoryAnswers}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:HistoryAnswerRow">
                    <StackPanel Spacing="{DynamicResource D4Spacing_2}" Margin="{DynamicResource D4Margin_0_0_0_8}">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding Question}" Classes="label" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="1" Text="{Binding AutomaticLabel}" Classes="overline" FontSize="10"
                                   VerticalAlignment="Top" Margin="{DynamicResource D4Margin_8_0_0_0}" />
                      </Grid>
                      <TextBlock Text="{loc:Tr 未完成的回答片段}" Classes="overline" FontSize="10"
                                 Foreground="{DynamicResource Caution}" IsVisible="{Binding !IsComplete}" />
                      <TextBlock Text="{Binding AnswerText}" Classes="caption" TextWrapping="Wrap" MaxLines="4"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding MetaLine}" Classes="caption" FontSize="10"
                                 Foreground="{DynamicResource Tertiary}" />
                      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource D4Spacing_6}"
                                  IsVisible="{Binding HasScreenshot}">
                        <TextBlock Text="{loc:Tr 截图已归档}" Classes="caption" FontSize="10"
                                   Foreground="{DynamicResource Tertiary}" VerticalAlignment="Center" />
                        <Button Classes="quiet" Content="{loc:Tr 查看截图}" Tag="{Binding}" Click="AnswerScreenshot_Click" />
                      </StackPanel>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- 会议系列 section with the series batch controls. -->
          <StackPanel Spacing="{DynamicResource D4Spacing_8}" IsVisible="{Binding !HasSelectedHistory}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <TextBlock Grid.Column="0" Text="{loc:Tr 会议系列}" Classes="section" VerticalAlignment="Center" />
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{DynamicResource D4Spacing_8}">
                <Button Classes="quiet" Content="{loc:Tr 返回首页}" FontSize="12" Command="{Binding NavigateCommand}" CommandParameter="Home" />
                <Button Classes="quiet" Content="{loc:Tr 清除搜索与筛选}" FontSize="12"
                        Command="{Binding ClearHistoryFiltersCommand}" IsVisible="{Binding HistoryHasNarrowingFilter}" />
                <Button Classes="quiet" Content="{loc:Tr 重试读取}" FontSize="12" Command="{Binding RetryHistoryReadCommand}" />
                <c:ControlButtonBody Emphasis="Secondary" Content="{loc:Tr 批量删除}"
                                     Command="{Binding BeginHistorySeriesSelectionCommand}"
                                     IsVisible="{Binding !SelectingHistorySeries}"
                                     ToolTip.Tip="{loc:Tr 选择多个系列后删除}" ButtonHeight="28" FontSize="12" />
                <TextBlock Text="{Binding HistorySelectionText}" Classes="caption" VerticalAlignment="Center"
                           IsVisible="{Binding SelectingHistorySeries}" />
                <c:ControlButtonBody Emphasis="Quiet" Content="{loc:Tr 全选当前结果}"
                                     Command="{Binding SelectAllHistorySeriesCommand}"
                                     IsVisible="{Binding SelectingHistorySeries}" ButtonHeight="28" FontSize="12" />
                <c:ControlButtonBody Emphasis="Quiet" Content="{loc:Tr 删除所选}"
                                     Command="{Binding DeleteSelectedSeriesCommand}"
                                     IsVisible="{Binding SelectingHistorySeries}" ButtonHeight="28" FontSize="12" />
                <c:ControlButtonBody Emphasis="Quiet" Content="{loc:Tr 完成}"
                                     Command="{Binding ExitHistorySeriesSelectionCommand}"
                                     IsVisible="{Binding SelectingHistorySeries}" ButtonHeight="28" FontSize="12" />
              </StackPanel>
            </Grid>
            <ItemsControl ItemsSource="{Binding HistoryGroups}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:HistoryGroupRow">
                  <!-- MeetingArchiveOverview folder card: scene glyph, name, mode/counts line, manage menu. -->
                  <Border Classes="card" Width="300" Margin="{DynamicResource D4Margin_0_0_10_10}">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource D4Spacing_10}">
                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=OneWay}" Tag="{Binding SeriesId}"
                              IsVisible="{Binding $parent[UserControl].DataContext.SelectingHistorySeries}"
                              VerticalAlignment="Center" Click="SeriesCheckBox_Click" />
                    <controls:SceneGlyph Grid.Column="1" Mode="{Binding Mode}" Size="28" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="{DynamicResource D4Spacing_2}" Margin="{DynamicResource D4Margin_44_0_0_0}"
                                VerticalAlignment="Center">
                      <Button Classes="quiet" HorizontalContentAlignment="Left" Content="{Binding Name}"
                              Tag="{Binding SeriesId}" Click="OpenHistorySeries_Tapped"
                              FontWeight="Medium" FontSize="13" Padding="{DynamicResource D4Padding_0}" />
                      <TextBlock Text="{Binding ModeTitle}" Classes="caption" FontSize="11"
                                 Foreground="{DynamicResource Secondary}" />
                      <TextBlock Text="{Binding CountsText}" Classes="overline" FontSize="10"
                                 Foreground="{DynamicResource Tertiary}" />
                    </StackPanel>
                    <Button Grid.Column="2" Classes="quiet" Content="{StaticResource IconEllipsis}"
                            FontFamily="{StaticResource IconFont}" ToolTip.Tip="{loc:Tr 管理系列}"
                            IsVisible="{Binding CanManage}" Padding="{DynamicResource D4Padding_4}">
                      <Button.Flyout>
                        <MenuFlyout>
                          <MenuItem Header="{loc:Tr 打开系列}" Tag="{Binding SeriesId}" Click="OpenSeries_Tapped" />
                          <MenuItem Header="{loc:Tr 编辑系列信息}" Tag="{Binding SeriesId}" Click="EditSeriesInfo_Tapped" />
                          <MenuItem Header="{loc:Tr 删除系列…}" Tag="{Binding SeriesId}" Click="DeleteSeries_Tapped" />
                        </MenuFlyout>
                      </Button.Flyout>
                    </Button>
                  </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Spacing="{DynamicResource D4Spacing_6}" IsVisible="{Binding HistoryShowsNoMatch}">
              <TextBlock Text="{loc:Tr 没有符合条件的记录}" Classes="section" />
              <TextBlock Text="{Binding HistoryNoMatchDetail}" Classes="caption" TextWrapping="Wrap" />
              <Button Classes="quiet" Content="{loc:Tr 清除搜索与筛选}" HorizontalAlignment="Left"
                      Command="{Binding ClearHistoryFiltersCommand}" FontSize="12"
                      IsVisible="{Binding HistoryHasNarrowingFilter}" />
            </StackPanel>
            <TextBlock Text="{loc:Tr 开过的会议会保存在这里；结束时自动整理纪要。}" Classes="caption"
                       IsVisible="{Binding HistoryIsEmptyAndNotSearching}" TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>
        </Border>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
