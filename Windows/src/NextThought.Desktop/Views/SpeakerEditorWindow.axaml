<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:NextThought.Desktop.Localization"
        xmlns:local="using:NextThought.Desktop"
        x:Class="NextThought.Desktop.Views.SpeakerEditorWindow"
        x:DataType="local:AppState"
        Title="{loc:Tr 说话人}" Width="560" Height="560" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Paper}">
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="{DynamicResource D4Margin_18}">
    <!-- 标题与说明（Mac SpeakerStrip 上方的说明） -->
    <StackPanel Grid.Row="0" Spacing="{DynamicResource D4Spacing_4}">
      <TextBlock Text="{loc:Tr 说话人}" Classes="display" FontSize="24" />
      <TextBlock Text="{loc:Tr 命名后应用到当前转写；也可以把某一声道标成「这是我」。}"
                 Classes="caption" TextWrapping="Wrap" />
    </StackPanel>

    <!-- SpeakerStrip：一人一个胶囊，点按编辑（Mac SpeakerStrip） -->
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="{DynamicResource D4Margin_0_12_0_0}">
      <ItemsControl Grid.Column="0" ItemsSource="{Binding SpeakerPeople}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="local:SpeakerPersonRow">
            <Button Classes="quiet" Tag="{Binding}" Click="SelectPerson_Click"
                    ToolTip.Tip="{Binding Tooltip}" Margin="{DynamicResource D4Margin_0_0_6_6}" Padding="{DynamicResource D4Padding_10_4}">
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource D4Spacing_5}">
                <TextBlock Text="{Binding Mark}" FontSize="11" />
                <TextBlock Text="{Binding DisplayLabel}" Classes="label" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Grid.Column="1" Text="{loc:Tr 按声音区分}" Classes="caption" VerticalAlignment="Center"
                 IsVisible="{Binding SpeakerStripVisible}" />
    </Grid>

    <!-- MeEditor：这个声音被当成自己时，只能确认或取消（Mac MeEditor） -->
    <Border Grid.Row="2" Classes="card" Padding="{DynamicResource D4Padding_14_10}"
            IsVisible="{Binding SelectedSpeakerIsCurrentMe}" Margin="{DynamicResource D4Margin_0_0_0_8}">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource D4Spacing_8}">
        <StackPanel Grid.Column="0" Spacing="{DynamicResource D4Spacing_2}">
          <TextBlock Text="{loc:Tr 这个声音被当作你自己。认错了的话，可以取消。}" Classes="caption" TextWrapping="Wrap" />
          <TextBlock Text="{Binding SelectedSpeakerLines}" Classes="caption" FontSize="11" />
        </StackPanel>
        <Button Grid.Column="1" Content="{loc:Tr 不是我}" Command="{Binding ClearSelectedSpeakerMeCommand}" />
        <Button Grid.Column="2" Classes="primary" Content="{loc:Tr 好}" Click="Close_Click" />
      </Grid>
    </Border>

    <!-- SpeakerEditor：名字 + 这是我 + 并到别的人（Mac SpeakerEditor） -->
    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="{DynamicResource D4Spacing_10}" IsVisible="{Binding HasSelectedSpeaker}">
        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource D4Spacing_6}">
          <TextBlock Text="{Binding SelectedSpeaker.Mark}" FontSize="11" VerticalAlignment="Center" />
          <TextBlock Text="{Binding SelectedSpeakerLabel}" Classes="label" />
          <TextBlock Text="{Binding SelectedSpeakerLines}" Classes="caption" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Text="{loc:Tr 输入名字}" Classes="label" />
        <TextBox Text="{Binding SelectedSpeakerName}" PlaceholderText="{loc:Tr 输入名字}" />
        <CheckBox Content="{loc:Tr 这是我}" IsChecked="{Binding SelectedSpeakerIsMe}" />
        <StackPanel Spacing="{DynamicResource D4Spacing_4}">
          <TextBlock Text="{loc:Tr 其实是同一个人}" Classes="overline" />
          <ItemsControl ItemsSource="{Binding SpeakerMergeChoices}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:SpeakerPersonRow">
                <Button Tag="{Binding}" Click="MergeInto_Click" Margin="{DynamicResource D4Margin_0_0_6_6}">
                  <TextBlock Text="{Binding DisplayLabel}" Classes="caption" />
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <!-- 旧版「并入上一位」快捷操作保留在代码里，按钮文案避免新增未翻译 key。 -->
        <Button IsVisible="False" Click="MergePrevious_Click" />
        <TextBlock Text="{Binding SpeakerEditorStatus}" Classes="caption" Foreground="{DynamicResource Caution}"
                   TextWrapping="Wrap" />
        <Button Classes="quiet" Content="{loc:Tr 重试}" Command="{Binding RetrySpeakerSaveCommand}"
                IsVisible="{Binding HasSpeakerSaveError}" FontSize="11" HorizontalAlignment="Left" />
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"
                Spacing="{DynamicResource D4Spacing_8}" Margin="{DynamicResource D4Margin_0_10_0_0}">
      <Button Content="{loc:Tr 取消}" Click="Cancel_Click" />
      <Button Classes="primary" Content="{loc:Tr 完成}" Command="{Binding SaveSpeakerEditCommand}" Click="Close_Click" />
    </StackPanel>
  </Grid>
</Window>
