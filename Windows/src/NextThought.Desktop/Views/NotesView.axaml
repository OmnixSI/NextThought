<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:NextThought.Desktop"
             xmlns:core="using:NextThought.Core"
             xmlns:views="using:NextThought.Desktop.Views"
             x:Class="NextThought.Desktop.Views.NotesView"
             x:DataType="local:AppState">
  <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="32,18,32,0">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
      <StackPanel Spacing="6" MaxWidth="720" HorizontalAlignment="Left">
        <TextBlock Text="会后纪要" Classes="display" />
        <TextBlock Text="按这场会议的转写整理总结、决定、待办和未决问题；原始文字不会被改写。"
                   Classes="caption" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Content="导出 Markdown" Command="{Binding ExportCommand}" />
        <Button Content="导出 Word" Command="{Binding ExportDocxCommand}" />
        <Button Content="导出 PDF" Command="{Binding ExportPdfCommand}" />
        <Button Content="导出 SRT" Command="{Binding ExportSrtCommand}" />
        <Button Content="导出 VTT" Command="{Binding ExportVttCommand}" />
        <Button Classes="primary" Command="{Binding SummarizeCommand}" MinHeight="36" Padding="18,0">
          <TextBlock Text="整理这场会议" Foreground="{DynamicResource OnInk}" />
        </Button>
      </StackPanel>
    </Grid>

    <!-- 模板与校对：模板决定章节，校对只改名字与术语 -->
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,14,0,0">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <ComboBox ItemsSource="{Binding TemplateChoices}" SelectedItem="{Binding SelectedTemplate}" MinWidth="150"
                  ToolTip.Tip="纪要模板：章节由模板决定，模型只填内容" />
        <Button Content="按模板整理" Command="{Binding SummarizeWithTemplateCommand}" />
        <Button Content="校对转写" Command="{Binding ProofreadTranscriptCommand}"
                ToolTip.Tip="只更正名字与术语的识别错误，改动写入 corrections.json" />
        <TextBlock Text="{Binding ProofreadStatus}" Classes="caption" FontSize="11" VerticalAlignment="Center"
                   IsVisible="{Binding HasProofreadStatus}" />
      </StackPanel>
      <CheckBox Grid.Column="1" Content="结束后自动整理" IsChecked="{Binding Settings.AutoSummarize}" VerticalAlignment="Center" />
    </Grid>

    <!-- 纪要格式：文字纪要 / 因果鱼骨图 / 要点大纲 / 观点对照 -->
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <RadioButton Classes="chip" GroupName="notesformat"
                     IsChecked="{Binding NotesFormatIsStandard, Mode=OneWay}"
                     Command="{Binding SetNotesFormatCommand}" CommandParameter="{x:Static core:NotesFormat.Standard}">
          <TextBlock Text="文字纪要" Foreground="{Binding $parent[RadioButton].Foreground}" />
        </RadioButton>
        <RadioButton Classes="chip" GroupName="notesformat"
                     IsChecked="{Binding NotesFormatIsFishbone, Mode=OneWay}"
                     Command="{Binding SetNotesFormatCommand}" CommandParameter="{x:Static core:NotesFormat.Fishbone}">
          <TextBlock Text="鱼骨图" Foreground="{Binding $parent[RadioButton].Foreground}" />
        </RadioButton>
        <RadioButton Classes="chip" GroupName="notesformat"
                     IsChecked="{Binding NotesFormatIsOutline, Mode=OneWay}"
                     Command="{Binding SetNotesFormatCommand}" CommandParameter="{x:Static core:NotesFormat.Outline}">
          <TextBlock Text="要点大纲" Foreground="{Binding $parent[RadioButton].Foreground}" />
        </RadioButton>
        <RadioButton Classes="chip" GroupName="notesformat"
                     IsChecked="{Binding NotesFormatIsViewpoints, Mode=OneWay}"
                     Command="{Binding SetNotesFormatCommand}" CommandParameter="{x:Static core:NotesFormat.Viewpoints}">
          <TextBlock Text="观点对照" Foreground="{Binding $parent[RadioButton].Foreground}" />
        </RadioButton>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Content="生成这种纪要" Command="{Binding GenerateStructuredNotesCommand}"
                IsVisible="{Binding !NotesFormatIsStandard}" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="3" Classes="card" Padding="0" Margin="0,12,0,16">
      <Grid RowDefinitions="Auto,*">
        <Grid Margin="22,16,22,10" ColumnDefinitions="*,Auto">
          <StackPanel>
            <TextBlock Text="{Binding MeetingTitle}" Classes="title" FontSize="15" />
            <TextBlock Text="{Binding PageSubtitle}" Classes="caption" FontSize="11" Margin="0,3,0,0" />
            <TextBlock Text="{Binding StructuredHint}" Classes="caption" FontSize="11" Margin="0,4,0,0" />
          </StackPanel>
          <Border Grid.Column="1" Classes="chip" VerticalAlignment="Top">
            <TextBlock Text="Markdown" Classes="overline" FontSize="10" />
          </Border>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,0,22,22">
          <StackPanel Spacing="12">
            <!-- 文字纪要 -->
            <views:MarkdownText Text="{Binding SummaryText}" BaseFontSize="14"
                                IsVisible="{Binding NotesFormatIsStandard}" />
            <!-- 结构化纪要：鱼骨图画成骨图，观点对照画成矩阵，大纲以带时间的 Markdown 呈现 -->
            <StackPanel Spacing="10" IsVisible="{Binding !NotesFormatIsStandard}">
              <views:FishboneView Height="360" Notes="{Binding StructuredPayload.Fishbone}"
                                  IsVisible="{Binding HasFishboneDrawing}" />
              <views:ViewpointMatrixView Matrix="{Binding StructuredPayload.Viewpoints}"
                                         IsVisible="{Binding HasViewpointMatrix}" />
              <views:MarkdownText Text="{Binding StructuredMarkdown}" BaseFontSize="14"
                                  IsVisible="{Binding ShowStructuredMarkdown}" />
              <TextBlock Text="还没有生成这种纪要。点右上角「生成这种纪要」，会用当前回答服务把转写整理成它；每条都带原话时间。"
                         Classes="caption" IsVisible="{Binding !HasStructuredNotes}" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>
