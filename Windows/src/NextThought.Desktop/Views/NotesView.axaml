<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:NextThought.Desktop.Localization"
             xmlns:local="using:NextThought.Desktop"
             xmlns:core="using:NextThought.Core"
             xmlns:views="using:NextThought.Desktop.Views"
             x:Class="NextThought.Desktop.Views.NotesView"
             x:DataType="local:AppState">
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" Margin="{DynamicResource D4Margin_32_18_32_0}">
    <!-- task-62/E15 Mac NotesPageView 顶部：面包屑（所有会议 › 会议 › 复盘）+ 复制纪要 primary -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource D4Spacing_6}" VerticalAlignment="Center">
        <TextBlock Text="{loc:Tr 所有会议}" Classes="caption" Foreground="{DynamicResource Secondary}" />
        <TextBlock Text="›" Classes="caption" Foreground="{DynamicResource Tertiary}" />
        <TextBlock Text="{Binding NotesMeetingTitle}" Classes="caption" Foreground="{DynamicResource Secondary}"
                   MaxWidth="260" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="›" Classes="caption" Foreground="{DynamicResource Tertiary}" />
        <TextBlock Text="{loc:Tr 复盘}" Classes="caption" Foreground="{DynamicResource Secondary}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource D4Spacing_6}" VerticalAlignment="Center">
        <Button Classes="primary" Content="{loc:Tr 复制纪要}" Command="{Binding CopyNotesCommand}" />
        <Button Content="{loc:Tr 编辑纪要}" Click="EditNotes_Click" />
        <Button Content="{loc:Tr 重新整理}" Click="RegenerateNotes_Click" />
        <Button Content="{loc:Tr 导出…}" Command="{Binding OpenSessionExportCommand}" ToolTip.Tip="{loc:Tr 导出 Markdown…}" />
        <Button Content="{loc:Tr 详细信息}" Click="Info_Click" ToolTip.Tip="{loc:Tr 会议信息}" />
      </StackPanel>
    </Grid>

    <!-- Mac 标题（衬线大字）+ 事实行；「整理这场会议」留作默认按钮 -->
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="{DynamicResource D4Margin_0_12_0_0}">
      <StackPanel Spacing="{DynamicResource D4Spacing_4}" MaxWidth="760" HorizontalAlignment="Left">
        <TextBlock Text="{Binding NotesMeetingTitle}" FontFamily="{StaticResource SerifFamily}" FontSize="30"
                   FontWeight="Medium" Foreground="{DynamicResource InkBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding NotesFactsLine}" Classes="caption" />
        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource D4Spacing_6}"
                    IsVisible="{Binding HasSelectedNotesEvidence}">
          <TextBlock Text="{StaticResource IconLink}" FontFamily="{StaticResource IconFont}"
                     FontSize="11" Foreground="{DynamicResource Ai}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding SelectedNotesEvidenceText}" Classes="caption" FontSize="11"
                     TextWrapping="Wrap" Foreground="{DynamicResource Secondary}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource D4Spacing_6}"
                    IsVisible="{Binding HasNotesReadIssues}">
          <TextBlock Text="{StaticResource IconExclamationmarkTriangleFill}" FontFamily="{StaticResource IconFont}"
                     FontSize="12" Foreground="{DynamicResource Caution}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding NotesReadIssueText}" Classes="caption" TextWrapping="Wrap"
                     Foreground="{DynamicResource Caution}" VerticalAlignment="Center" />
          <Button Classes="quiet" Content="{loc:Tr 详情}" Command="{Binding ShowNotesReadIssuesCommand}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource D4Spacing_6}"
                    IsVisible="{Binding HasNotesStaleHint}">
          <TextBlock Text="{StaticResource IconQuestionCircle}" FontFamily="{StaticResource IconFont}"
                     FontSize="12" Foreground="{DynamicResource Caution}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding NotesStaleHintText}" Classes="caption"
                     Foreground="{DynamicResource Caution}" VerticalAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource D4Spacing_6}"
                    IsVisible="{Binding HasAiNewVersion}">
          <TextBlock Text="{loc:Tr AI 整理出了新版本。现在显示的仍是你改过的版本。}"
                     Classes="caption" Foreground="{DynamicResource Caution}" VerticalAlignment="Center" TextWrapping="Wrap" />
          <Button Classes="quiet" Content="{loc:Tr 查看新版}" Command="{Binding ViewNewAiVersionCommand}" />
          <Button Classes="quiet" Content="{loc:Tr 保留我的修订}" Command="{Binding KeepMyNotesRevisionCommand}" />
        </StackPanel>
        <StackPanel Spacing="{DynamicResource D4Spacing_4}" IsVisible="{Binding Working}">
          <TextBlock Text="{Binding Status}" Classes="caption" />
          <ProgressBar Value="{Binding Progress}" IsIndeterminate="{Binding ProgressIndeterminate}" Maximum="1" />
        </StackPanel>
      </StackPanel>
      <Button Grid.Column="1" VerticalAlignment="Top" Command="{Binding SummarizeCommand}" MinHeight="{DynamicResource HitRow}"
              Padding="{DynamicResource D4Padding_18_0}">
        <TextBlock Text="{loc:Tr 整理这场会议}" />
      </Button>
    </Grid>

    <!-- 模板与校对：模板决定章节，校对只改名字与术语 -->
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="{DynamicResource D4Margin_0_14_0_0}">
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource D4Spacing_10}">
        <ComboBox ItemsSource="{Binding TemplateChoices}" SelectedItem="{Binding SelectedTemplate}" MinWidth="150"
                  ToolTip.Tip="{loc:Tr 纪要模板：章节由模板决定，模型只填内容}" />
        <Button Content="{loc:Tr 按模板整理}" Command="{Binding SummarizeWithTemplateCommand}" />
        <Button Content="{loc:Tr 校对转写}" Command="{Binding ProofreadTranscriptCommand}"
                ToolTip.Tip="{loc:Tr 只更正名字与术语的识别错误，改动写入 corrections.json}" />
        <TextBlock Text="{Binding ProofreadStatus}" Classes="caption" FontSize="11" VerticalAlignment="Center"
                   IsVisible="{Binding HasProofreadStatus}" />
      </StackPanel>
      <CheckBox Grid.Column="1" Content="{loc:Tr 会议结束后自动整理}" IsChecked="{Binding Settings.AutoSummarize}" VerticalAlignment="Center" />
    </Grid>

    <!-- 纪要格式：文字纪要 / 因果鱼骨图 / 要点大纲 / 观点对照 -->
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="{DynamicResource D4Margin_0_12_0_0}">
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource D4Spacing_6}">
        <RadioButton Classes="chip" GroupName="notesformat"
                     IsChecked="{Binding NotesFormatIsStandard, Mode=OneWay}"
                     Command="{Binding SetNotesFormatCommand}" CommandParameter="{x:Static core:NotesFormat.Standard}">
          <TextBlock Text="{loc:Tr 复盘}" Foreground="{Binding $parent[RadioButton].Foreground}" />
        </RadioButton>
        <RadioButton Classes="chip" GroupName="notesformat"
                     IsChecked="{Binding NotesFormatIsOutline, Mode=OneWay}"
                     Command="{Binding SetNotesFormatCommand}" CommandParameter="{x:Static core:NotesFormat.Outline}">
          <TextBlock Text="{loc:Tr 提纲}" Foreground="{Binding $parent[RadioButton].Foreground}" />
        </RadioButton>
        <RadioButton Classes="chip" GroupName="notesformat"
                     IsChecked="{Binding NotesFormatIsFishbone, Mode=OneWay}"
                     Command="{Binding SetNotesFormatCommand}" CommandParameter="{x:Static core:NotesFormat.Fishbone}">
          <TextBlock Text="{loc:Tr 鱼骨图}" Foreground="{Binding $parent[RadioButton].Foreground}" />
        </RadioButton>
        <RadioButton Classes="chip" GroupName="notesformat"
                     IsChecked="{Binding NotesFormatIsViewpoints, Mode=OneWay}"
                     Command="{Binding SetNotesFormatCommand}" CommandParameter="{x:Static core:NotesFormat.Viewpoints}">
          <TextBlock Text="{loc:Tr 观点对照}" Foreground="{Binding $parent[RadioButton].Foreground}" />
        </RadioButton>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource D4Spacing_8}">
        <Button Content="{loc:Tr 生成这种纪要}" Command="{Binding GenerateStructuredNotesCommand}"
                IsVisible="{Binding !NotesFormatIsStandard}" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="4" Classes="card" Padding="{DynamicResource D4Padding_14}" Margin="{DynamicResource D4Margin_0_10_0_0}"
            IsVisible="{Binding CoachSummaryText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <StackPanel Spacing="{DynamicResource D4Spacing_4}">
        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource D4Spacing_4}">
          <TextBlock Text="{StaticResource IconSparkles}" FontFamily="{StaticResource IconFont}" FontSize="11"
                     Foreground="{DynamicResource Ai}" VerticalAlignment="Center" />
          <TextBlock Text="{loc:Tr 一句话印象}" Classes="overline" />
        </StackPanel>
        <TextBlock Text="{Binding CoachSummaryText}" Classes="body" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <!-- E15: MeetingPage four tabs (纪要 / 转写 / 回答 / 个人笔记)，证据栏在纪要标签右侧 -->
    <TabControl Grid.Row="5" Margin="{DynamicResource D4Margin_0_12_0_16}" SelectedIndex="{Binding NotesTabIndex}">
      <TabItem Header="{loc:Tr 复盘}">
        <Grid ColumnDefinitions="*,300" ColumnSpacing="{DynamicResource D4Spacing_10}" Margin="{DynamicResource D4Margin_0_8_0_0}">
          <Border Grid.Column="0" Classes="card" Padding="{DynamicResource D4Padding_0}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="{DynamicResource D4Spacing_10}" Margin="{DynamicResource D4Margin_22_16_22_22}">
                <!-- NotesProgressLine：生成中显示阶段与进度，就地从纪要页看到 -->
                <Border Classes="card" Padding="{DynamicResource D4Padding_12_10}" IsVisible="{Binding Summarizing}">
                  <StackPanel Spacing="{DynamicResource D4Spacing_4}">
                    <TextBlock Text="{loc:Tr 正在整理纪要}" Classes="label" />
                    <TextBlock Text="{Binding Status}" Classes="caption" />
                    <ProgressBar Value="{Binding Progress}" IsIndeterminate="{Binding ProgressIndeterminate}" Maximum="1" />
                  </StackPanel>
                </Border>
                <StackPanel>
                  <TextBlock Text="{Binding MeetingTitle}" Classes="title" FontSize="17" />
                  <TextBlock Text="{Binding PageSubtitle}" Classes="caption" FontSize="11" Margin="{DynamicResource D4Margin_0_3_0_0}" />
                  <TextBlock Text="{Binding StructuredHint}" Classes="caption" FontSize="11" Margin="{DynamicResource D4Margin_0_4_0_0}" />
                </StackPanel>

                <!-- 文字纪要 -->
                <views:MarkdownText Text="{Binding SummaryText}" BaseFontSize="14"
                                    IsVisible="{Binding NotesFormatIsStandard}" />
                <!-- 结构化纪要：鱼骨图画成骨图，观点对照画成矩阵 -->
                <StackPanel Spacing="{DynamicResource D4Spacing_10}" IsVisible="{Binding !NotesFormatIsStandard}"
                            SizeChanged="NotesStructured_SizeChanged">
                  <!-- Mac FishboneTree: below 520 points the chart becomes the collapsible narrow list. -->
                  <views:FishboneTree x:Name="FishboneTree" Height="360" Notes="{Binding StructuredPayload.Fishbone}"
                                      IsVisible="{Binding NotesShowFishboneTree}" />
                  <views:FishboneView x:Name="Fishbone" Height="360" Notes="{Binding StructuredPayload.Fishbone}"
                                      IsVisible="{Binding NotesShowWideFishbone}" />
                  <views:ViewpointMatrixView x:Name="Viewpoints" Matrix="{Binding StructuredPayload.Viewpoints}"
                                             IsVisible="{Binding HasViewpointMatrix}" />
                </StackPanel>
                <!-- OutlineView.swift 的真提纲视图（不再是 Markdown） -->
                <StackPanel Spacing="{DynamicResource D4Spacing_10}" IsVisible="{Binding NotesFormatIsOutline}">
                  <ItemsControl ItemsSource="{Binding NotesOutlineRows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="local:NotesOutlineRow">
                        <StackPanel Spacing="{DynamicResource D4Spacing_3}" Margin="{DynamicResource D4Margin_0_0_0_10}">
                          <Grid ColumnDefinitions="28,*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding Number}" Classes="caption" Foreground="{DynamicResource Tertiary}" />
                            <TextBlock Grid.Column="1" Text="{Binding Title}" Classes="section" TextWrapping="Wrap" />
                            <Button Grid.Column="2" Classes="quiet" Content="{Binding AtText}" Tag="{Binding At}"
                                    Click="OutlineTime_Click" IsVisible="{Binding HasAt}" ToolTip.Tip="{loc:Tr 跳到原话}" />
                          </Grid>
                          <ItemsControl ItemsSource="{Binding Lines}" Margin="{DynamicResource D4Margin_28_0_0_0}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="local:NotesOutlineLineRow">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource D4Spacing_6}"
                                      Margin="{DynamicResource D4Margin_0_2}">
                                  <TextBlock Grid.Column="0" Text="{Binding Prefix}" Classes="body" Foreground="{DynamicResource Tertiary}" />
                                  <TextBlock Grid.Column="1" Text="{Binding Text}" Classes="body" TextWrapping="Wrap" />
                                  <Button Grid.Column="2" Classes="quiet" Content="{Binding AtText}" Tag="{Binding At}"
                                          Click="OutlineTime_Click" IsVisible="{Binding HasAt}" ToolTip.Tip="{loc:Tr 跳到原话}" />
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <StackPanel IsVisible="{Binding HasOutlineConcepts}" Spacing="{DynamicResource D4Spacing_4}">
                    <TextBlock Text="{loc:Tr 关键概念}" Classes="section" />
                    <ItemsControl ItemsSource="{Binding NotesOutlineConcepts}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:NotesOutlineConceptRow">
                          <Grid ColumnDefinitions="140,*,Auto" ColumnSpacing="{DynamicResource D4Spacing_8}"
                                Margin="{DynamicResource D4Margin_0_0_0_6}">
                            <TextBlock Grid.Column="0" Text="{Binding Term}" Classes="label" TextWrapping="Wrap" />
                            <TextBlock Grid.Column="1" Text="{Binding Meaning}" Classes="body" TextWrapping="Wrap" />
                            <Button Grid.Column="2" Classes="quiet" Content="{Binding AtText}" Tag="{Binding At}"
                                    Click="OutlineTime_Click" IsVisible="{Binding HasAt}" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  <StackPanel IsVisible="{Binding HasOutlineReview}" Spacing="{DynamicResource D4Spacing_4}">
                    <TextBlock Text="{loc:Tr 待复习}" Classes="section" />
                    <ItemsControl ItemsSource="{Binding NotesOutlineReview}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:NotesReviewRow">
                          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource D4Spacing_6}"
                                Margin="{DynamicResource D4Margin_0_0_0_4}">
                            <TextBlock Grid.Column="0" Text="○" Classes="caption" Foreground="{DynamicResource Tertiary}" />
                            <TextBlock Grid.Column="1" Text="{Binding Text}" Classes="body" TextWrapping="Wrap" />
                            <Button Grid.Column="2" Classes="quiet" Content="{Binding AtText}" Tag="{Binding At}"
                                    Click="OutlineTime_Click" IsVisible="{Binding HasAt}" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  <TextBlock Text="{loc:Tr 还没有生成这种纪要。点上方「生成这种纪要」，会用当前回答服务把转写整理成它；每条都带原话时间。}"
                             Classes="caption" IsVisible="{Binding !HasStructuredNotes}" TextWrapping="Wrap" />
                </StackPanel>

                <!-- 系列知识回看（Mac KnowledgeReviewSection；原「回顾」标签并入纪要页） -->
                <StackPanel Spacing="{DynamicResource D4Spacing_4}" IsVisible="{Binding NotesFormatIsStandard}">
                  <TextBlock Text="{loc:Tr 已确认的经验}" Classes="overline" />
                  <ItemsControl ItemsSource="{Binding SelectedSeriesBriefing.Lessons}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="core:WorkspaceLesson">
                        <TextBlock Text="{Binding Text}" Classes="caption" TextWrapping="Wrap" Margin="{DynamicResource D4Margin_0_0_0_4}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="{loc:Tr 题库}" Classes="overline" Margin="{DynamicResource D4Margin_0_6_0_0}" />
                  <ItemsControl ItemsSource="{Binding SelectedSeriesBriefing.QuestionBank}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="core:QuestionBankItem">
                        <StackPanel Spacing="{DynamicResource D4Spacing_1}" Margin="{DynamicResource D4Margin_0_0_0_6}">
                          <TextBlock Text="{Binding Question}" Classes="label" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Answer}" Classes="caption" TextWrapping="Wrap" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </Border>

          <!-- SessionEvidencePane：证据栏常驻纪要页右侧 -->
          <Border Grid.Column="1" Classes="card" Padding="{DynamicResource D4Padding_12_10}">
            <Grid RowDefinitions="Auto,*">
              <TextBlock Grid.Row="0" Text="{loc:Tr 证据}" Classes="overline" />
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="{DynamicResource D4Margin_0_6_0_0}">
                <ItemsControl ItemsSource="{Binding NotesEvidence}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:SessionEvidenceRow">
                      <StackPanel Spacing="{DynamicResource D4Spacing_2}" Margin="{DynamicResource D4Margin_0_0_0_10}">
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource D4Spacing_4}">
                          <Border Classes="chip">
                            <TextBlock Text="{Binding Badge}" Classes="overline" FontSize="10" />
                          </Border>
                          <TextBlock Text="{Binding SupportLabel}" Classes="caption" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding Title}" Classes="label" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Claim}" Classes="caption" TextWrapping="Wrap" MaxLines="4" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource D4Spacing_4}">
                          <Button Classes="quiet" Content="{loc:Tr 跳到原话}" Tag="{Binding}" Click="JumpEvidence_Click" />
                          <Button Classes="quiet" Content="{loc:Tr 编辑}" Tag="{Binding}" Click="EditEvidence_Click" />
                        </StackPanel>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="{loc:Tr 转写}">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource D4Spacing_8}"
                      Margin="{DynamicResource D4Margin_22_12_22_0}">
            <Button Content="{loc:Tr 校正原话}" Command="{Binding OpenCorrectedTranscriptCommand}"
                    ToolTip.Tip="{loc:Tr 查看校正转写}" />
            <TextBlock Text="{Binding CorrectedTranscriptStatus}" Classes="caption" FontSize="11"
                       VerticalAlignment="Center" IsVisible="{Binding HasCorrectedTranscriptStatus}" />
            <TextBlock Text="{Binding NotesJumpNotice}" Classes="caption" FontSize="11" VerticalAlignment="Center"
                       Foreground="{DynamicResource Caution}" IsVisible="{Binding HasNotesJumpNotice}" />
          </StackPanel>
          <!-- E12/Mac SpeakerStrip：按声音区分出的人；点一个打开说话人编辑器 -->
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="{DynamicResource D4Margin_22_8_22_0}"
                IsVisible="{Binding SpeakerStripVisible}">
            <ItemsControl Name="TranscriptSpeakerStrip" Grid.Column="0" ItemsSource="{Binding SpeakerPeople}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:SpeakerPersonRow">
                  <Button Classes="quiet" Tag="{Binding}" Click="OpenSpeakerStrip_Click" ToolTip.Tip="{Binding Tooltip}"
                          Margin="{DynamicResource D4Margin_0_0_6_4}" Padding="{DynamicResource D4Padding_10_3}">
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource D4Spacing_4}">
                      <TextBlock Text="{Binding Mark}" FontSize="10" />
                      <TextBlock Text="{Binding DisplayLabel}" Classes="caption" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Grid.Column="1" Text="{loc:Tr 按声音区分}" Classes="caption" FontSize="11" VerticalAlignment="Center" />
          </Grid>
          <!-- TranscriptFindField：查找转写，听错的写法也会找出来 -->
          <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource D4Spacing_6}"
                Margin="{DynamicResource D4Margin_22_8_22_0}">
            <TextBox Grid.Column="0" Text="{Binding TranscriptFindQuery}" PlaceholderText="{Binding TranscriptFindPlaceholder}" />
            <TextBlock Grid.Column="1" Text="{Binding TranscriptFindCountText}" Classes="caption" VerticalAlignment="Center" />
            <Button Grid.Column="2" Classes="quiet" Content="{loc:Tr 清空搜索}"
                    Command="{Binding ClearTranscriptFindCommand}" IsVisible="{Binding HasTranscriptFindQuery}" />
          </Grid>
          <!-- 命中面板（含 MisheardMark 小字：匹配到听错的写法：…） -->
          <Border Grid.Row="3" Classes="card" Padding="{DynamicResource D4Padding_12_10}"
                  Margin="{DynamicResource D4Margin_22_8_22_0}" IsVisible="{Binding HasTranscriptFindHits}">
            <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding TranscriptFindHits}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:GlossaryTranscriptHitRow">
                    <StackPanel Spacing="{DynamicResource D4Spacing_1}" Margin="{DynamicResource D4Margin_0_0_0_6}">
                      <TextBlock Text="{Binding Text}" Classes="caption" TextWrapping="Wrap" />
                      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource D4Spacing_6}">
                        <TextBlock Text="{Binding MisheardMarkText}" Classes="caption" FontSize="11"
                                   Foreground="{DynamicResource Secondary}" IsVisible="{Binding HasMisheardMark}"
                                   ToolTip.Tip="{Binding MisheardTooltip}" />
                        <Button Classes="quiet" Content="{loc:Tr 加入术语表…}" Tag="{Binding}"
                                Click="AddTranscriptToGlossary_Click" />
                      </StackPanel>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
          <ListBox Grid.Row="4" Name="TranscriptListBox" ItemsSource="{Binding Transcript}"
                   Background="Transparent" Margin="{DynamicResource D4Margin_22_0_22_16}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="local:TranscriptRow">
                <StackPanel Spacing="{DynamicResource D4Spacing_6}" Margin="{DynamicResource D4Margin_0_0_0_10}">
                  <StackPanel.ContextMenu>
                    <ContextMenu Name="TranscriptRowMenu" Opening="TranscriptRowMenu_Opening">
                      <MenuItem Header="{loc:Tr 这句是谁说的}" Name="LineSpeakerMenu" />
                      <MenuItem Header="{loc:Tr 改这一句…}" Tag="{Binding}" Click="EditTranscriptLine_Click" />
                      <Separator />
                      <MenuItem Header="{loc:Tr 加入术语表…}" Tag="{Binding}" Click="AddTranscriptToGlossary_Click" />
                    </ContextMenu>
                  </StackPanel.ContextMenu>
                  <StackPanel Orientation="Horizontal" Spacing="{DynamicResource D4Spacing_6}">
                    <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{DynamicResource Secondary}" />
                    <TextBlock Text="{loc:Tr ★ 高亮}" FontSize="11" Foreground="{DynamicResource Caution}"
                               IsVisible="{Binding IsHighlighted}" />
                  </StackPanel>
                  <SelectableTextBlock Text="{Binding Text}" Classes="body" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Translation}" Classes="body" FontSize="13" TextWrapping="Wrap"
                             Foreground="{DynamicResource Ai}" IsVisible="{Binding HasTranslation}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </TabItem>

      <TabItem Header="{loc:Tr 我的笔记}">
        <views:MeetingUserNotes Margin="{DynamicResource D4Margin_22}" />
      </TabItem>      <TabItem Header="{loc:Tr 会中回答}" IsVisible="{Binding HasSessionAnswers}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding SelectedSessionAnswers}" Margin="{DynamicResource D4Margin_22}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="core:AnswerRecord">
                <StackPanel Spacing="{DynamicResource D4Spacing_4}" Margin="{DynamicResource D4Margin_0_0_0_12}">
                  <StackPanel Orientation="Horizontal" Spacing="{DynamicResource D4Spacing_6}">
                    <TextBlock Text="{Binding Question}" Classes="label" TextWrapping="Wrap" />
                    <Border Classes="chip" IsVisible="{Binding Automatic}">
                      <TextBlock Text="{loc:Tr 自动}" Classes="overline" FontSize="10" />
                    </Border>
                  </StackPanel>
                  <TextBlock Text="{Binding Answer}" Classes="body" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Model}" Classes="caption" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
