<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:NextThought.Desktop.Localization"
        xmlns:local="using:NextThought.Desktop"
        xmlns:views="using:NextThought.Desktop.Views"
        x:Class="NextThought.Desktop.Views.InsightsPanelWindow"
        x:DataType="local:AppState"
        Title="{loc:Tr 洞察}" Width="520" Height="620" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Paper}">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="{DynamicResource D4Margin_18}">
    <views:InsightsPanel />
  </ScrollViewer>
</Window>