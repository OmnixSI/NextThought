<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:NextThought.Desktop.Controls">
  <!--
    Stage 3 §6.1: the reusable Mac design-system controls (VIEW_PARITY "通用组件").
    Values come from DesignSystem.swift / ControlComponents.swift / HitTargets.swift /
    LiquidGlass.swift / Stage.swift / Theme.swift / UnderlineTabs.swift; colours and type
    scale come from Styles/Theme.axaml (Ink palette, Typo classes).
  -->
  <Styles.Resources>
    <x:Double x:Key="ControlRadius">9</x:Double>
    <x:Double x:Key="ControlHeight">32</x:Double>
    <x:Double x:Key="HitMin">32</x:Double>
    <x:Double x:Key="HitIcon">36</x:Double>
    <CornerRadius x:Key="SegmentedRadius">6</CornerRadius>
    <CornerRadius x:Key="ChipRadius">8</CornerRadius>
    <FontFamily x:Key="CodeFamily">Cascadia Mono, Consolas, monospace</FontFamily>
  </Styles.Resources>

  <!-- ===== ControlButtonBody: primary / secondary / quiet / destructive ========= -->

  <Style Selector="c|ControlButtonBody">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9"
                Padding="{TemplateBinding Padding}" Height="{TemplateBinding ButtonHeight}" MinHeight="32">
          <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
  </Style>
  <Style Selector="c|ControlButtonBody:pointerover /template/ Border#Root">
    <Setter Property="Background" Value="{DynamicResource Hover}" />
  </Style>
  <Style Selector="c|ControlButtonBody:pressed /template/ Border#Root">
    <Setter Property="Background" Value="{DynamicResource Pressed}" />
  </Style>
  <Style Selector="c|ControlButtonBody:disabled">
    <Setter Property="Opacity" Value="0.38" />
  </Style>
  <Style Selector="c|ControlButtonBody:focus-visible /template/ Border#Root">
    <Setter Property="BorderBrush" Value="{DynamicResource Ai}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="c|ControlButtonBody.primary">
    <Setter Property="Background" Value="{DynamicResource InkBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnInk}" />
  </Style>
  <Style Selector="c|ControlButtonBody.primary:pointerover /template/ Border#Root">
    <Setter Property="Background" Value="{DynamicResource PrimaryHover}" />
  </Style>
  <Style Selector="c|ControlButtonBody.secondary">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Hairline}" />
    <Setter Property="BorderThickness" Value="0.5" />
  </Style>
  <Style Selector="c|ControlButtonBody.quiet">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="c|ControlButtonBody.destructive">
    <Setter Property="Background" Value="{DynamicResource Seal}" />
    <Setter Property="Foreground" Value="{DynamicResource OnInk}" />
  </Style>
  <Style Selector="c|ControlButtonBody.sample-hover /template/ Border#Root">
    <Setter Property="Background" Value="{DynamicResource Hover}" />
  </Style>
  <Style Selector="c|ControlButtonBody.primary.sample-hover /template/ Border#Root">
    <Setter Property="Background" Value="{DynamicResource PrimaryHover}" />
  </Style>
  <Style Selector="c|ControlButtonBody.sample-pressed /template/ Border#Root">
    <Setter Property="Background" Value="{DynamicResource Pressed}" />
  </Style>
  <Style Selector="c|ControlButtonBody.sample-focus /template/ Border#Root">
    <Setter Property="BorderBrush" Value="{DynamicResource Ai}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <!-- ===== BusyActionLabel / AIHeading / ShortcutHint ============================= -->

  <Style Selector="c|BusyActionLabel">
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Content="{TemplateBinding Content}" />
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="c|AIHeading">
    <Setter Property="Foreground" Value="{DynamicResource Ai}" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Content="{TemplateBinding Content}" />
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="c|AIHeading TextBlock.overline">
    <Setter Property="Foreground" Value="{DynamicResource Ai}" />
  </Style>

  <Style Selector="c|ShortcutHint">
    <Setter Property="Foreground" Value="{DynamicResource Secondary}" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Content="{TemplateBinding Content}" />
      </ControlTemplate>
    </Setter>
  </Style>

  <!-- ===== StatusDot ============================================================== -->

  <Style Selector="c|StatusDot">
    <Setter Property="Width" Value="7" />
    <Setter Property="Height" Value="7" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Dot" CornerRadius="4" Background="{TemplateBinding Background}" Width="7" Height="7" />
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="c|StatusDot.tone-live">
    <Setter Property="Background" Value="{DynamicResource Seal}" />
  </Style>
  <Style Selector="c|StatusDot.tone-ready">
    <Setter Property="Background" Value="{DynamicResource Ready}" />
  </Style>
  <Style Selector="c|StatusDot.tone-caution">
    <Setter Property="Background" Value="{DynamicResource Caution}" />
  </Style>
  <Style Selector="c|StatusDot.tone-idle">
    <Setter Property="Background" Value="{DynamicResource Tertiary}" />
  </Style>

  <!-- ===== InkSegmented / PillTabs / UnderlineTabs ================================ -->

  <Style Selector="c|InkSegmented">
    <Setter Property="Background" Value="{DynamicResource Sunken}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="2">
          <ItemsPresenter />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="c|InkSegmented > ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="6" Height="28" Padding="14,0">
          <ContentPresenter Content="{TemplateBinding Content}" TextWrapping="NoWrap"
                            VerticalAlignment="Center" HorizontalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="c|InkSegmented > ListBoxItem ContentPresenter">
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="c|InkSegmented > ListBoxItem TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource Secondary}" />
    <Setter Property="Margin" Value="14,0" />
    <Setter Property="MinWidth" Value="32" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="c|InkSegmented > ListBoxItem:selected TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
  </Style>
  <Style Selector="c|InkSegmented > ListBoxItem:selected">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaised}" />
  </Style>

  <Style Selector="c|PillTabs > ListBoxItem">
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{DynamicResource Sunken}" />
  </Style>
  <Style Selector="c|PillTabs > ListBoxItem:selected">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaised}" />
  </Style>

  <Style Selector="c|UnderlineTabs">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <ControlTemplate>
        <ItemsPresenter />
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="c|UnderlineTabs > ListBoxItem">
    <Setter Property="Padding" Value="0,0,0,6" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="c|UnderlineTabs > ListBoxItem:selected">
    <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}" />
  </Style>
  <Style Selector="c|UnderlineTabs > ListBoxItem TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource Secondary}" />
  </Style>
  <Style Selector="c|UnderlineTabs > ListBoxItem:selected TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
  </Style>

  <!-- ===== InteractiveRowBody ===================================================== -->

  <Style Selector="c|InteractiveRowBody">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Root" Background="{TemplateBinding Background}" CornerRadius="8"
                Padding="{TemplateBinding Padding}" MinHeight="32">
          <ContentPresenter Content="{TemplateBinding Content}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="c|InteractiveRowBody:pointerover /template/ Border#Root">
    <Setter Property="Background" Value="{DynamicResource Hover}" />
  </Style>
  <Style Selector="c|InteractiveRowBody:pressed /template/ Border#Root">
    <Setter Property="Background" Value="{DynamicResource Pressed}" />
  </Style>
  <Style Selector="c|InteractiveRowBody:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>
  <Style Selector="c|InteractiveRowBody.sample-hover /template/ Border#Root">
    <Setter Property="Background" Value="{DynamicResource Hover}" />
  </Style>
  <Style Selector="c|InteractiveRowBody.sample-pressed /template/ Border#Root">
    <Setter Property="Background" Value="{DynamicResource Pressed}" />
  </Style>

  <!-- ===== InkSwitch / WideToggleRow ============================================== -->

  <Style Selector="c|InkSwitch">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid Width="34" Height="20">
          <Border Name="Track" CornerRadius="10" Background="{DynamicResource Tertiary}" Opacity="0.45" />
          <Border Name="Knob" Width="16" Height="16" CornerRadius="8" Background="{DynamicResource Surface}"
                  HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="c|InkSwitch:checked /template/ Border#Track">
    <Setter Property="Background" Value="{DynamicResource InkBrush}" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="c|InkSwitch:checked /template/ Border#Knob">
    <Setter Property="Background" Value="{DynamicResource OnInk}" />
    <Setter Property="Margin" Value="16,0,0,0" />
  </Style>
  <Style Selector="c|InkSwitch:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <Style Selector="c|WideToggleRow">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Root" Background="Transparent" CornerRadius="8" Padding="4,2" MinHeight="36">
          <Grid ColumnDefinitions="*,Auto">
            <ContentPresenter Grid.Column="0" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              VerticalAlignment="Center" />
            <c:InkSwitch Grid.Column="1" IsChecked="{TemplateBinding IsChecked}" VerticalAlignment="Center" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
  </Style>
  <Style Selector="c|WideToggleRow:pointerover /template/ Border#Root">
    <Setter Property="Background" Value="{DynamicResource Hover}" />
  </Style>
  <Style Selector="c|WideToggleRow:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <!-- ===== Liquid glass family: AppBackdrop / GlassGroup / MenuPicker / ProminentFill =
                  ScrollEdgeFade ==================================================== -->

  <Style Selector="c|AppBackdrop">
    <Setter Property="Background" Value="{DynamicResource Paper}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}">
          <ContentPresenter Content="{TemplateBinding Content}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="c|GlassGroup">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Hairline}" />
    <Setter Property="BorderThickness" Value="0.5" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="c|MenuPicker">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Hairline}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="10,7" />
  </Style>

  <Style Selector="c|ProminentFill">
    <Setter Property="Background" Value="{DynamicResource InkBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="c|ScrollEdgeFade">
    <Setter Property="Height" Value="36" />
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="50%,100%" EndPoint="50%,0%">
        <GradientStop Color="#F7F5F0" Offset="0" />
        <GradientStop Color="#D9F7F5F0" Offset="0.5" />
        <GradientStop Color="#00F7F5F0" Offset="1" />
      </LinearGradientBrush>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" Height="{TemplateBinding Height}" />
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="c|ScrollEdgeFade.bottom">
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
        <GradientStop Color="#F7F5F0" Offset="0" />
        <GradientStop Color="#D9F7F5F0" Offset="0.5" />
        <GradientStop Color="#00F7F5F0" Offset="1" />
      </LinearGradientBrush>
    </Setter>
  </Style>

  <!-- ===== OperationFeedback ====================================================== -->

  <Style Selector="c|OperationFeedback">
    <Setter Property="Foreground" Value="{DynamicResource Secondary}" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Content="{TemplateBinding Content}" />
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="c|OperationFeedback TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Secondary}" />
  </Style>
  <Style Selector="c|OperationFeedback.tone-failure TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Seal}" />
  </Style>

  <!-- ===== PaperFieldBody ======================================================== -->

  <Style Selector="c|PaperFieldBody">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Hairline}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="10,7" />
  </Style>
  <Style Selector="c|PaperFieldBody:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource Ai}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="c|PaperFieldBody:disabled">
    <Setter Property="Background" Value="{DynamicResource Sunken}" />
    <Setter Property="Foreground" Value="{DynamicResource Tertiary}" />
  </Style>

  <!-- ===== Lift ================================================================== -->

  <Style Selector="c|Lift">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Root" Background="{DynamicResource Surface}" CornerRadius="14" Padding="16"
                BoxShadow="0 1 2 0 #121C1B19, 0 8 14 0 #0F1C1B19">
          <ContentPresenter Content="{TemplateBinding Content}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="c|Lift:pointerover /template/ Border#Root">
    <Setter Property="BoxShadow" Value="0 1 2 0 #121C1B19, 0 12 16 0 #1F1C1B19" />
    <Setter Property="BorderBrush" Value="{DynamicResource Hairline}" />
  </Style>
  <Style Selector="c|Lift.sample-hover /template/ Border#Root">
    <Setter Property="BoxShadow" Value="0 1 2 0 #121C1B19, 0 12 16 0 #1F1C1B19" />
    <Setter Property="BorderBrush" Value="{DynamicResource Hairline}" />
  </Style>
  <Style Selector="c|Lift:pressed /template/ Border#Root">
    <Setter Property="BoxShadow" Value="0 1 2 0 #121C1B19" />
  </Style>

  <!-- ===== MarkdownText / MetricPill / RefinementBar ============================= -->


  <Style Selector="c|MetricPill">
    <Setter Property="Background" Value="{DynamicResource Sunken}" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="9,4" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="c|RefinementBar">
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Content="{TemplateBinding Content}" />
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="c|RefinementBar Button.chip">
    <Setter Property="Background" Value="{DynamicResource Sunken}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="FontSize" Value="12" />
  </Style>
</Styles>
