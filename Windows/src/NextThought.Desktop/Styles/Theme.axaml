      <Thickness x:Key="D4Margin_18_0_18_10">18,0,18,10</Thickness>
      <Thickness x:Key="D4Margin_18_10_18_14">18,10,18,14</Thickness>
      <Thickness x:Key="D4Margin_18_16_18_10">18,16,18,10</Thickness>
      <Thickness x:Key="D4Margin_18_16_18_6">18,16,18,6</Thickness>
