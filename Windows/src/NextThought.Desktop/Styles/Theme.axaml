      <Thickness x:Key="D4Padding_6_2">6,2</Thickness>
      <Thickness x:Key="D4Padding_7_3">7,3</Thickness>
      <Thickness x:Key="D4Padding_8">8</Thickness>
      <Thickness x:Key="D4Padding_8_2">8,2</Thickness>
