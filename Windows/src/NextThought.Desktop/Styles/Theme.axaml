<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Design tokens ported from Sources/NextThought/DesignSystem.swift.
    Paper, ink and a seal: warm paper and near-black ink carry the interface;
    one cinnabar red (seal) marks what is live, the way a seal marks a finished page.
  -->
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="Paper" Color="#F7F5F0" />
          <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
          <SolidColorBrush x:Key="SurfaceRaised" Color="#FFFFFF" />
          <SolidColorBrush x:Key="Sunken" Color="#0A1C1B19" />
          <SolidColorBrush x:Key="Hover" Color="#0F1C1B19" />
          <SolidColorBrush x:Key="Pressed" Color="#1C1C1B19" />
          <SolidColorBrush x:Key="InkBrush" Color="#1C1B19" />
          <SolidColorBrush x:Key="OnInk" Color="#FFFFFF" />
          <SolidColorBrush x:Key="Secondary" Color="#6B6963" />
          <SolidColorBrush x:Key="Tertiary" Color="#706E68" />
          <SolidColorBrush x:Key="Hairline" Color="#171C1B19" />
          <SolidColorBrush x:Key="Ai" Color="#595751" />
          <SolidColorBrush x:Key="AiSoft" Color="#0B1C1B19" />
          <SolidColorBrush x:Key="PromptPanel" Color="#F0EFEC" />
          <SolidColorBrush x:Key="Seal" Color="#C4452C" />
          <SolidColorBrush x:Key="SealSoft" Color="#14C4452C" />
          <SolidColorBrush x:Key="Ready" Color="#237542" />
          <SolidColorBrush x:Key="Caution" Color="#8A5707" />
          <BoxShadows x:Key="ContactShadow">0 1 2 0 #121C1B19</BoxShadows>
          <BoxShadows x:Key="AmbientShadow">0 8 14 0 #0F1C1B19</BoxShadows>
          <BoxShadows x:Key="FloatShadow">0 12 16 0 #1F1C1B19</BoxShadows>
          <BoxShadows x:Key="PaperCardShadow">0 1 2 0 #121C1B19, 0 8 14 0 #0F1C1B19</BoxShadows>
          <BoxShadows x:Key="FloatShadowValue">0 12 16 0 #1F1C1B19</BoxShadows>
          <SolidColorBrush x:Key="SidebarTint" Color="#F2F0EA" />
          <SolidColorBrush x:Key="TranscriptBubble" Color="#F4F2ED" />
          <SolidColorBrush x:Key="PrimaryHover" Color="#33312C" />
          <SolidColorBrush x:Key="PrimaryPressed" Color="#121110" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="Paper" Color="#121110" />
          <SolidColorBrush x:Key="Surface" Color="#1B1B19" />
          <SolidColorBrush x:Key="SurfaceRaised" Color="#242422" />
          <SolidColorBrush x:Key="Sunken" Color="#0DECEBE8" />
          <SolidColorBrush x:Key="Hover" Color="#14ECEBE8" />
          <SolidColorBrush x:Key="Pressed" Color="#24ECEBE8" />
          <SolidColorBrush x:Key="InkBrush" Color="#ECEBE8" />
          <SolidColorBrush x:Key="OnInk" Color="#131312" />
          <SolidColorBrush x:Key="Secondary" Color="#A3A19B" />
          <SolidColorBrush x:Key="Tertiary" Color="#95938C" />
          <SolidColorBrush x:Key="Hairline" Color="#1CECEBE8" />
          <SolidColorBrush x:Key="Ai" Color="#B8B6AF" />
          <SolidColorBrush x:Key="AiSoft" Color="#12ECEBE8" />
          <SolidColorBrush x:Key="PromptPanel" Color="#242422" />
          <SolidColorBrush x:Key="Seal" Color="#F07055" />
          <SolidColorBrush x:Key="SealSoft" Color="#22F07055" />
          <SolidColorBrush x:Key="Ready" Color="#4CC38A" />
          <SolidColorBrush x:Key="Caution" Color="#F0B24A" />
          <BoxShadows x:Key="ContactShadow">0 1 2 0 #66000000</BoxShadows>
          <BoxShadows x:Key="AmbientShadow">0 8 14 0 #52000000</BoxShadows>
          <BoxShadows x:Key="FloatShadow">0 12 16 0 #80000000</BoxShadows>
          <BoxShadows x:Key="PaperCardShadow">0 1 2 0 #66000000, 0 8 14 0 #52000000</BoxShadows>
          <BoxShadows x:Key="FloatShadowValue">0 12 16 0 #80000000</BoxShadows>
          <SolidColorBrush x:Key="SidebarTint" Color="#181816" />
          <SolidColorBrush x:Key="TranscriptBubble" Color="#201F1D" />
          <SolidColorBrush x:Key="PrimaryHover" Color="#D8D6CF" />
          <SolidColorBrush x:Key="PrimaryPressed" Color="#C2C0B9" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <!-- Spacing and radii (Space) -->
      <x:Double x:Key="S1">4</x:Double>
      <x:Double x:Key="S2">8</x:Double>
      <x:Double x:Key="S3">12</x:Double>
      <x:Double x:Key="S4">16</x:Double>
      <x:Double x:Key="S6">24</x:Double>
      <x:Double x:Key="S8">32</x:Double>
      <x:Double x:Key="S10">40</x:Double>
      <x:Double x:Key="S12">48</x:Double>
      <x:Double x:Key="Control">32</x:Double>
      <x:Double x:Key="ControlLarge">40</x:Double>
      <!-- HitTargets.swift: least clickable height of a text button/chip/row control, an
           icon-only button and a whole-row switch. -->
      <x:Double x:Key="HitMin">32</x:Double>
      <x:Double x:Key="HitIcon">36</x:Double>
      <x:Double x:Key="HitRow">36</x:Double>
      <x:Double x:Key="Sidebar">220</x:Double>
      <x:Double x:Key="Content">720</x:Double>
      <!-- E4: live page spacing (question marker capsule, side column margins, composer). -->
      <Thickness x:Key="D4Margin_0_0">0</Thickness>
      <Thickness x:Key="D4Margin_0_0_0_4">0,0,0,4</Thickness>
      <Thickness x:Key="D4Margin_0_0_0_14">0,0,0,14</Thickness>
      <Thickness x:Key="D4Margin_0_0_6_4">0,0,6,4</Thickness>
      <Thickness x:Key="D4Margin_0_10_0_4">0,10,0,4</Thickness>
      <Thickness x:Key="D4Margin_0_16_0_10">0,16,0,10</Thickness>
      <Thickness x:Key="D4Margin_0_4_0_2">0,4,0,2</Thickness>
      <Thickness x:Key="D4Margin_0_8_0_6">0,8,0,6</Thickness>
      <Thickness x:Key="D4Margin_14_0_14_12">14,0,14,12</Thickness>
      <Thickness x:Key="D4Margin_14_0_14_4">14,0,14,4</Thickness>
      <Thickness x:Key="D4Margin_18_14_18_6">18,14,18,6</Thickness>
      <Thickness x:Key="D4Margin_18_6_18_12">18,6,18,12</Thickness>
      <Thickness x:Key="D4Margin_24">24</Thickness>
      <Thickness x:Key="D4Margin_m2_2_2_0">-2,-2,-2,0</Thickness>
      <Thickness x:Key="D4Padding_0_0_0_4">0,0,0,4</Thickness>
      <Thickness x:Key="D4Padding_7_2">7,2</Thickness>
      <Thickness x:Key="D4Padding_2">2</Thickness>
      <Thickness x:Key="D4Margin_8_14_8_14">8,14,8,14</Thickness>
      <Thickness x:Key="D4Padding_10_6">10,6</Thickness>
      <Thickness x:Key="D4Padding_12_8">12,8</Thickness>
      <CornerRadius x:Key="RadiusSmall">8</CornerRadius>
      <CornerRadius x:Key="RadiusMedium">14</CornerRadius>
      <CornerRadius x:Key="RadiusLarge">22</CornerRadius>

      <!-- D4 spacing/size resources:
      <Thickness x:Key="D4Padding_13_5">13,5</Thickness>
      <Thickness x:Key="D4Margin_0_0_4_4">0,0,4,4</Thickness>
      <CornerRadius x:Key="D4CornerRadius_14">14</CornerRadius>
 every numeric Margin/Padding/Spacing/CornerRadius in Views. -->
      <CornerRadius x:Key="D4CornerRadius_10">10</CornerRadius>
      <CornerRadius x:Key="D4CornerRadius_16">16</CornerRadius>
      <CornerRadius x:Key="D4CornerRadius_18">18</CornerRadius>
      <CornerRadius x:Key="D4CornerRadius_20">20</CornerRadius>
      <CornerRadius x:Key="D4CornerRadius_3">3</CornerRadius>
      <CornerRadius x:Key="D4CornerRadius_13">13</CornerRadius>
      <CornerRadius x:Key="D4CornerRadius_15">15</CornerRadius>
      <CornerRadius x:Key="D4CornerRadius_4">4</CornerRadius>
      <CornerRadius x:Key="D4CornerRadius_7">7</CornerRadius>
      <CornerRadius x:Key="D4CornerRadius_8">8</CornerRadius>
      <Thickness x:Key="D4Margin_m10_0_0_0">-10,0,0,0</Thickness>
      <Thickness x:Key="D4Margin_m10_4_0_0">-10,4,0,0</Thickness>
      <Thickness x:Key="D4Margin_0">0</Thickness>
      <Thickness x:Key="D4Margin_0_0_0_0">0,0,0,0</Thickness>
      <Thickness x:Key="D4Margin_0_0_0_10">0,0,0,10</Thickness>
      <Thickness x:Key="D4Margin_0_0_0_12">0,0,0,12</Thickness>
      <Thickness x:Key="D4Margin_0_0_0_16">0,0,0,16</Thickness>
      <Thickness x:Key="D4Margin_0_0_0_6">0,0,0,6</Thickness>
      <Thickness x:Key="D4Margin_0_0_0_8">0,0,0,8</Thickness>
      <Thickness x:Key="D4Margin_0_2_0_0">0,2,0,0</Thickness>
      <Thickness x:Key="D4Margin_0_12_0_12">0,12,0,12</Thickness>
      <Thickness x:Key="D4Margin_0_24_0_0">0,24,0,0</Thickness>
