      <Thickness x:Key="D4Padding_10_8">10,8</Thickness>
      <Thickness x:Key="D4Padding_10_9">10,9</Thickness>
      <Thickness x:Key="D4Padding_12_10">12,10</Thickness>
      <Thickness x:Key="D4Padding_14_0">14,0</Thickness>
      <Thickness x:Key="D4Padding_14_4_14_12">14,4,14,12</Thickness>
      <Thickness x:Key="D4Padding_16">16</Thickness>
      <Thickness x:Key="D4Padding_16_0">16,0</Thickness>
      <Thickness x:Key="D4Padding_16_10">16,10</Thickness>
      <Thickness x:Key="D4Padding_16_11">16,11</Thickness>
      <Thickness x:Key="D4Padding_18_0">18,0</Thickness>
      <Thickness x:Key="D4Padding_20_0">20,0</Thickness>
