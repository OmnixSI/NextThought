      <x:Double x:Key="D4Spacing_8">8</x:Double>

      <!-- Type families (§5.1): one static face per weight, no variable fonts (their default
           instance renders Thin/ExtraLight in Avalonia). Each family carries Latin and Chinese of
           the same weight, so a mixed line keeps one weight across both scripts. -->
      <FontFamily x:Key="SansFamily">avares://NextThought/Assets/Fonts/Inter-Regular.ttf#Inter, avares://NextThought/Assets/Fonts/NotoSansSC-Regular.otf#Noto Sans SC</FontFamily>
      <FontFamily x:Key="SansMediumFamily">avares://NextThought/Assets/Fonts/Inter-Medium.ttf#Inter, avares://NextThought/Assets/Fonts/NotoSansSC-Medium.otf#Noto Sans SC</FontFamily>
      <FontFamily x:Key="SansSemiBoldFamily">avares://NextThought/Assets/Fonts/Inter-SemiBold.ttf#Inter, avares://NextThought/Assets/Fonts/NotoSansSC-SemiBold.otf#Noto Sans SC</FontFamily>
      <FontFamily x:Key="SerifFamily">avares://NextThought/Assets/Fonts/SourceSerif4-Medium.ttf#Source Serif 4, avares://NextThought/Assets/Fonts/NotoSerifSC-Medium.otf#Noto Serif SC</FontFamily>
      <FontFamily x:Key="MonoFamily">Cascadia Mono, Consolas, Noto Sans Mono CJK SC</FontFamily>

      <!-- Surfaces: paperCard, aiBlock, floatingSurface; shadows are theme resources. -->
      <Thickness x:Key="D4Margin_0_16_0_0">0,16,0,0</Thickness>
      <Thickness x:Key="D4Padding_12">12</Thickness>
      <Thickness x:Key="D4Margin_8">8</Thickness>
      <Thickness x:Key="D4Padding_14">14</Thickness>
      <CornerRadius x:Key="D4CornerRadius_12">12</CornerRadius>
      <Thickness x:Key="D4Padding_8_3">8,3</Thickness>
      <Thickness x:Key="D4Margin_16">16</Thickness>
      <Thickness x:Key="D4Margin_20">20</Thickness>
      <Thickness x:Key="D4Margin_20_16_20_28">20,16,20,28</Thickness>
      <CornerRadius x:Key="D4CornerRadius_22">22</CornerRadius>
      <Thickness x:Key="D4Padding_24_12">24,12</Thickness>
      <Thickness x:Key="D4Margin_0_7_8_0">0,7,8,0</Thickness>
      <Thickness x:Key="D4Padding_8_0">8,0</Thickness>
      <Thickness x:Key="D4Margin_18">18</Thickness>
      <Thickness x:Key="D4Margin_2_0_0_0">2,0,0,0</Thickness>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- Default window typography -->
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{StaticResource SansFamily}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource SansFamily}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- Type scale: hero 38 serif, display 30 serif, section 19 serif, prompt 22 medium,
       title 15 semibold, body 15, label 13 medium, caption 12, overline 11 semibold -->
  <Style Selector="TextBlock.hero">
    <Setter Property="FontFamily" Value="{StaticResource SerifFamily}" />
    <Setter Property="FontSize" Value="38" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="TextBlock.display">
    <Setter Property="FontFamily" Value="{StaticResource SerifFamily}" />
    <Setter Property="FontSize" Value="30" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="FontFamily" Value="{StaticResource SerifFamily}" />
    <Setter Property="FontSize" Value="19" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="TextBlock.prompt">
    <Setter Property="FontFamily" Value="{StaticResource SansMediumFamily}" />
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="LineHeight" Value="32" />
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontFamily" Value="{StaticResource SansSemiBoldFamily}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.body">
    <Setter Property="FontFamily" Value="{StaticResource SansFamily}" />
    <Setter Property="FontSize" Value="15" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontFamily" Value="{StaticResource SansMediumFamily}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontFamily" Value="{StaticResource SansFamily}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Secondary}" />
  </Style>
  <Style Selector="TextBlock.overline">
    <Setter Property="FontFamily" Value="{StaticResource SansSemiBoldFamily}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.66" />
    <Setter Property="Foreground" Value="{DynamicResource Secondary}" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource Secondary}" />
  </Style>
  <Style Selector="TextBlock.faint">
    <Setter Property="Foreground" Value="{DynamicResource Tertiary}" />
  </Style>
  <Style Selector="TextBlock.code">
    <Setter Property="FontFamily" Value="{StaticResource MonoFamily}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- §5.5: Mac's scroll bars are thin overlays that appear while scrolling or hovering. -->
  <Style Selector="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="8" />
    <Setter Property="MinWidth" Value="8" />
    <Setter Property="AllowAutoHide" Value="True" />
    <Setter Property="HideDelay" Value="0:0:1.5" />
  </Style>

  <!-- §5.7: the content area keeps Mac's 720 column, centred in the window. -->
  <Style Selector="Control.contentColumn">
    <Setter Property="MaxWidth" Value="{StaticResource Content}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaised}" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Hairline}" />
    <Setter Property="BorderThickness" Value="0.5" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="FontSize" Value="12" />
  </Style>
</Styles>
