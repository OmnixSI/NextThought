<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Design tokens ported from Sources/NextThought/DesignSystem.swift.
    Paper, ink and a seal: warm paper and near-black ink carry the interface;
    one cinnabar red (seal) marks what is live, the way a seal marks a finished page.
  -->
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="Paper" Color="#F7F5F0" />
          <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
          <SolidColorBrush x:Key="SurfaceRaised" Color="#FFFFFF" />
          <SolidColorBrush x:Key="Sunken" Color="#081C1B19" />
          <SolidColorBrush x:Key="Hover" Color="#0F1C1B19" />
          <SolidColorBrush x:Key="Pressed" Color="#1C1C1B19" />
          <SolidColorBrush x:Key="InkBrush" Color="#1C1B19" />
          <SolidColorBrush x:Key="OnInk" Color="#FFFFFF" />
          <SolidColorBrush x:Key="Secondary" Color="#6B6963" />
          <SolidColorBrush x:Key="Tertiary" Color="#706E68" />
          <SolidColorBrush x:Key="Hairline" Color="#171C1B19" />
          <SolidColorBrush x:Key="Ai" Color="#595751" />
          <SolidColorBrush x:Key="AiSoft" Color="#0B1C1B19" />
          <SolidColorBrush x:Key="PromptPanel" Color="#F0EFEC" />
          <SolidColorBrush x:Key="Seal" Color="#C4452C" />
          <SolidColorBrush x:Key="SealSoft" Color="#14C4452C" />
          <SolidColorBrush x:Key="Ready" Color="#237542" />
          <SolidColorBrush x:Key="Caution" Color="#8A5707" />
          <SolidColorBrush x:Key="ContactShadow" Color="#121C1B19" />
          <SolidColorBrush x:Key="AmbientShadow" Color="#0F1C1B19" />
          <SolidColorBrush x:Key="FloatShadow" Color="#1F1C1B19" />
          <SolidColorBrush x:Key="SidebarTint" Color="#F2F0EA" />
          <SolidColorBrush x:Key="TranscriptBubble" Color="#F4F2ED" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="Paper" Color="#121110" />
          <SolidColorBrush x:Key="Surface" Color="#1B1B19" />
          <SolidColorBrush x:Key="SurfaceRaised" Color="#242422" />
          <SolidColorBrush x:Key="Sunken" Color="#0DECEBE8" />
          <SolidColorBrush x:Key="Hover" Color="#14ECEBE8" />
          <SolidColorBrush x:Key="Pressed" Color="#24ECEBE8" />
          <SolidColorBrush x:Key="InkBrush" Color="#ECEBE8" />
          <SolidColorBrush x:Key="OnInk" Color="#131312" />
          <SolidColorBrush x:Key="Secondary" Color="#A3A19B" />
          <SolidColorBrush x:Key="Tertiary" Color="#95938C" />
          <SolidColorBrush x:Key="Hairline" Color="#1CECEBE8" />
          <SolidColorBrush x:Key="Ai" Color="#B8B6AF" />
          <SolidColorBrush x:Key="AiSoft" Color="#12ECEBE8" />
          <SolidColorBrush x:Key="PromptPanel" Color="#242422" />
          <SolidColorBrush x:Key="Seal" Color="#F07055" />
          <SolidColorBrush x:Key="SealSoft" Color="#22F07055" />
          <SolidColorBrush x:Key="Ready" Color="#4CC38A" />
          <SolidColorBrush x:Key="Caution" Color="#F0B24A" />
          <SolidColorBrush x:Key="ContactShadow" Color="#66000000" />
          <SolidColorBrush x:Key="AmbientShadow" Color="#52000000" />
          <SolidColorBrush x:Key="FloatShadow" Color="#80000000" />
          <SolidColorBrush x:Key="SidebarTint" Color="#181816" />
          <SolidColorBrush x:Key="TranscriptBubble" Color="#201F1D" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <!-- Spacing and radii (Space) -->
      <x:Double x:Key="S1">4</x:Double>
      <x:Double x:Key="S2">8</x:Double>
      <x:Double x:Key="S3">12</x:Double>
      <x:Double x:Key="S4">16</x:Double>
      <x:Double x:Key="S6">24</x:Double>
      <x:Double x:Key="S8">32</x:Double>
      <x:Double x:Key="S10">40</x:Double>
      <CornerRadius x:Key="RadiusSmall">8</CornerRadius>
      <CornerRadius x:Key="RadiusMedium">14</CornerRadius>
      <CornerRadius x:Key="RadiusLarge">22</CornerRadius>

      <!-- Type families: Inter for Latin, Noto Sans SC / Microsoft YaHei UI for Chinese;
           Source Serif 4 / SimSun for the serif headings (Typo). -->
      <FontFamily x:Key="SansFamily">Inter, Noto Sans SC, Microsoft YaHei UI, Segoe UI</FontFamily>
      <FontFamily x:Key="SerifFamily">Source Serif 4, Noto Serif SC, SimSun, Georgia</FontFamily>
      <FontFamily x:Key="MonoFamily">Cascadia Mono, Consolas, Noto Sans Mono CJK SC</FontFamily>

      <!-- Surfaces: paperCard, aiBlock, floatingSurface -->
      <BoxShadows x:Key="PaperCardShadow">0 1 2 0 #121C1B19, 0 8 14 0 #0F1C1B19</BoxShadows>
      <BoxShadows x:Key="FloatShadowValue">0 12 16 0 #1F1C1B19</BoxShadows>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- Default window typography -->
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{StaticResource SansFamily}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource SansFamily}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- Type scale: hero 38 serif, display 30 serif, section 19 serif, prompt 22 medium,
       title 15 semibold, body 15, label 13 medium, caption 12, overline 11 semibold -->
  <Style Selector="TextBlock.hero">
    <Setter Property="FontFamily" Value="{StaticResource SerifFamily}" />
    <Setter Property="FontSize" Value="38" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="TextBlock.display">
    <Setter Property="FontFamily" Value="{StaticResource SerifFamily}" />
    <Setter Property="FontSize" Value="30" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="FontFamily" Value="{StaticResource SerifFamily}" />
    <Setter Property="FontSize" Value="19" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="TextBlock.prompt">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="LineHeight" Value="32" />
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.body">
    <Setter Property="FontSize" Value="15" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Secondary}" />
  </Style>
  <Style Selector="TextBlock.overline">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.66" />
    <Setter Property="Foreground" Value="{DynamicResource Secondary}" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource Secondary}" />
  </Style>
  <Style Selector="TextBlock.faint">
    <Setter Property="Foreground" Value="{DynamicResource Tertiary}" />
  </Style>
  <Style Selector="TextBlock.code">
    <Setter Property="FontFamily" Value="{StaticResource MonoFamily}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- ScrollViewer: quiet scrollbars, no arrows -->
  <Style Selector="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="10" />
  </Style>

  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaised}" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Hairline}" />
    <Setter Property="BorderThickness" Value="0.5" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="FontSize" Value="12" />
  </Style>
</Styles>
