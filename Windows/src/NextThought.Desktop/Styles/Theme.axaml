      <Thickness x:Key="D4Padding_32_12">32,12</Thickness>
      <Thickness x:Key="D4Padding_0">0</Thickness>
      <Thickness x:Key="D4Padding_3">3</Thickness>
      <Thickness x:Key="D4Padding_12_0">12,0</Thickness>
      <Thickness x:Key="D4Padding_0_12_0_0">0,12,0,0</Thickness>
      <Thickness x:Key="D4Padding_0_14_0_0">0,14,0,0</Thickness>
