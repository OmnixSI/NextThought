<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- D7: SF Symbol -> Fluent System Icons (glyph names from FluentSystemIcons-Regular.ttf).
       The icon font is bundled (Assets/Fonts, MIT) and listed in THIRD_PARTY_NOTICES.txt;
       system Segoe Fluent Icons stays as the fallback so an unpacked build still shows glyphs. -->
  <FontFamily x:Key="IconFont">avares://NextThought/Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular, Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
