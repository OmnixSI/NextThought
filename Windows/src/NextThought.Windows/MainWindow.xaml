<Window x:Class="NextThought.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="NextThought · Windows 预览" Width="1280" Height="860" MinWidth="1040" MinHeight="720" Background="#F7F8FA" Loaded="Window_Loaded" Closing="Window_Closing">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="238" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Border Background="#EFF0F4" BorderBrush="#DDE0E6" BorderThickness="0,0,1,0">
      <Grid Margin="18,24,18,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="NextThought" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="把讨论留下来" Foreground="{StaticResource Muted}" Margin="0,6,0,22" /></StackPanel>
        <Button x:Name="NewButton" Grid.Row="1" Content="＋  新会议" Style="{StaticResource PrimaryButton}" Click="NewMeeting_Click" Margin="0,0,0,22" />
        <TextBlock Grid.Row="2" Text="最近会议" Foreground="{StaticResource Muted}" Margin="2,0,0,10" />
        <ListBox x:Name="HistoryList" Grid.Row="3" Background="Transparent" BorderThickness="0" SelectionChanged="History_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="3,8,3,10" Width="175"><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" /><TextBlock Text="{Binding LocalStartedAt}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="4"><Border Background="#E3DFF7" CornerRadius="5" Padding="8,5" HorizontalAlignment="Left" Margin="0,14,0,10"><TextBlock x:Name="VersionText" Foreground="#554A99" FontSize="10" /></Border><Button Content="悬浮窗 / Ctrl+Alt+O" Click="Overlay_Click" Margin="0,0,0,6" /><Button Content="收起到托盘" Click="Tray_Click" Margin="0,0,0,6" /><Button Content="资料库" Click="Materials_Click" Margin="0,0,0,8" /><Button x:Name="BackupButton" Content="导出备份" Click="Backup_Click" Margin="0,0,0,6" /><Button x:Name="RestoreButton" Content="导入备份" Click="Restore_Click" Margin="0,0,0,6" /><Button Content="打开数据目录" Click="OpenData_Click" Padding="10,7" Margin="0" /><TextBlock Text="原始音频不保存" Foreground="{StaticResource Muted}" FontSize="11" Margin="2,10,0,0" /></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="28,24,28,18">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,16"><StackPanel><TextBlock x:Name="PageTitle" Text="会议工作台" FontSize="27" FontWeight="SemiBold" /><TextBlock x:Name="PageSubtitle" Text="选择声音来源，开始记录。" Foreground="{StaticResource Muted}" Margin="0,6,0,0" /></StackPanel><TextBlock x:Name="StatsText" Text="本机中英转写" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Muted}" /></DockPanel>
      <TabControl x:Name="MainTabs" Grid.Row="1" BorderThickness="0" Background="Transparent" Padding="0,16,0,0">
        <TabItem Header="   会议记录   ">
          <Grid Margin="0,14,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBox x:Name="MeetingTitleBox" Text="新会议" FontSize="17" FontWeight="SemiBold" BorderThickness="0,0,0,1" Background="Transparent" Padding="0,4,0,10" Margin="0,0,0,14" />
                <WrapPanel><Button x:Name="StartButton" Content="开始记录" Style="{StaticResource PrimaryButton}" Click="Start_Click" /><Button x:Name="StopButton" Content="结束会议" Click="Stop_Click" IsEnabled="False" /><Button x:Name="TranslateButton" Content="补译未翻译句子" Click="Translate_Click" ToolTip="将当前会议尚无译文的完整句发送至当前回答服务，进行中英互译" /><Button x:Name="ImportButton" Content="导入 WAV" Click="ImportWave_Click" /><CheckBox x:Name="AutomaticBox" Content="自动回答系统声音中的问题" VerticalAlignment="Center" Checked="Options_Changed" Unchecked="Options_Changed" /></WrapPanel>
                <TextBlock x:Name="AudioSourceText" Text="系统输出设备混音 + 麦克风 · 在设置中调整" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Grid Grid.Row="1">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Border Style="{StaticResource Card}" Margin="0" Padding="16">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                  <DockPanel Margin="0,0,0,12"><TextBlock Text="实时转写" FontSize="16" FontWeight="SemiBold" /><TextBlock x:Name="LevelText" Foreground="{StaticResource Muted}" FontSize="10" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" /></DockPanel>
                  <ListBox x:Name="TranscriptList" Grid.Row="1" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate><DataTemplate><Border Margin="0,0,0,9" Background="#F4F5F8" Padding="10" CornerRadius="7"><StackPanel><TextBlock Text="{Binding Label}" Foreground="#727988" FontSize="10" Margin="0,0,0,5" /><TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0" FontSize="13" /><TextBox Text="{Binding Translation, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Foreground="#6556B3" Padding="0" FontSize="12" /></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
                  </ListBox>
                  <StackPanel Grid.Row="2" Margin="0,10,0,0"><TextBlock x:Name="SystemPartial" Foreground="#6556B3" TextWrapping="Wrap" /><TextBlock x:Name="MicrophonePartial" Foreground="#7C8492" TextWrapping="Wrap" Margin="0,4,0,0" /><TextBlock x:Name="TranscriptEmpty" Text="转写会显示在这里。也可以导入录音 WAV 验证。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" /></StackPanel>
                </Grid>
              </Border>
              <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0" Padding="16">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                  <TextBlock Text="参考回答" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                  <TextBlock x:Name="DetectedQuestion" Grid.Row="1" Text="手动提问，或开启自动回答。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10" />
                  <TextBox x:Name="AnswerText" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="#FAF9FE" Padding="12" FontSize="14" />
                  <StackPanel Grid.Row="3" Margin="0,12,0,0"><TextBlock x:Name="RetrievalInfoText" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,0,0,6" /><TextBox x:Name="QuestionInput" AcceptsReturn="True" MinHeight="64" MaxHeight="130" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" ToolTip="输入问题，点击回答。" /><WrapPanel Margin="0,9,0,0"><Button x:Name="AskButton" Content="回答" Style="{StaticResource PrimaryButton}" Click="Ask_Click" /><Button Content="复制" Click="CopyAnswer_Click" Padding="12,9" /><CheckBox x:Name="UseMaterialsBox" Content="参考资料库" ToolTip="将本机资料库中与问题相关的摘录发送至所选回答服务" /><ComboBox x:Name="SourcesBox" Width="155" DisplayMemberPath="Location" ToolTip="本次回答实际引用的来源" /><Button Content="查看来源" Click="ViewSource_Click" Padding="8,6" /></WrapPanel></StackPanel>
                </Grid>
              </Border>
            </Grid>
          </Grid>
        </TabItem>
        <TabItem Header="   会后纪要   ">
          <Grid Margin="0,14,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><WrapPanel Margin="0,0,0,16"><Button x:Name="SummaryButton" Content="整理这场会议" Style="{StaticResource PrimaryButton}" Click="Summarize_Click" /><Button x:Name="ExportButton" Content="导出 Markdown" Click="Export_Click" /><CheckBox x:Name="AutoSummaryBox" Content="结束会议后自动整理" Checked="Options_Changed" Unchecked="Options_Changed" /></WrapPanel><TextBox x:Name="SummaryText" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="22" FontSize="14" Text="结束会议后，按转写整理总结、决定、待办和未决问题。" /></Grid>
        </TabItem>
        <TabItem Header="   手机伴侣   "><ScrollViewer VerticalScrollBarVisibility="Auto"><Border Style="{StaticResource Card}" Margin="0,14,0,0"><StackPanel><TextBlock Text="同一局域网连接" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="手机与电脑连接同一可信网络，选择电脑的 Wi-Fi 或以太网地址后开启。手机扫码用浏览器打开，可查看当前问题、回答与状态，并触发回答、简短版、举例或停止生成。" TextWrapping="Wrap" Margin="0,12,0,10" /><TextBlock Text="局域网 HTTP 不加密；配对链接相当于临时遥控密钥，请仅在可信网络使用。不会发送完整转写、资料文件、音频或 API Key。不自动修改防火墙，若系统提示请仅允许私人网络。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,16" /><ComboBox x:Name="CompanionAddressBox" /><WrapPanel Margin="0,10,0,12"><Button Content="刷新网络地址" Click="RefreshCompanion_Click" /><Button x:Name="CompanionToggle" Content="开启局域网手机伴侣" Click="CompanionToggle_Click" /><Button Content="复制配对链接" Click="CopyCompanion_Click" /></WrapPanel><TextBlock x:Name="CompanionInfo" Text="默认关闭；没有后台常驻服务。" TextWrapping="Wrap" /><Image x:Name="CompanionQr" Width="260" Height="260" HorizontalAlignment="Left" Margin="0,15,0,10" /><TextBox x:Name="CompanionLink" IsReadOnly="True" TextWrapping="Wrap" /><TextBlock Text="网络变化后关闭并重新开启，再扫码配对。公共 Wi-Fi、访客网络或 AP 隔离可能禁止手机访问；校园网 100.64–100.127 网段已支持；如同网设备不能互访，可用手机热点验证。WSS 中转与蓝牙尚未接入。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,12,0,0" /></StackPanel></Border></ScrollViewer></TabItem>
        <TabItem Header="   设置   ">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0"><StackPanel>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="声音来源" FontSize="17" FontWeight="SemiBold" /><CheckBox x:Name="SystemEnabledBox" Content="系统输出设备混音" Checked="Options_Changed" Unchecked="Options_Changed" /><ComboBox x:Name="SystemDeviceBox" /><TextBlock Text="系统声音范围（每次开始前选择）" Style="{StaticResource Label}" /><ComboBox x:Name="ProcessBox" /><Button Content="刷新应用列表" Click="RefreshProcesses_Click" HorizontalAlignment="Left" /><TextBlock Text="选应用时仅采集该进程及其子进程的声音，覆盖其使用的输出设备；选整个设备时采集该设备全部混音。麦克风由下方独立开关控制。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" /><TextBlock Text="会采集所选输出设备播放的声音，包含该设备上的其他应用。" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" /><CheckBox x:Name="MicEnabledBox" Content="麦克风" Checked="Options_Changed" Unchecked="Options_Changed" /><ComboBox x:Name="MicDeviceBox" /><TextBlock Text="麦克风增益（1–8 倍，声音偏小时调高）" Style="{StaticResource Label}" /><Slider x:Name="MicGainSlider" Minimum="1" Maximum="8" Value="1" TickFrequency="1" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft" /><Button Content="刷新设备" Click="RefreshDevices_Click" HorizontalAlignment="Left" Margin="0,12,0,0" Padding="12,7" /></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="本机语音识别" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="识别模型" Style="{StaticResource Label}" /><ComboBox x:Name="LocalModelBox" SelectionChanged="LocalModel_Changed" /><CheckBox x:Name="RefineBox" Content="整句精修，提高最终转写质量" Checked="Options_Changed" Unchecked="Options_Changed" /><TextBlock x:Name="ModelStatusText" Foreground="{StaticResource Muted}" Margin="0,4,0,12" TextWrapping="Wrap" /><Button x:Name="PrepareButton" Content="准备语音组件" Style="{StaticResource PrimaryButton}" Click="PrepareModels_Click" HorizontalAlignment="Left" /><TextBlock Text="首次需下载流式模型约 134 MB；整句精修另约 136 MB，下载后本机离线运行。" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap" /><TextBlock Text="术语与人名（逗号或换行分隔）" Style="{StaticResource Label}" /><TextBox x:Name="VocabularyBox" AcceptsReturn="True" Height="70" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" /></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><CheckBox x:Name="SpeakersBox" Content="区分会议中的说话人（本机实验功能）" /><TextBlock Text="仅保留会议内编号，不保存声纹或原始音频。短句和不确定结果保持未知；在线会议只区分系统声音，线下会议区分现场麦克风。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" /><Button x:Name="PrepareSpeakersButton" Content="准备声纹组件（约 26 MB）" Click="PrepareSpeakers_Click" HorizontalAlignment="Left" Margin="0,10,0,18" /><CheckBox x:Name="TranslationBox" Content="记录时将完整句中英互译（使用当前回答服务）" /><TextBlock Text="按句子语言自动选择方向；开启后完整句会发往所选服务，原文与译文分别保存。结束会议会取消未完成译文，可在历史会议补译。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,18" /><TextBlock Text="本机语义检索" FontSize="17" FontWeight="SemiBold" /><CheckBox x:Name="SemanticBox" Content="参考资料库时使用语义与关键词混合检索" /><TextBlock Text="Qwen3-Embedding-0.6B Q8 · CPU · 首次下载约 596 MB。索引仅在本机生成；模型缺失或失败时回退关键词。首次提问会建立资料索引，后续复用。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" /><Button x:Name="PrepareRetrievalButton" Content="准备检索组件" Click="PrepareRetrieval_Click" HorizontalAlignment="Left" Margin="0,12,0,12" /><TextBlock Text="回答服务" FontSize="17" FontWeight="SemiBold" /><CheckBox x:Name="UseCodexBox" Content="使用本机 Codex CLI 账号" /><TextBlock Text="Codex 模型（留空沿用账号默认模型）" Style="{StaticResource Label}" /><TextBox x:Name="CodexModelBox" /><TextBlock Text="Codex 使用本机 CLI 已有登录；问题与相关资料会发送至 Codex 服务。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" /><TextBlock Text="兼容 API 地址" Style="{StaticResource Label}" /><TextBox x:Name="BaseUrlBox" /><TextBlock Text="回答模型名称" Style="{StaticResource Label}" /><TextBox x:Name="ModelBox" /><TextBlock Text="API Key" Style="{StaticResource Label}" /><PasswordBox x:Name="ApiKeyBox" Padding="10,8" BorderBrush="#D8DBE2" /><TextBlock Text="保存在当前 Windows 用户的加密凭据文件中。本机服务可不填 Key。" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" /><TextBlock Text="纪要模型（留空时沿用回答模型）" Style="{StaticResource Label}" /><TextBox x:Name="NotesModelBox" /><TextBlock Text="推理强度（取决于所选服务支持）" Style="{StaticResource Label}" /><ComboBox x:Name="EffortBox"><ComboBoxItem Content="默认，不指定" Tag="" /><ComboBoxItem Content="none（关闭思考）" Tag="none" /><ComboBoxItem Content="low" Tag="low" /><ComboBoxItem Content="medium" Tag="medium" /><ComboBoxItem Content="high" Tag="high" /></ComboBox><WrapPanel Margin="0,16,0,0"><Button x:Name="SaveButton" Content="保存设置" Style="{StaticResource PrimaryButton}" Click="SaveSettings_Click" /><Button x:Name="CheckServiceButton" Content="检查回答服务" Click="CheckService_Click" /></WrapPanel><TextBlock Text="转写保存在本机。使用远程回答服务时，问题和相关转写会发送到该服务。" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap" /></StackPanel></Border>
          </StackPanel></ScrollViewer>
        </TabItem>
      </TabControl>
      <Grid Grid.Row="2" Margin="0,16,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><ProgressBar x:Name="WorkProgress" Maximum="1" Height="3" Foreground="{StaticResource Accent}" Background="#E7E8EE" Value="0" /><DockPanel Grid.Row="1" Margin="0,9,0,0"><Button x:Name="CancelButton" Content="取消当前任务" Click="Cancel_Click" DockPanel.Dock="Right" Padding="10,5" Margin="12,0,0,0" IsEnabled="False" /><TextBlock x:Name="StatusText" Text="准备就绪。" VerticalAlignment="Center" Foreground="{StaticResource Muted}" TextWrapping="Wrap" MaxHeight="70" /></DockPanel></Grid>
    </Grid>
  </Grid>
</Window>
