    {
      "id": "benchmark-01",
      "name": "巡检安排.md",
      "sha256": "8f4f9b8bce03c67b3737e6279b10501223252b2d18ff8687d2928b081aa8309d",
      "extension": ".md",
      "blocks": [
        {
          "location": "段落 1",
          "text": "桥面日常巡检周期为七天，由养护组负责。"
        }
      ]
    },
    {
      "id": "benchmark-02",
      "name": "支座复核.md",
      "sha256": "5849f07912627ebd39fdfd6ca716d9b83f4e2973f5f21d592a57fdbd224da36a",
      "extension": ".md",
      "blocks": [
        {
          "location": "段落 1",
          "text": "支座标高复核每九十天进行一次，技术负责人是陈工。"
        }
      ]
    },
    {
      "id": "benchmark-03",
      "name": "混凝土养护.md",
      "sha256": "830de4c585dc4de4090b7ac3755bc764c6ea277127d88be31d9b9281b788adc5",
      "extension": ".md",
      "blocks": [
        {
          "location": "段落 1",
          "text": "新浇筑混凝土应持续保湿养护不少于十四天。"
        }
      ]
    },
    {
      "id": "benchmark-04",
      "name": "桥梁复核.md",
      "sha256": "2062d4038a4e775c2831b8f1c8abf3222f652c0e90bada4bd113d15af4980b88",
      "extension": ".md",
      "blocks": [
        {
          "location": "段落 1",
          "text": "曙光桥安全复核负责人为林工，计划于十一月十五日完成。"
        }
      ]
    },
    {
      "id": "benchmark-05",
      "name": "材料复检.md",
      "sha256": "68aef0737339c5e5bcb34294fa39f198e6f60d6afdcaf75b43a153150f354d66",
      "extension": ".md",
      "blocks": [
        {
          "location": "段落 1",
          "text": "材料入场质量复检周期为三十天，质量负责人是王工。"
        }
      ]
    },
    {
      "id": "benchmark-06",
      "name": "例会安排.md",
      "sha256": "4d340698439e28caa9f71b8d0d3bcae463ec79e24a23079c4b2c5a211c8094dc",
      "extension": ".md",
      "blocks": [
        {
          "location": "段落 1",
          "text": "现场例会固定在每周三下午三点召开。"
        }
      ]
    },
    {
      "id": "benchmark-07",
      "name": "钢梁吊装.md",
      "sha256": "20ec1439721ce172809829c651a4f5a469a06354c2ea9a1d219df3e319f36dbd",
      "extension": ".md",
      "blocks": [
        {
          "location": "段落 1",
          "text": "钢梁吊装分为四个阶段，第二阶段结束后复核支座标高。"
        }
      ]
    },
    {
      "id": "benchmark-08",
      "name": "临时封路.md",
      "sha256": "a5a7fc1ca3facd10d29bfba7c41db249473f7b9a084449119a12f62edef75de3",
      "extension": ".md",
      "blocks": [
        {
          "location": "段落 1",
          "text": "吊装期间东侧施工便道临时封闭，西侧应急通道保持畅通。"
        }
      ]
    },
    {
      "id": "benchmark-09",
      "name": "雨天停工.md",
      "sha256": "6baba3e2c137f155085712401928bffc2faec14d31cf7e03ff3a73cf3d0ec011",
      "extension": ".md",
      "blocks": [
        {
          "location": "段落 1",
          "text": "雷电预警发布后暂停露天吊装，解除预警并完成检查后复工。"
        }
      ]
    },
    {
      "id": "benchmark-10",
      "name": "设备点检.md",
